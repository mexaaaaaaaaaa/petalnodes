            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rgb = mixRgb(cMossDark, cMossLight, n * 0.7 + (1 - tuft.f1) * 0.3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (tuft.edge < 0.06) rgb = cMossDeep;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          h = clamp01(0.4 + n * 0.4 + (1 - tuft.f1) * 0.12 + microGrain * 0.5);"

              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      } else if (type === \"stone\") {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Multi-scale stone relief: sedimentary strata, chiseled Worley plates, crevice fissures & grain pitting"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const strata = fbm(x * 0.09, y * 0.18, baseSeed, 4);"

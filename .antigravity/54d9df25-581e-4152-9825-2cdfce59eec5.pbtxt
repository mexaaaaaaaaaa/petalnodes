            }
            lines {
              text: "    const r = Math.hypot(x, z);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (r <= 2.2) return 0; // Keep center flat around the seed"

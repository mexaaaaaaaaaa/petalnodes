              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return { f1, f2, edge: f2 - f1, id: bestId };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

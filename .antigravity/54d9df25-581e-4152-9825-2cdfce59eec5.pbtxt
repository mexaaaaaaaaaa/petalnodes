      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Mark pending TODO anchor URLs as aria-disabled for accessibility\", \"EndLine\":142, \"Instruction\":\"Set aria-disabled on StickerButton anchors when todoHref is true\", \"ReplacementContent\":\"        target={external && !todoHref ? \\\"_blank\\\" : undefined}\\n        rel={external && !todoHref ? \\\"noopener noreferrer\\\" : undefined}\\n        title={todoHref && isDev ? \\\"TODO: link\\\" : undefined}\\n        aria-label={ariaLabel}\\n        aria-disabled={todoHref ? \\\"true\\\" : undefined}\\n        aria-busy={loading || undefined}\", \"StartLine\":131, \"TargetContent\":\"        target={external && !todoHref ? \\\"_blank\\\" : undefined}\\n        rel={external && !todoHref ? \\\"noopener noreferrer\\\" : undefined}\\n        title={todoHref && isDev ? \\\"TODO: link\\\" : undefined}\\n        aria-label={ariaLabel}\\n        aria-busy={loading || undefined}\", \"TargetFile\":\"/src/components/sketch/StickerButton.tsx\", \"toolAction\":\"Updating StickerButton accessibility\", \"toolSummary\":\"Update StickerButton.tsx\"}"

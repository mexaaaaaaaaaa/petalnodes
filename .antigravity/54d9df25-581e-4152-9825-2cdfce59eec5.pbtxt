            }
            lines {
              text: "        if (crystalField > 0.62) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const isGold = crystalCells.id > 0.48;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const crystalBase = isGold ? cLantern : cBlossom400;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const crystalCore = isGold ? cLanternWarm : cBlossomHi;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const facetBright = clamp01(1 - crystalCells.f1 * 1.5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rgb = mixRgb(crystalBase, crystalCore, facetBright * 0.62);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          // Rich glow centered inside crystal facets rather than blowing out entire surface"

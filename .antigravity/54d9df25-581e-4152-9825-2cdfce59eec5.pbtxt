      thinking_signature: "\022\324\005\n\321\005\001i\024}\023\t\227(J\006}\\\355x^\305ol\311\233\363\035V\255\243\2043\225\224\232\251\336\355\317A\365\031C\237\241r\335V\311\352\271\350\257w4\274\024\260\316HO\367\272\252\224\030\276\002\263]\335\362yA\236\341M\026\3166\361\316<\036\240n\332\257\177cL\204\272\364\002\004D\236\032\221\342\374\363V)\317\273/\264u\350\245\2064e\230\214\016\005\255\255\222\216\351\240\373t\314\373\234\272\301\251*H\3336+\274(\f\202\273\372`\346\211\211L0S.\330x\255\031\231\330\262\277~F\344\347\204\224z\317#\233mK\340\223\213q\3003\201E\261$\327\022\021\243\352H\340\270a\231\357T&\224*\346_.\321\032n5CHY\223\023\324\200\017\352\235\211T\234\355\237/@ds\306\254\017e\bO\003\250\022\350$\314\346\265\261\362%+5\362\334%\326\316\276\203\273\347*\220\241\rO \3632!/,TO+\a\335#\252s\177\222\225\330\026\332\225f\030u\212\031[\347B/\240\025\027Wr\307A\022{\350a\027&\3404z~\241\034o\233Q\344zn\261d\203Do;\212\204\210*\035\331\364^\022U\017\360\334\341\375\346\035p\327\335D\316\344\024\243\177\214M7\000@\2357\2775\245\307H\251N1\314\373\aDM\215d\367\327%\001\"\201\224\304C\367\271\207\245\237a;\317\253\376%\264\355\006\370\222mMLb\342\263\021\204c0\032\355l\2355\0009\257\222\200\205\t\a\374\356w\f\360\247Kp=W\236\266C%\376>\003b\304\t\332\335&_\341\230&\004PpcI\aO\0204\262\324\335\207\230\233\036_\376\003 \223\v,\317z\004\336\002{\212\273T2s\235*$\220X\351\350\211\"o\325\220\246\030\257w\210\236-\aI\221\267b\367\302O\201\027&\306?\252)]\035VL\020\243X\321\222V\246o\363\307\177\250\324\'2\325\220_kE\234\242\200t`\234\331\357\020\036\3637\035\212\001\030\273\214\357\003\244\3556\363IMm\215\v\334[\315\215\332R\2459WN\260\022\316@\017!\335\032\341\2114X\b&\347\227]\313\351\350\342\320[\016\303\n\020~\r]\333w\322\263G{\005\261e\2162\253&\211\200\301\021w\234GZ\342\203F\330\206\250\242\370\226\221\265?n\321G<\260\310\206\016}\347\265\3344\351[\363\357+\027\203\301\216\327O&\340[y@\'\362\035\336\\F+\261G4SL\276?P\347\377v\235+\r\255\323\243S6\215\v\307
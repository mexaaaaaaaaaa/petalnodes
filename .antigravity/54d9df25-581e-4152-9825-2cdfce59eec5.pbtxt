    content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Petalnodes \342\200\224 Cherry Blossom Minecraft &amp; VPS Hosting</title>\n    <meta\n      name=\"description\"\n      content=\"Minecraft and VPS hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe storage, DDoS protection, and daily backups.\"\n    />\n    <link rel=\"canonical\" href=\"https://petalnodes.cloud/\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Petalnodes\" />\n    <meta property=\"og:url\" content=\"https://petalnodes.cloud/\" />\n    <meta property=\"og:title\" content=\"Petalnodes \342\200\224 Cherry Blossom Minecraft &amp; VPS Hosting\" />\n    <meta\n      property=\"og:description\"\n      content=\"Minecraft and VPS hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe storage, DDoS protection, and daily backups.\"\n    />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Petalnodes \342\200\224 Cherry Blossom Minecraft &amp; VPS Hosting\" />\n    <meta\n      name=\"twitter:description\"\n      content=\"Minecraft and VPS hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe storage, DDoS protection, and daily backups.\"\n    />\n    <script type=\"application/ld+json\">\n      {\n        \"@context\": \"https://schema.org\",\n        \"@graph\": [\n          {\n            \"@type\": \"Organization\",\n            \"name\": \"Petalnodes\",\n            \"url\": \"https://petalnodes.cloud\",\n            \"sameAs\": [\n              \"https://discord.gg/GS3wuc4HGk\",\n              \"https://billing.petalnodes.cloud\",\n              \"https://panel.petalnodes.cloud\",\n              \"https://status.petalnodes.cloud\"\n            ]\n          },\n          {\n            \"@type\": \"WebSite\",\n            \"name\": \"Petalnodes\",\n            \"url\": \"https://petalnodes.cloud\"\n          }\n        ]\n      }\n    </script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Fraunces:ital,opsz,SOFT@1,9..144,100&family=Nunito:wght@400;600;800&family=Pixelify+Sans:wght@500;700&family=Shantell+Sans:ital,BNCE,INFM,wght@0,40,60,500..700;1,40,60,500..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n"

    tool_calls {
      id: "call_16749954925589327268"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { isTodo, type StoryChapterContent } from \\\"@/content\\\";\\nimport {\\n  RoughBox,\\n  Stamp,\\n  StickerButton,\\n  WashiTape,\\n} from \\\"@/components/sketch\\\";\\nimport { PanelSketch } from \\\"./PanelSketch\\\";\\nimport { cn } from \\\"@/lib/utils\\\";\\n\\nconst CHAPTER_SEEDS: Record<string, number> = {\\n  roots: 201,\\n  shield: 202,\\n  build: 203,\\n  neighbors: 204,\\n  bloom: 205,\\n};\\n\\nexport interface ChapterCardProps {\\n  chapter: StoryChapterContent;\\n  side: \\\"left\\\" | \\\"right\\\";\\n  onPickPlanClick?: () => void;\\n  staticMode?: boolean;\\n  className?: string;\\n}\\n\\nexport function ChapterCard({\\n  chapter,\\n  side,\\n  onPickPlanClick,\\n  staticMode = false,\\n  className,\\n}: ChapterCardProps) {\\n  return (\\n    <div\\n      data-chapter-card={chapter.id}\\n      className={cn(\\n        \\\"relative w-full max-w-[420px]\\\",\\n        side === \\\"right\\\" ? \\\"md:ml-auto\\\" : \\\"md:mr-auto\\\",\\n        className,\\n      )}\\n    >\\n      <div\\n        className={cn(\\n          \\\"pointer-events-none absolute -top-3 z-20\\\",\\n          side === \\\"left\\\" ? \\\"left-6\\\" : \\\"right-6\\\",\\n        )}\\n      >\\n        <WashiTape\\n          rotation={side === \\\"left\\\" ? -5 : 5}\\n          length={84}\\n          color={chapter.id === \\\"bloom\\\" ? \\\"#FF8FAB\\\" : \\\"#FFC9D6\\\"}\\n        />\\n      </div>\\n\\n      <RoughBox\\n        seed={CHAPTER_SEEDS[chapter.id] ?? 210}\\n        bgClassName=\\\"bg-paper-shade/95\\\"\\n        padding=\\\"p-5 sm:p-6 pt-6\\\"\\n        className=\\\"shadow-[5px_6px_0_var(--color-ink)]\\\"\\n      >\\n        {chapter.kicker && (\\n          <p className=\\\"font-handwriting text-sm font-bold uppercase tracking-wider text-blossom-600 mb-1\\\">\\n            {chapter.kicker}\\n          </p>\\n        )}\\n\\n        <h2 className=\\\"font-display-tight text-2xl sm:text-3xl text-ink leading-tight\\\">\\n          {chapter.heading}\\n        </h2>\\n\\n        <p className=\\\"mt-2.5 text-sm sm:text-[15px] leading-relaxed text-ink-soft\\\">\\n          {chapter.body}\\n        </p>\\n\\n        {chapter.todoNote && isTodo(chapter.todoNote) && import.meta.env.DEV && (\\n          <div className=\\\"mt-2 inline-flex items-center gap-1.5 rounded-sm border border-dashed border-blossom-600/60 bg-blossom-50/70 px-2 py-0.5 text-[11px] font-handwriting text-blossom-600\\\">\\n            {chapter.todoNote}\\n          </div>\\n        )}\\n\\n        {chapter.specs && chapter.specs.length > 0 && (\\n          <dl className=\\\"mt-3.5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-dashed border-paper-line pt-3\\\">\\n            {chapter.specs.map((spec) => (\\n              <div key={spec.label}>\\n                <dt className=\\\"text-[11px] font-bold uppercase tracking-wider text-ink-soft\\\">\\n                  {spec.label}\\n                </dt>\\n                <dd className=\\\"flex items-center gap-1.5 font-pixel text-sm sm:text-base text-ink\\\">\\n                  <span>{spec.value}</span>\\n                  {isTodo(spec.value) && spec.value === \\\"TODO\\\" && (\\n                    <Stamp text=\\\"TODO\\\" rotation={-3} size=\\\"sm\\\" />\\n                  )}\\n                </dd>\\n              </div>\\n            ))}\\n          </dl>\\n        )}\\n\\n        {chapter.id === \\\"build\\\" && (\\n          <PanelSketch staticComplete={staticMode} />\\n        )}\\n\\n        {chapter.ctaLabel && (\\n          <div className=\\\"mt-4\\\">\\n            <StickerButton\\n              variant=\\\"primary\\\"\\n              size=\\\"md\\\"\\n              onClick={onPickPlanClick}\\n            >\\n              {chapter.ctaLabel}\\n            </StickerButton>\\n          </div>\\n        )}\\n      </RoughBox>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ChapterCard using RoughBox on paper-shade with washi tape, specs, and Build PanelSketch\", \"Overwrite\":true, \"TargetFile\":\"/src/sections/home/ChapterCard.tsx\", \"toolAction\":\"Creating ChapterCard component\", \"toolSummary\":\"ChapterCard component creation\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16749954925589326461"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { story, type ChapterId } from \\\"@/content\\\";\\nimport { chapterAt, chapterStart } from \\\"@/lib/storyStore\\\";\\nimport { useSmoothScroll } from \\\"@/app/SmoothScroll\\\";\\n\\nconst VINE_PATH_LENGTH = 260;\\n\\n/**\\n * Pure imperative updater called from the master ScrollTrigger onUpdate.\\n * Updates the vine stroke length and active leaf dot without any React re-renders.\\n */\\nexport function updateStoryVineDOM(\\n  root: HTMLElement | null,\\n  progress: number,\\n) {\\n  if (!root) return;\\n  const p = Math.max(0, Math.min(1, progress));\\n  const activeId = chapterAt(p);\\n\\n  const stemFill = root.querySelector<SVGPathElement>(\\\"[data-vine-stem]\\\");\\n  if (stemFill) {\\n    stemFill.style.strokeDashoffset = `${(VINE_PATH_LENGTH * (1 - p)).toFixed(1)}`;\\n  }\\n\\n  const leaves = root.querySelectorAll<HTMLElement>(\\\"[data-vine-chapter]\\\");\\n  leaves.forEach((btn) => {\\n    const isActive = btn.dataset.vineChapter === activeId;\\n    btn.dataset.active = isActive ? \\\"true\\\" : \\\"false\\\";\\n    const leafShape = btn.querySelector<SVGPathElement>(\\\"[data-vine-leaf]\\\");\\n    const label = btn.querySelector<HTMLElement>(\\\"[data-vine-label]\\\");\\n    if (leafShape) {\\n      leafShape.setAttribute(\\\"fill\\\", isActive ? \\\"#E2557B\\\" : \\\"#6FAF5B\\\");\\n      leafShape.setAttribute(\\n        \\\"transform\\\",\\n        isActive ? \\\"scale(1.22)\\\" : \\\"scale(1)\\\",\\n      );\\n    }\\n    if (label) {\\n      label.style.opacity = isActive ? \\\"1\\\" : \\\"0.62\\\";\\n      label.style.color = isActive ? \\\"#E2557B\\\" : \\\"#2B2230\\\";\\n      label.style.fontWeight = isActive ? \\\"800\\\" : \\\"600\\\";\\n    }\\n  });\\n}\\n\\nexport const StoryVine = React.forwardRef<HTMLElement, { className?: string }>(\\n  function StoryVine({ className }, ref) {\\n    const { scrollToStoryProgress } = useSmoothScroll();\\n\\n    const handleJump = (id: ChapterId) => {\\n      const targetProgress = id === \\\"seed\\\" ? 0 : chapterStart(id) + 0.015;\\n      scrollToStoryProgress(targetProgress);\\n    };\\n\\n    return (\\n      <aside\\n        ref={ref}\\n        aria-label=\\\"Story progress navigation\\\"\\n        className={\\n          className ??\\n          \\\"hidden lg:flex fixed right-5 top-1/2 -translate-y-1/2 z-30 flex-col items-end pointer-events-auto\\\"\\n        }\\n      >\\n        <div className=\\\"relative flex flex-col justify-between h-[280px] pr-2\\\">\\n          {/* Background guide + growing ink/green vine */}\\n          <svg\\n            viewBox=\\\"0 0 24 260\\\"\\n            width={24}\\n            height={260}\\n            aria-hidden=\\\"true\\\"\\n            className=\\\"pointer-events-none absolute right-2 top-3 h-[256px] w-6 overflow-visible\\\"\\n          >\\n            <path\\n              d=\\\"M12 4 C8 55 16 105 12 155 C9 195 15 230 12 256\\\"\\n              fill=\\\"none\\\"\\n              stroke=\\\"#E6DEC8\\\"\\n              strokeWidth=\\\"2.5\\\"\\n              strokeLinecap=\\\"round\\\"\\n            />\\n            <path\\n              data-vine-stem\\n              d=\\\"M12 4 C8 55 16 105 12 155 C9 195 15 230 12 256\\\"\\n              fill=\\\"none\\\"\\n              stroke=\\\"#6FAF5B\\\"\\n              strokeWidth=\\\"3\\\"\\n              strokeLinecap=\\\"round\\\"\\n              strokeDasharray={VINE_PATH_LENGTH}\\n              strokeDashoffset={VINE_PATH_LENGTH}\\n            />\\n          </svg>\\n\\n          {story.chapters.map((chapter, idx) => (\\n            <button\\n              key={chapter.id}\\n              type=\\\"button\\\"\\n              data-vine-chapter={chapter.id}\\n              data-active={idx === 0 ? \\\"true\\\" : \\\"false\\\"}\\n              onClick={() => handleJump(chapter.id)}\\n              aria-label={`Jump to chapter: ${chapter.vineLabel}`}\\n              className=\\\"group relative flex items-center gap-2.5 py-1 pr-0.5 cursor-pointer focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-ink rounded-sm\\\"\\n            >\\n              <span\\n                data-vine-label\\n                className=\\\"font-handwriting text-xs tracking-wide transition-opacity group-hover:opacity-100\\\"\\n                style={{\\n                  opacity: idx === 0 ? 1 : 0.62,\\n                  color: idx === 0 ? \\\"#E2557B\\\" : \\\"#2B2230\\\",\\n                  fontWeight: idx === 0 ? 800 : 600,\\n                }}\\n              >\\n                {chapter.vineLabel}\\n              </span>\\n              <svg\\n                viewBox=\\\"0 0 20 20\\\"\\n                width={18}\\n                height={18}\\n                aria-hidden=\\\"true\\\"\\n                className=\\\"relative z-10 overflow-visible\\\"\\n              >\\n                <path\\n                  data-vine-leaf\\n                  d=\\\"M10 3 C15 4 17 8 15 13 C12 16 7 15 4 11 C3 7 6 3 10 3 Z\\\"\\n                  fill={idx === 0 ? \\\"#E2557B\\\" : \\\"#6FAF5B\\\"}\\n                  stroke=\\\"#2B2230\\\"\\n                  strokeWidth=\\\"1.8\\\"\\n                  strokeLinejoin=\\\"round\\\"\\n                  style={{ transformOrigin: \\\"10px 10px\\\" }}\\n                />\\n              </svg>\\n            </button>\\n          ))}\\n        </div>\\n      </aside>\\n    );\\n  },\\n);\\n\", \"Description\":\"Create desktop StoryVine progress rail with clickable chapter leaf nodes and zero re-render scroll updates\", \"Overwrite\":true, \"TargetFile\":\"/src/sections/home/StoryVine.tsx\", \"toolAction\":\"Creating StoryVine component\", \"toolSummary\":\"StoryVine component creation\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16749954925589325654"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { Link } from \\\"react-router-dom\\\";\\nimport { story } from \\\"@/content\\\";\\nimport {\\n  InkArrow,\\n  IslandSketchSvg,\\n  PolaroidFrame,\\n  RoughUnderline,\\n  StickerButton,\\n} from \\\"@/components/sketch\\\";\\nimport { ChapterCard } from \\\"./ChapterCard\\\";\\nimport { useSmoothScroll } from \\\"@/app/SmoothScroll\\\";\\n\\nfunction renderHeroHeading(heading: string, highlightWord?: string) {\\n  if (!highlightWord || !heading.includes(highlightWord)) return heading;\\n  const parts = heading.split(highlightWord);\\n  return (\\n    <>\\n      {parts[0]}\\n      <RoughUnderline drawIn={false}>{highlightWord}</RoughUnderline>\\n      {parts.slice(1).join(highlightWord)}\\n    </>\\n  );\\n}\\n\\nconst STATIC_ARROW_COORDS: {\\n  from: [number, number];\\n  to: [number, number];\\n  posClass: string;\\n}[] = [\\n  { from: [120, 48], to: [192, 92], posClass: \\\"top-2 left-2\\\" },\\n  { from: [110, 44], to: [176, 118], posClass: \\\"bottom-6 left-2\\\" },\\n  { from: [118, 42], to: [184, 88], posClass: \\\"top-2 left-2\\\" },\\n  { from: [110, 46], to: [195, 100], posClass: \\\"top-2 left-2\\\" },\\n  { from: [108, 44], to: [215, 110], posClass: \\\"bottom-8 right-2\\\" },\\n  { from: [105, 42], to: [176, 94], posClass: \\\"top-2 left-2\\\" },\\n];\\n\\nexport function StoryStatic() {\\n  const { scrollToTarget } = useSmoothScroll();\\n  const seedChapter = story.chapters[0];\\n  const restChapters = story.chapters.slice(1);\\n\\n  return (\\n    <div id=\\\"story\\\" data-story-mode=\\\"static\\\" className=\\\"pt-28 pb-8\\\">\\n      {/* Chapter 0: Hero */}\\n      <section\\n        id=\\\"chapter-seed\\\"\\n        className=\\\"mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-16 md:pb-24 border-b border-dashed border-paper-line\\\"\\n      >\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\\\">\\n          <div className=\\\"lg:col-span-6\\\">\\n            {seedChapter.eyebrow && (\\n              <p className=\\\"font-handwriting text-lg text-blossom-600 font-semibold mb-2\\\">\\n                {seedChapter.eyebrow}\\n              </p>\\n            )}\\n            <h1 className=\\\"font-display-tight text-4xl sm:text-5xl lg:text-6xl text-ink\\\">\\n              {renderHeroHeading(seedChapter.heading, seedChapter.highlightWord)}\\n            </h1>\\n            <p className=\\\"mt-5 text-lg text-ink-soft leading-relaxed max-w-xl\\\">\\n              {seedChapter.body}\\n            </p>\\n            <div className=\\\"mt-8 flex flex-wrap items-center gap-4\\\">\\n              <StickerButton\\n                href={story.chapters[0] ? undefined : undefined}\\n                onClick={() => scrollToTarget(\\\"#plans-highlight\\\", -24)}\\n                variant=\\\"primary\\\"\\n                size=\\\"lg\\\"\\n              >\\n                {story.heroPrimaryCta}\\n              </StickerButton>\\n              <Link\\n                to=\\\"/plans\\\"\\n                className=\\\"sticker-btn rounded-sm font-display font-bold bg-paper text-ink hover:bg-blossom-50 h-13 px-7 text-base md:text-lg\\\"\\n              >\\n                {story.heroSecondaryCta}\\n              </Link>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-6 relative\\\">\\n            <div className=\\\"relative mx-auto max-w-md\\\">\\n              <IslandSketchSvg stage={0} />\\n              <div className=\\\"mt-2 inline-flex items-center gap-2 font-handwriting text-base text-ink-soft\\\">\\n                <InkArrow\\n                  from={[16, 26]}\\n                  to={[76, 8]}\\n                  curvature={-0.25}\\n                  seed={51}\\n                  className=\\\"w-16 h-8\\\"\\n                />\\n                <span>{seedChapter.annotation}</span>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Chapters 1..5 stacked cleanly with cumulative SVG island illustrations */}\\n      {restChapters.map((chapter, idx) => {\\n        const stage = (idx + 1) as 1 | 2 | 3 | 4 | 5;\\n        const side: \\\"left\\\" | \\\"right\\\" = idx % 2 === 0 ? \\\"left\\\" : \\\"right\\\";\\n        const arrowSpec = STATIC_ARROW_COORDS[stage];\\n        const isBloom = chapter.id === \\\"bloom\\\";\\n\\n        return (\\n          <section\\n            key={chapter.id}\\n            id={`chapter-${chapter.id}`}\\n            className=\\\"mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14 md:py-20 border-b border-dashed border-paper-line last:border-b-0\\\"\\n          >\\n            <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\\\">\\n              <div\\n                className={\\n                  side === \\\"left\\\"\\n                    ? \\\"lg:col-span-5 order-2 lg:order-1\\\"\\n                    : \\\"lg:col-span-5 order-2 lg:order-2\\\"\\n                }\\n              >\\n                <ChapterCard\\n                  chapter={chapter}\\n                  side={side}\\n                  staticMode\\n                  onPickPlanClick={() => scrollToTarget(\\\"#plans-highlight\\\", -24)}\\n                />\\n              </div>\\n\\n              <div\\n                className={\\n                  side === \\\"left\\\"\\n                    ? \\\"lg:col-span-7 order-1 lg:order-2 relative\\\"\\n                    : \\\"lg:col-span-7 order-1 lg:order-1 relative\\\"\\n                }\\n              >\\n                <div className=\\\"relative mx-auto max-w-lg\\\">\\n                  {isBloom ? (\\n                    <PolaroidFrame\\n                      caption={\\n                        chapter.polaroidCaption ?? \\\"your world, day 1 of forever\\\"\\n                      }\\n                      rotation={-2}\\n                    >\\n                      <div className=\\\"h-full w-full flex items-center justify-center bg-paper p-2\\\">\\n                        <IslandSketchSvg stage={5} />\\n                      </div>\\n                    </PolaroidFrame>\\n                  ) : (\\n                    <IslandSketchSvg stage={stage} />\\n                  )}\\n\\n                  {/* Static handwritten annotation */}\\n                  <div\\n                    className={`mt-2 flex items-center gap-2 font-handwriting text-base text-ink bg-paper/90 border border-dashed border-ink/35 px-2.5 py-1 rounded-sm w-fit ${arrowSpec.posClass}`}\\n                  >\\n                    <InkArrow\\n                      from={[0, 12]}\\n                      to={[38, 4]}\\n                      curvature={-0.2}\\n                      seed={70 + stage}\\n                      className=\\\"w-10 h-5\\\"\\n                    />\\n                    <span>{chapter.annotation}</span>\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n          </section>\\n        );\\n      })}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create StoryStatic fallback rendering all 6 chapters with cumulative SVG island illustrations and static annotations\", \"Overwrite\":true, \"TargetFile\":\"/src/sections/home/StoryStatic.tsx\", \"toolAction\":\"Creating StoryStatic fallback section\", \"toolSummary\":\"StoryStatic section creation\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16749954925589324847"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { Link } from \\\"react-router-dom\\\";\\nimport { links, story, type ChapterId } from \\\"@/content\\\";\\nimport { useQualityTier, useReducedMotion } from \\\"@/app/QualityProvider\\\";\\nimport { useSmoothScroll } from \\\"@/app/SmoothScroll\\\";\\nimport { gsap, ScrollTrigger, SplitText, useGSAP } from \\\"@/lib/gsap\\\";\\nimport {\\n  chapterAt,\\n  chapterProgress,\\n  storyStore,\\n} from \\\"@/lib/storyStore\\\";\\nimport {\\n  RoughUnderline,\\n  SeedSketchSvg,\\n  StickerButton,\\n  WashiTape,\\n} from \\\"@/components/sketch\\\";\\nimport type { IslandAnchors } from \\\"@/three/island/islandGenerator\\\";\\nimport { ChapterCard } from \\\"./ChapterCard\\\";\\nimport { updatePanelSketchDOM } from \\\"./PanelSketch\\\";\\nimport { StoryStatic } from \\\"./StoryStatic\\\";\\nimport { StoryVine, updateStoryVineDOM } from \\\"./StoryVine\\\";\\n\\nconst IslandCanvasLazy = React.lazy(() => import(\\\"@/three/IslandCanvas\\\"));\\n\\nfunction renderHeroHeading(heading: string, highlightWord?: string) {\\n  if (!highlightWord || !heading.includes(highlightWord)) return heading;\\n  const parts = heading.split(highlightWord);\\n  return (\\n    <>\\n      {parts[0]}\\n      <RoughUnderline drawIn>{highlightWord}</RoughUnderline>\\n      {parts.slice(1).join(highlightWord)}\\n    </>\\n  );\\n}\\n\\nconst CHAPTER_WINDOWS: {\\n  id: Exclude<ChapterId, \\\"seed\\\">;\\n  start: number;\\n  end: number;\\n  side: \\\"left\\\" | \\\"right\\\";\\n}[] = [\\n  { id: \\\"roots\\\", start: 0.1, end: 0.28, side: \\\"left\\\" },\\n  { id: \\\"shield\\\", start: 0.28, end: 0.46, side: \\\"right\\\" },\\n  { id: \\\"build\\\", start: 0.46, end: 0.66, side: \\\"left\\\" },\\n  { id: \\\"neighbors\\\", start: 0.66, end: 0.86, side: \\\"right\\\" },\\n  { id: \\\"bloom\\\", start: 0.86, end: 1.0, side: \\\"left\\\" },\\n];\\n\\nfunction computeCardVisibility(p: number, start: number, end: number, isBloom: boolean): number {\\n  const fadeIn = 0.035;\\n  const fadeOut = 0.03;\\n  if (p < start) return 0;\\n  if (p < start + fadeIn) return (p - start) / fadeIn;\\n  if (isBloom) {\\n    if (p > 0.96) return Math.max(0, (1.0 - p) / 0.04);\\n    return 1;\\n  }\\n  if (p > end) return 0;\\n  if (p > end - fadeOut) return Math.max(0, (end - p) / fadeOut);\\n  return 1;\\n}\\n\\nexport function Story() {\\n  const { tier } = useQualityTier();\\n  const reducedMotion = useReducedMotion();\\n\\n  if (tier === \\\"static\\\" || reducedMotion) {\\n    return <StoryStatic />;\\n  }\\n\\n  return <StoryInteractive />;\\n}\\n\\nfunction StoryInteractive() {\\n  const { tier } = useQualityTier();\\n  const { scrollToTarget } = useSmoothScroll();\\n\\n  // Fixed at initial mount so a runtime stepDown never jumps scroll geometry.\\n  const startingTierRef = React.useRef(tier);\\n\\n  const rootRef = React.useRef<HTMLDivElement | null>(null);\\n  const stageRef = React.useRef<HTMLDivElement | null>(null);\\n  const canvasWrapRef = React.useRef<HTMLDivElement | null>(null);\\n  const polaroidFrameRef = React.useRef<HTMLDivElement | null>(null);\\n  const heroOverlayRef = React.useRef<HTMLDivElement | null>(null);\\n  const heroTitleRef = React.useRef<HTMLHeadingElement | null>(null);\\n  const vineRef = React.useRef<HTMLElement | null>(null);\\n  const annotationRefs = React.useRef<Record<string, HTMLDivElement | null>>({});\\n\\n  const [canvasReady, setCanvasReady] = React.useState(false);\\n  const [inView, setInView] = React.useState(true);\\n\\n  const seedChapter = story.chapters[0];\\n  const restChapters = story.chapters.slice(1);\\n  const bloomChapter = story.chapters.find((c) => c.id === \\\"bloom\\\")!;\\n\\n  // Imperative DOM sync driven strictly from storyStore.progress (zero React re-renders)\\n  const applyProgressToDom = React.useCallback((p: number) => {\\n    const root = rootRef.current;\\n    if (!root) return;\\n\\n    // 1. Hero overlay (0.00..0.10)\\n    if (heroOverlayRef.current) {\\n      const heroAlpha = p <= 0.06 ? 1 : p >= 0.105 ? 0 : 1 - (p - 0.06) / 0.045;\\n      const shiftY = p <= 0.06 ? 0 : Math.min(24, ((p - 0.06) / 0.045) * 24);\\n      heroOverlayRef.current.style.opacity = heroAlpha.toFixed(3);\\n      heroOverlayRef.current.style.transform = `translate3d(0, ${(-shiftY).toFixed(1)}px, 0)`;\\n      heroOverlayRef.current.style.pointerEvents = heroAlpha > 0.15 ? \\\"auto\\\" : \\\"none\\\";\\n    }\\n\\n    // 2. Chapter cards (roots, shield, build, neighbors, bloom)\\n    CHAPTER_WINDOWS.forEach((win) => {\\n      const card = root.querySelector<HTMLElement>(`[data-chapter-card=\\\"${win.id}\\\"]`);\\n      if (!card) return;\\n      const isBloom = win.id === \\\"bloom\\\";\\n      const vis = computeCardVisibility(p, win.start, win.end, isBloom);\\n      const localT = chapterProgress(p, win.id);\\n      const slideOffset = (1 - vis) * 20;\\n      const tilt = win.side === \\\"left\\\" ? -1.1 * vis : 1.1 * vis;\\n      card.style.opacity = vis.toFixed(3);\\n      card.style.transform = `translate3d(0, ${slideOffset.toFixed(1)}px, 0) rotate(${tilt.toFixed(2)}deg)`;\\n      card.style.pointerEvents = vis > 0.25 ? \\\"auto\\\" : \\\"none\\\";\\n\\n      if (win.id === \\\"build\\\") {\\n        const panel = card.querySelector<HTMLElement>(\\\"[data-panel-sketch]\\\");\\n        updatePanelSketchDOM(panel, localT);\\n      }\\n    });\\n\\n    // 3. StoryVine progress & active leaf\\n    updateStoryVineDOM(vineRef.current, p);\\n\\n    // 4. Bloom Polaroid shrink in final 6% (0.94..1.00)\\n    if (canvasWrapRef.current && polaroidFrameRef.current) {\\n      const shrinkT = p <= 0.94 ? 0 : Math.min(1, (p - 0.94) / 0.06);\\n      const eased = shrinkT * shrinkT * (3 - 2 * shrinkT);\\n      const scale = 1 - eased * 0.62; // shrinks down to ~38% card size\\n      const isMobile = window.innerWidth < 768;\\n      const tx = isMobile ? 0 : eased * 24;\\n      const ty = isMobile ? eased * 18 : eased * 10;\\n      const rot = -3 * eased;\\n\\n      canvasWrapRef.current.style.transform =\\n        eased > 0.001\\n          ? `translate3d(${tx.toFixed(2)}%, ${ty.toFixed(2)}%, 0) scale(${scale.toFixed(3)}) rotate(${rot.toFixed(2)}deg)`\\n          : \\\"none\\\";\\n\\n      polaroidFrameRef.current.style.opacity = eased.toFixed(3);\\n    }\\n  }, []);\\n\\n  // Live 3D anchor -> DOM annotation positioning (called inside R3F useFrame)\\n  const handleProjectAnchors = React.useCallback(\\n    (projected: Record<keyof IslandAnchors, { x: number; y: number; visible: boolean }>) => {\\n      const p = storyStore.progress;\\n      const activeId = chapterAt(p);\\n      const wrap = canvasWrapRef.current;\\n      const width = wrap ? wrap.clientWidth : window.innerWidth;\\n      const height = wrap ? wrap.clientHeight : window.innerHeight;\\n\\n      const chapterToAnchor: Record<ChapterId, keyof IslandAnchors> = {\\n        seed: \\\"seed\\\",\\n        roots: \\\"ore\\\",\\n        shield: \\\"domeRim\\\",\\n        build: \\\"house\\\",\\n        neighbors: \\\"mascots\\\",\\n        bloom: \\\"house\\\",\\n      };\\n\\n      story.chapters.forEach((ch) => {\\n        const el = annotationRefs.current[ch.id];\\n        if (!el) return;\\n\\n        // Bloom uses polaroid caption instead of floating arrow\\n        if (ch.id === \\\"bloom\\\" || p > 0.92) {\\n          el.style.opacity = \\\"0\\\";\\n          return;\\n        }\\n\\n        const isCurrent = ch.id === activeId;\\n        const anchorKey = chapterToAnchor[ch.id];\\n        const pt = projected[anchorKey];\\n        if (!isCurrent || !pt || !pt.visible) {\\n          el.style.opacity = \\\"0\\\";\\n          return;\\n        }\\n\\n        // Clamp anchor within canvas frame and position label offset safely\\n        const ax = Math.max(40, Math.min(width - 40, pt.x));\\n        const ay = Math.max(48, Math.min(height - 48, pt.y));\\n        const preferLeft = ax > width * 0.56;\\n        const preferAbove = ay > height * 0.42;\\n\\n        const lx = preferLeft ? ax - 175 : ax + 56;\\n        const ly = preferAbove ? ay - 64 : ay + 48;\\n\\n        const clampedLx = Math.max(16, Math.min(width - 210, lx));\\n        const clampedLy = Math.max(64, Math.min(height - 56, ly));\\n\\n        el.style.opacity = \\\"1\\\";\\n        el.style.transform = `translate3d(${clampedLx.toFixed(1)}px, ${clampedLy.toFixed(1)}px, 0)`;\\n\\n        const arrowPath = el.querySelector<SVGPathElement>(\\\"[data-ann-arrow]\\\");\\n        if (arrowPath) {\\n          const dx = ax - clampedLx - (preferLeft ? 150 : 12);\\n          const dy = ay - clampedLy - (preferAbove ? 28 : 0);\\n          const cx = dx * 0.5 + (preferLeft ? 12 : -12);\\n          const cy = dy * 0.4 - 16;\\n          arrowPath.setAttribute(\\\"d\\\", `M 0 0 Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${dx.toFixed(1)} ${dy.toFixed(1)}`);\\n        }\\n      });\\n    },\\n    [],\\n  );\\n\\n  // One-time SplitText hero entrance + master scrubbed ScrollTrigger\\n  useGSAP(\\n    () => {\\n      if (!stageRef.current) return;\\n\\n      // 1. Hero intro plays once at load (progress 0)\\n      if (heroTitleRef.current) {\\n        const split = SplitText.create(heroTitleRef.current, { type: \\\"words\\\" });\\n        gsap.from(split.words, {\\n          y: 20,\\n          opacity: 0,\\n          duration: 0.65,\\n          stagger: 0.06,\\n          ease: \\\"power2.out\\\",\\n          clearProps: \\\"transform\\\",\\n        });\\n      }\\n\\n      // 2. Master scrubbed timeline driving progress 0 -> 1\\n      const scrollMultiplier = startingTierRef.current === \\\"low\\\" ? 3.5 : 5.0;\\n      ScrollTrigger.create({\\n        id: \\\"petalnode-story\\\",\\n        trigger: stageRef.current,\\n        pin: true,\\n        pinSpacing: true,\\n        scrub: 1,\\n        start: \\\"top top\\\",\\n        end: () => `+=${Math.round(window.innerHeight * scrollMultiplier)}`,\\n        invalidateOnRefresh: true,\\n        onUpdate: (self) => {\\n          storyStore.progress = self.progress;\\n          applyProgressToDom(self.progress);\\n        },\\n        onToggle: (self) => {\\n          setInView(self.isActive || window.scrollY < (self.end || 9999));\\n        },\\n      });\\n\\n      applyProgressToDom(storyStore.progress);\\n\\n      // Refresh once web fonts finish loading so pin geometry & SplitText settle cleanly\\n      if (typeof document !== \\\"undefined\\\" && document.fonts?.ready) {\\n        document.fonts.ready.then(() => {\\n          ScrollTrigger.refresh();\\n        });\\n      }\\n    },\\n    { scope: rootRef, dependencies: [applyProgressToDom] },\\n  );\\n\\n  // Pause 3D render loop once story scrolled cleanly past viewport\\n  React.useEffect(() => {\\n    const el = rootRef.current;\\n    if (!el || typeof IntersectionObserver === \\\"undefined\\\") return;\\n    const obs = new IntersectionObserver(\\n      ([entry]) => {\\n        setInView(entry.isIntersecting);\\n      },\\n      { threshold: 0 },\\n    );\\n    obs.observe(el);\\n    return () => obs.disconnect();\\n  }, []);\\n\\n  React.useEffect(() => {\\n    if (canvasReady) {\\n      ScrollTrigger.refresh();\\n    }\\n  }, [canvasReady]);\\n\\n  return (\\n    <section\\n      ref={rootRef}\\n      id=\\\"story\\\"\\n      data-story-mode=\\\"interactive\\\"\\n      aria-label=\\\"Petalnode server hosting story\\\"\\n      className=\\\"relative w-full\\\"\\n    >\\n      {/* Debug/E2E hook for monotonic progress check without React re-render */}\\n      <div\\n        ref={stageRef}\\n        className=\\\"relative h-screen w-full overflow-hidden bg-paper\\\"\\n      >\\n        {/* 3D Canvas wrapper: desktop full viewport; mobile top 58%.\\n            Shrinks into taped Polaroid at end of Bloom (0.94..1.00). */}\\n        <div\\n          ref={canvasWrapRef}\\n          className=\\\"absolute top-0 left-0 right-0 h-[58vh] md:h-full will-change-transform origin-[78%_84%]\\\"\\n        >\\n          {/* SVG Seed sketch shown immediately before 3D first frame, crossfades out */}\\n          <div\\n            aria-hidden=\\\"true\\\"\\n            className=\\\"pointer-events-none absolute inset-0 flex items-center justify-center md:justify-end md:pr-[16%] transition-opacity duration-500 z-10\\\"\\n            style={{ opacity: canvasReady ? 0 : 1 }}\\n          >\\n            <SeedSketchSvg className=\\\"w-[240px] sm:w-[290px] md:w-[340px]\\\" />\\n          </div>\\n\\n          <React.Suspense fallback={null}>\\n            <IslandCanvasLazy\\n              inView={inView}\\n              onReady={() => setCanvasReady(true)}\\n              onProjectAnchors={handleProjectAnchors}\\n            />\\n          </React.Suspense>\\n\\n          {/* Live projected annotations overlay */}\\n          <div\\n            aria-hidden=\\\"true\\\"\\n            className=\\\"pointer-events-none absolute inset-0 z-20 overflow-hidden\\\"\\n          >\\n            {story.chapters.map((ch) => (\\n              <div\\n                key={`ann-${ch.id}`}\\n                ref={(el) => {\\n                  annotationRefs.current[ch.id] = el;\\n                }}\\n                style={{ opacity: 0 }}\\n                className=\\\"absolute top-0 left-0 transition-opacity duration-150 will-change-transform\\\"\\n              >\\n                <div className=\\\"relative bg-paper/90 border border-dashed border-ink/40 px-2.5 py-1 rounded-sm shadow-[2px_2px_0_rgba(43,34,48,0.15)] max-w-[195px]\\\">\\n                  <span className=\\\"font-handwriting text-xs sm:text-sm font-semibold text-ink leading-snug block\\\">\\n                    {ch.annotation}\\n                  </span>\\n                  <svg\\n                    className=\\\"pointer-events-none absolute top-full left-4 overflow-visible\\\"\\n                    width=\\\"4\\\"\\n                    height=\\\"4\\\"\\n                  >\\n                    <path\\n                      data-ann-arrow\\n                      d=\\\"M 0 0 L 24 24\\\"\\n                      fill=\\\"none\\\"\\n                      stroke=\\\"#2B2230\\\"\\n                      strokeWidth=\\\"1.8\\\"\\n                      strokeLinecap=\\\"round\\\"\\n                    />\\n                  </svg>\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n\\n          {/* Polaroid bezel & caption that fades in during final 6% shrink */}\\n          <div\\n            ref={polaroidFrameRef}\\n            style={{ opacity: 0 }}\\n            className=\\\"pointer-events-none absolute inset-0 z-30 border-[14px] border-b-[52px] border-white ring-2 ring-ink shadow-[8px_10px_0_var(--color-ink)]\\\"\\n          >\\n            <div className=\\\"absolute -top-6 left-1/2 -translate-x-1/2\\\">\\n              <WashiTape rotation={-3} length={110} />\\n            </div>\\n            <p className=\\\"absolute -bottom-10 inset-x-0 text-center font-handwriting text-2xl text-ink font-semibold\\\">\\n              {bloomChapter.polaroidCaption}\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Hero DOM overlay (Chapter 0: Seed) */}\\n        <div\\n          ref={heroOverlayRef}\\n          className=\\\"absolute inset-x-0 bottom-0 h-[42vh] md:inset-y-0 md:h-auto z-20 flex items-center pointer-events-auto\\\"\\n        >\\n          <div className=\\\"mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 md:pt-12\\\">\\n            <div className=\\\"max-w-lg lg:max-w-xl bg-paper/85 md:bg-transparent backdrop-blur-[1px] md:backdrop-blur-none p-4 md:p-0 rounded-sm\\\">\\n              {seedChapter.eyebrow && (\\n                <p className=\\\"font-handwriting text-base sm:text-lg font-semibold text-blossom-600 mb-2\\\">\\n                  {seedChapter.eyebrow}\\n                </p>\\n              )}\\n              <h1\\n                ref={heroTitleRef}\\n                className=\\\"font-display-tight text-3xl sm:text-5xl lg:text-6xl text-ink leading-[1.06]\\\"\\n              >\\n                {renderHeroHeading(seedChapter.heading, seedChapter.highlightWord)}\\n              </h1>\\n              <p className=\\\"mt-3 sm:mt-5 text-sm sm:text-lg text-ink-soft leading-relaxed\\\">\\n                {seedChapter.body}\\n              </p>\\n              <div className=\\\"mt-5 sm:mt-7 flex flex-wrap items-center gap-3 sm:gap-4\\\">\\n                <StickerButton\\n                  href={links.store}\\n                  external\\n                  variant=\\\"primary\\\"\\n                  size=\\\"lg\\\"\\n                >\\n                  {story.heroPrimaryCta}\\n                </StickerButton>\\n                <Link\\n                  to=\\\"/plans\\\"\\n                  className=\\\"sticker-btn rounded-sm font-display font-bold bg-paper text-ink hover:bg-blossom-50 h-11 sm:h-13 px-5 sm:px-7 text-sm sm:text-base md:text-lg\\\"\\n                >\\n                  {story.heroSecondaryCta}\\n                </Link>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Scrubbed ChapterCards layer: bottom 42% on mobile, alternating left/right on desktop */}\\n        <div className=\\\"pointer-events-none absolute inset-x-0 bottom-0 h-[42vh] md:inset-0 md:h-full z-20 flex items-end md:items-center\\\">\\n          <div className=\\\"relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pb-4 md:pb-0 h-full\\\">\\n            {restChapters.map((chapter, idx) => {\\n              const side: \\\"left\\\" | \\\"right\\\" = idx % 2 === 0 ? \\\"left\\\" : \\\"right\\\";\\n              return (\\n                <div\\n                  key={chapter.id}\\n                  className=\\\"absolute inset-x-4 sm:inset-x-6 lg:inset-x-8 bottom-3 md:bottom-auto md:top-1/2 md:-translate-y-1/2\\\"\\n                >\\n                  <ChapterCard\\n                    chapter={chapter}\\n                    side={side}\\n                    onPickPlanClick={() => scrollToTarget(\\\"#plans-highlight\\\", -24)}\\n                    className=\\\"opacity-0\\\"\\n                  />\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Right-edge StoryVine (desktop only) */}\\n        <StoryVine ref={vineRef} />\\n      </div>\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Create interactive pinned scrubbed 3D Story component with Hero SplitText intro, alternating ChapterCards, StoryVine, live projected annotations, and Bloom polaroid transition\", \"Overwrite\":true, \"TargetFile\":\"/src/sections/home/Story.tsx\", \"toolAction\":\"Creating interactive Story section\", \"toolSummary\":\"Interactive Story section creation\"}"
      original_name: "write_to_file"
    }

    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "function makeDataTexture(data: Uint8Array, isColor: boolean): THREE.DataTexture {\n  const tex = new THREE.DataTexture(data, SIZE, SIZE, THREE.RGBAFormat);\n  tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n  tex.magFilter = THREE.NearestFilter;\n  tex.minFilter = THREE.LinearMipmapLinearFilter;\n  tex.generateMipmaps = true;\n  tex.wrapS = THREE.RepeatWrapping;\n  tex.wrapT = THREE.RepeatWrapping;\n  tex.needsUpdate = true;\n  return tex;\n}"
        replacement_content: "function makeDataTexture(data: Uint8Array, isColor: boolean): THREE.DataTexture {\n  const tex = new THREE.DataTexture(data, SIZE, SIZE, THREE.RGBAFormat);\n  tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n  tex.flipY = true;\n  tex.magFilter = THREE.NearestFilter;\n  tex.minFilter = THREE.LinearMipmapLinearFilter;\n  tex.generateMipmaps = true;\n  tex.wrapS = THREE.RepeatWrapping;\n  tex.wrapT = THREE.RepeatWrapping;\n  tex.needsUpdate = true;\n  return tex;\n}"
        start_line: 622
        end_line: 636
      }
      use_global_match: true
    }
    description: "Set tex.flipY = true on procedural DataTextures so y=0 (grass overhang, sapling/flower top) maps to the top edge of 3D block faces"
    diff_stats {
      additions: 1
    }
  }
}

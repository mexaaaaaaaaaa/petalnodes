            }
            lines {
              text: "            \"Manage paid Minecraft and VPS subscriptions, invoices, and plan upgrades inside https://billing.petalnodes.cloud.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"To claim Petal Free Server Rewards (6\342\200\22330 invites, 2GB\342\200\22317GB RAM) or Bloom Boost Rewards (1\342\200\2234 boosts, 3GB\342\200\22312GB RAM), open a Discord Support Ticket.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }

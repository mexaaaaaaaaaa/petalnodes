      thinking_signature: "\022\360\025\n\355\025\001i\024}\023^)\211\035\343\207&\215\033\372~gM\002\265\003?\255s[\031<\317\371\356\347\240\020\275\374b2\332\311\316!=\027\023\002\264\345&l\347\000Z:\026\016\317(\270\032\231j\235\216\262\370\316Q}K)\270\352C\201\322\351I^\212\246\273,\370\r\237\311 \273oT\024\304\021\334E\t\313\227\204z\337T\270T\241\200\260]\260\250M\366\004\255\253BT\210\345\240\277\201\326\032\332E\202\263\253C\3067W\262\233\271q[\025\240\277M\024K\266\rs\361\'J\307\320\213\314i\266\215C8tM\305W\251\345o\276\271a\213\335A\314\3425\004T\324\254\256\313\305\0251\320\314\'\261\325\315\232\377\311\207\341\376\354\211\034\341\327Z\0021a\302p\335\314z\352\364\316\202\f~5\035\237\203\fD\307\220\327\234\207\363\364\321\243G4\337\376\"k\201\351\231a\004\n+\\\335\237\t;9\322iN\374\277\247\254\364\246P\215x\321\246\225X\221Ib\246{9\261\213\327c0<7\236\207E0\261c@\303\024\344\221^\361K\324\027\323\243\300Uv|s\234\2231\227\252A\364\253CR\267\253\357\233\241\017\245j\357\247\017\225=\270\247\036HT\024\301l\363\266\225Q\205,\334\364\221\037\370XE\316\203}\2731\257b\b\b\006\304\'9\021bM\262\351ZH\224s\237\217?\221\3656;\025\236.\f\373\3239_\202\307B:b%\255\022\255\236\\P\003\221\234=\"\3339KLuPK\031\300\265\203\310\367\320\352Q\245\223\252s\260\324\276\326UW\033\214aq#\225\a\314X$O\244\006\265\216\2719Ng\214\361\223\372H\244*\004_\276\\\342\277\312uio\341\376\267\213\021\"\r\347\356\034Y\030s\020\227V\335a\204p\272\026\2151\262^\357I\26717\252\362\335\253a2\333eK&\261$\375\235\016\370\361,\327\217\221\314\f\226\321\225\002\bG\200\212T\'\002\276\224\310\217\003S\006\027\212W\320\224\021\003\237\024\004ps\240\202\177@\225A\2343\353\260\247\302H>\306o^\347T\367\343k\334\020C\252\247|U\314\210\b\333\033+\360[C\374^85\361\002\333\006Jg\a#F\331\034\351\271]\327\317K\206\211\236\262A\254\321\277E\252\240\\\211\a<\000\035\216Mx\031\b\225\311>4&s\201/\017\340\264\277g\251.\304\tD\243\304\3546\002\2157\305\036\327\230\341\337\353c\262\206\257w\262\341z\242\031]\251\250)
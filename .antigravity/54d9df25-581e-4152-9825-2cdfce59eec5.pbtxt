  code_action {
    action_spec {
      create_file {
        instruction: "import test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  brand,\n  faq,\n  highlightPlanIds,\n  listTodos,\n  nav,\n  planIncludes,\n  plans,\n  plansSection,\n  story,\n  trust,\n} from \"./index\";\n\ntest(\"plans has six tiers in order seed, sprout, sapling, blossom, grove, orchard\", () => {\n  assert.deepEqual(\n    plans.map((p) => p.id),\n    [\"seed\", \"sprout\", \"sapling\", \"blossom\", \"grove\", \"orchard\"],\n  );\n});\n\ntest(\"exactly one plan is ourPick and it is sapling\", () => {\n  const picks = plans.filter((p) => p.ourPick);\n  assert.equal(picks.length, 1);\n  assert.equal(picks[0].id, \"sapling\");\n});\n\ntest(\"highlightPlanIds are sprout, sapling, blossom and all exist\", () => {\n  assert.deepEqual(highlightPlanIds, [\"sprout\", \"sapling\", \"blossom\"]);\n  const ids = new Set(plans.map((p) => p.id));\n  for (const id of highlightPlanIds) {\n    assert.ok(ids.has(id));\n  }\n});\n\ntest(\"every plan ram matches 2, 4, 6, 8, 12, 16\", () => {\n  assert.deepEqual(\n    plans.map((p) => p.ramGb),\n    [2, 4, 6, 8, 12, 16],\n  );\n});\n\ntest(\"listTodos finds store URL, discord URL, and every plan price\", () => {\n  const todos = listTodos();\n  const paths = new Set(todos.map((t) => t.path));\n  assert.ok(paths.has(\"links.store\"));\n  assert.ok(paths.has(\"links.discord\"));\n  for (let i = 0; i < plans.length; i++) {\n    assert.ok(paths.has(`plans[${i}].priceMonthly`));\n  }\n});\n\ntest(\"no content string contains a forbidden copy word\", () => {\n  const forbidden =\n    /\\b(unleash|elevate|seamless|next-level|cutting-edge|supercharge|revolutionize|empower)\\b/i;\n  const serialized = JSON.stringify({\n    brand,\n    planIncludes,\n    plans,\n    nav,\n    story,\n    plansSection,\n    trust,\n    faq,\n  });\n  assert.equal(forbidden.test(serialized), false);\n});\n"
        path {
          absolute_uri: "file:///src/content/content.test.ts"
        }
        overwrite: true
      }
    }

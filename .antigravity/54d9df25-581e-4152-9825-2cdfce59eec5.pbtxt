    tool_calls {
      id: "call_9958912456696288525"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport * as THREE from \\\"three\\\";\\nimport { useFrame, useThree } from \\\"@react-three/fiber\\\";\\nimport type { IslandAnchors } from \\\"@/three/island/islandGenerator\\\";\\nimport { storyStore } from \\\"@/lib/storyStore\\\";\\n\\ninterface CameraKeyframe {\\n  p: number;\\n  pos: THREE.Vector3;\\n  look: THREE.Vector3;\\n}\\n\\nconst _pos = new THREE.Vector3();\\nconst _look = new THREE.Vector3();\\nconst _proj = new THREE.Vector3();\\n\\nexport type AnchorScreenCallback = (\\n  projected: Record<keyof IslandAnchors, { x: number; y: number; visible: boolean }>,\\n) => void;\\n\\nexport function CameraRig({\\n  anchors,\\n  isMobile,\\n  onProjectAnchors,\\n}: {\\n  anchors: IslandAnchors;\\n  isMobile: boolean;\\n  onProjectAnchors?: AnchorScreenCallback;\\n}) {\\n  const { camera, size } = useThree();\\n\\n  const keyframes = React.useMemo<CameraKeyframe[]>(() => {\\n    const xOffset = isMobile ? 0 : -1.35; // Desktop: seed sits right of center, text on left\\n    const yMobile = isMobile ? -0.35 : 0.1;\\n\\n    return [\\n      // 0: Seed (Hero) \342\200\224 close three-quarter view\\n      {\\n        p: 0.0,\\n        pos: new THREE.Vector3(3.1 + xOffset, 2.7 + yMobile, 3.6),\\n        look: new THREE.Vector3(xOffset * 0.85, 0.55 + yMobile * 0.4, 0),\\n      },\\n      {\\n        p: 0.1,\\n        pos: new THREE.Vector3(4.5 + xOffset, 2.3, 4.8),\\n        look: new THREE.Vector3(xOffset * 0.6, 0.2, 0),\\n      },\\n      // 1: Roots \342\200\224 lowers and pulls back to underground side view\\n      {\\n        p: 0.2,\\n        pos: new THREE.Vector3(4.2, -3.6, 20.5),\\n        look: new THREE.Vector3(0.5, -3.5, 0),\\n      },\\n      // 2: Shield \342\200\224 rises to eye level wider so whole dome is visible\\n      {\\n        p: 0.37,\\n        pos: new THREE.Vector3(18.0, 9.2, 26.5),\\n        look: new THREE.Vector3(0, 2.8, 0),\\n      },\\n      // 3: Build \342\200\224 high three-quarter aerial view\\n      {\\n        p: 0.56,\\n        pos: new THREE.Vector3(-16.5, 19.5, 22.0),\\n        look: new THREE.Vector3(0, 1.5, 0),\\n      },\\n      // 4: Neighbors \342\200\224 lower and closer to the house & mascots\\n      {\\n        p: 0.76,\\n        pos: new THREE.Vector3(anchors.house.x + 7.5, anchors.house.y + 1.8, anchors.house.z - 12.5),\\n        look: new THREE.Vector3(anchors.mascots.x - 1.0, anchors.mascots.y + 0.2, anchors.mascots.z + 1.5),\\n      },\\n      // 5: Bloom \342\200\224 pull far back and orbit ~30deg\\n      {\\n        p: 1.0,\\n        pos: new THREE.Vector3(24.0, 16.5, 28.0),\\n        look: new THREE.Vector3(0, 0.2, 0),\\n      },\\n    ];\\n  }, [anchors, isMobile]);\\n\\n  const anchorVecs = React.useMemo(\\n    () => ({\\n      seed: new THREE.Vector3(anchors.seed.x, anchors.seed.y, anchors.seed.z),\\n      ore: new THREE.Vector3(anchors.ore.x, anchors.ore.y, anchors.ore.z),\\n      domeRim: new THREE.Vector3(anchors.domeRim.x, anchors.domeRim.y, anchors.domeRim.z),\\n      house: new THREE.Vector3(anchors.house.x, anchors.house.y, anchors.house.z),\\n      mascots: new THREE.Vector3(anchors.mascots.x, anchors.mascots.y, anchors.mascots.z),\\n    }),\\n    [anchors],\\n  );\\n\\n  useFrame(({ clock }) => {\\n    const p = storyStore.progress;\\n    const t = clock.getElapsedTime();\\n\\n    let k0 = keyframes[0];\\n    let k1 = keyframes[keyframes.length - 1];\\n    for (let i = 0; i < keyframes.length - 1; i++) {\\n      if (p >= keyframes[i].p && p <= keyframes[i + 1].p) {\\n        k0 = keyframes[i];\\n        k1 = keyframes[i + 1];\\n        break;\\n      }\\n    }\\n\\n    const span = Math.max(1e-5, k1.p - k0.p);\\n    const localT = THREE.MathUtils.smoothstep((p - k0.p) / span, 0, 1);\\n\\n    _pos.copy(k0.pos).lerp(k1.pos, localT);\\n    _look.copy(k0.look).lerp(k1.look, localT);\\n\\n    // Subtle slow orbit in Neighbors and Bloom\\n    if (p > 0.65) {\\n      const orbitAmp = THREE.MathUtils.smoothstep(p, 0.66, 0.9) * 1.4;\\n      _pos.x += Math.sin(t * 0.3) * orbitAmp;\\n      _pos.z += Math.cos(t * 0.3) * orbitAmp * 0.5;\\n    }\\n\\n    camera.position.copy(_pos);\\n    camera.lookAt(_look);\\n    camera.updateMatrixWorld();\\n\\n    if (onProjectAnchors) {\\n      const projected = {} as Record<\\n        keyof IslandAnchors,\\n        { x: number; y: number; visible: boolean }\\n      >;\\n      (Object.keys(anchorVecs) as (keyof IslandAnchors)[]).forEach((key) => {\\n        _proj.copy(anchorVecs[key]).project(camera);\\n        projected[key] = {\\n          x: ((_proj.x + 1) * 0.5) * size.width,\\n          y: ((1 - _proj.y) * 0.5) * size.height,\\n          visible: _proj.z < 1 && _proj.z > -1,\\n        };\\n      });\\n      onProjectAnchors(projected);\\n    }\\n  });\\n\\n  return null;\\n}\\n\", \"Description\":\"Create CameraRig with smooth chapter keyframes and zero-GC anchor screen projection\", \"Overwrite\":true, \"TargetFile\":\"/src/three/story/CameraRig.tsx\", \"toolAction\":\"Writing CameraRig and anchor projection\", \"toolSummary\":\"Write CameraRig.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9958912456696289424"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport * as THREE from \\\"three\\\";\\nimport { Canvas, useFrame, useThree } from \\\"@react-three/fiber\\\";\\nimport { AdaptiveDpr, PerformanceMonitor } from \\\"@react-three/drei\\\";\\nimport { RoomEnvironment } from \\\"three/examples/jsm/environments/RoomEnvironment.js\\\";\\nimport { useQualityTier } from \\\"@/app/QualityProvider\\\";\\nimport { buildIsland, type IslandAnchors } from \\\"./island/islandGenerator\\\";\\nimport { IslandBlocks } from \\\"./island/IslandBlocks\\\";\\nimport {\\n  PetalsAndFireflies,\\n  ShieldDomeAndAttacks,\\n  SkyAndLights,\\n  VoxelMascots,\\n} from \\\"./story/StorySetPieces\\\";\\nimport { CameraRig, type AnchorScreenCallback } from \\\"./story/CameraRig\\\";\\nimport { PostFX } from \\\"./effects/PostFX\\\";\\nimport { storyStore } from \\\"@/lib/storyStore\\\";\\n\\nfunction RoomEnvSetup() {\\n  const { gl, scene } = useThree();\\n  React.useEffect(() => {\\n    const pmrem = new THREE.PMREMGenerator(gl);\\n    const envTex = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\\n    scene.environment = envTex;\\n    scene.environmentIntensity = 0.35;\\n    pmrem.dispose();\\n    return () => {\\n      envTex.dispose();\\n    };\\n  }, [gl, scene]);\\n  return null;\\n}\\n\\nfunction SnapshotWatcher() {\\n  const { gl, scene, camera } = useThree();\\n  useFrame(() => {\\n    const p = storyStore.progress;\\n    if (p >= 0.94 && !storyStore.snapshotCaptured) {\\n      storyStore.snapshotCaptured = true;\\n      try {\\n        gl.render(scene, camera);\\n        const url = gl.domElement.toDataURL(\\\"image/png\\\");\\n        storyStore.snapshotDataUrl = url;\\n        storyStore.onSnapshot?.(url);\\n      } catch {\\n        // Ignore security/context read failures gracefully\\n      }\\n    }\\n  });\\n  return null;\\n}\\n\\nfunction SoftwareGlPacer({ inView }: { inView: boolean }) {\\n  const { invalidate, gl } = useThree();\\n  const { isSoftwareGl } = useQualityTier();\\n\\n  React.useEffect(() => {\\n    if (!isSoftwareGl || !inView) return;\\n    let alive = true;\\n    let timerId = 0;\\n\\n    const scheduleNext = () => {\\n      if (!alive) return;\\n      const ctx = gl.getContext() as WebGL2RenderingContext | null;\\n      const sync = ctx && typeof ctx.fenceSync === \\\"function\\\"\\n        ? ctx.fenceSync(ctx.SYNC_GPU_COMMANDS_COMPLETE, 0)\\n        : null;\\n      if (ctx && sync) {\\n        ctx.flush();\\n        const poll = () => {\\n          if (!alive) {\\n            ctx.deleteSync(sync);\\n            return;\\n          }\\n          const status = ctx.getSyncParameter(sync, ctx.SYNC_STATUS);\\n          if (status === ctx.UNSIGNALED) {\\n            timerId = window.setTimeout(poll, 10);\\n          } else {\\n            ctx.deleteSync(sync);\\n            timerId = window.setTimeout(() => {\\n              if (!alive) return;\\n              invalidate();\\n              scheduleNext();\\n            }, 90);\\n          }\\n        };\\n        timerId = window.setTimeout(poll, 10);\\n      } else {\\n        timerId = window.setTimeout(() => {\\n          if (!alive) return;\\n          invalidate();\\n          scheduleNext();\\n        }, 120);\\n      }\\n    };\\n\\n    invalidate();\\n    scheduleNext();\\n\\n    const onScroll = () => {\\n      invalidate();\\n    };\\n    window.addEventListener(\\\"scroll\\\", onScroll, { passive: true });\\n    return () => {\\n      alive = false;\\n      window.clearTimeout(timerId);\\n      window.removeEventListener(\\\"scroll\\\", onScroll);\\n    };\\n  }, [isSoftwareGl, inView, invalidate, gl]);\\n\\n  return null;\\n}\\n\\nexport interface IslandCanvasProps {\\n  inView: boolean;\\n  onReady?: () => void;\\n  onProjectAnchors?: AnchorScreenCallback;\\n}\\n\\nexport default function IslandCanvas({\\n  inView,\\n  onReady,\\n  onProjectAnchors,\\n}: IslandCanvasProps) {\\n  const { tier, isSoftwareGl, stepDown, forceStatic } = useQualityTier();\\n  const [isMobile, setIsMobile] = React.useState(\\n    typeof window !== \\\"undefined\\\" ? window.innerWidth < 768 : false,\\n  );\\n\\n  React.useEffect(() => {\\n    const onResize = () => setIsMobile(window.innerWidth < 768);\\n    window.addEventListener(\\\"resize\\\", onResize);\\n    return () => window.removeEventListener(\\\"resize\\\", onResize);\\n  }, []);\\n\\n  const island = React.useMemo(\\n    () => buildIsland({ sizeFactor: tier === \\\"low\\\" ? 0.6 : 1, seed: 42 }),\\n    [tier],\\n  );\\n\\n  const dpr: [number, number] = isSoftwareGl\\n    ? [1, 1]\\n    : tier === \\\"high\\\"\\n      ? [1, 2]\\n      : tier === \\\"medium\\\"\\n        ? [1, 1.25]\\n        : [1, 1];\\n\\n  return (\\n    <Canvas\\n      shadows={tier !== \\\"low\\\" && !isSoftwareGl}\\n      dpr={dpr}\\n      frameloop={isSoftwareGl ? \\\"demand\\\" : inView ? \\\"always\\\" : \\\"demand\\\"}\\n      camera={{ fov: isMobile ? 48 : 38, near: 0.1, far: 260, position: [3.1, 2.7, 3.6] }}\\n      gl={{\\n        antialias: !isSoftwareGl && tier === \\\"high\\\",\\n        powerPreference: \\\"high-performance\\\",\\n        preserveDrawingBuffer: true,\\n        toneMapping: THREE.ACESFilmicToneMapping,\\n        toneMappingExposure: 1.0,\\n      }}\\n      onCreated={({ gl }) => {\\n        gl.domElement.addEventListener(\\n          \\\"webglcontextlost\\\",\\n          (e) => {\\n            e.preventDefault();\\n            forceStatic();\\n          },\\n          false,\\n        );\\n        onReady?.();\\n      }}\\n    >\\n      <PerformanceMonitor\\n        onDecline={() => {\\n          if (!isSoftwareGl) stepDown();\\n        }}\\n      />\\n      <AdaptiveDpr pixelated />\\n      <RoomEnvSetup />\\n      <SkyAndLights tier={tier} />\\n      <IslandBlocks blocks={island.blocks} tier={tier} />\\n      <ShieldDomeAndAttacks />\\n      <PetalsAndFireflies tier={tier} />\\n      <VoxelMascots anchors={island.anchors as IslandAnchors} />\\n      <CameraRig\\n        anchors={island.anchors}\\n        isMobile={isMobile}\\n        onProjectAnchors={onProjectAnchors}\\n      />\\n      <SnapshotWatcher />\\n      <SoftwareGlPacer inView={inView} />\\n      <PostFX />\\n    </Canvas>\\n  );\\n}\\n\", \"Description\":\"Create lazy-loaded R3F IslandCanvas with PerformanceMonitor, RoomEnvironment, context-loss static fallback, and software-WebGL pacing\", \"Overwrite\":true, \"TargetFile\":\"/src/three/IslandCanvas.tsx\", \"toolAction\":\"Writing IslandCanvas R3F root component\", \"toolSummary\":\"Write IslandCanvas.tsx\"}"
      original_name: "write_to_file"

      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { isTodo } from \\\"@/content\\\";\\nimport { cn } from \\\"@/lib/utils\\\";\\n\\nexport interface StickerButtonProps {\\n  children: React.ReactNode;\\n  href?: string;\\n  onClick?: (e: React.MouseEvent) => void;\\n  variant?: \\\"primary\\\" | \\\"outline\\\" | \\\"dark\\\";\\n  size?: \\\"sm\\\" | \\\"md\\\" | \\\"lg\\\";\\n  external?: boolean;\\n  className?: string;\\n  \\\"aria-label\\\"?: string;\\n}\\n\\nexport function StickerButton({\\n  children,\\n  href,\\n  onClick,\\n  variant = \\\"primary\\\",\\n  size = \\\"md\\\",\\n  external = false,\\n  className,\\n  \\\"aria-label\\\": ariaLabel,\\n}: StickerButtonProps) {\\n  const todoHref = href && isTodo(href);\\n  const isDev = import.meta.env.DEV;\\n\\n  const variantClasses =\\n    variant === \\\"primary\\\"\\n      ? \\\"bg-blossom-600 text-white hover:bg-blossom-600/95\\\"\\n      : variant === \\\"dark\\\"\\n        ? \\\"bg-ink text-paper hover:bg-ink/90\\\"\\n        : \\\"bg-paper text-ink hover:bg-blossom-50\\\";\\n\\n  const sizeClasses =\\n    size === \\\"sm\\\"\\n      ? \\\"h-10 px-4 text-sm\\\"\\n      : size === \\\"lg\\\"\\n        ? \\\"h-13 px-7 text-base md:text-lg\\\"\\n        : \\\"h-11 px-5 text-[15px]\\\";\\n\\n  const devTodoClass =\\n    todoHref && isDev ? \\\"border-dashed outline-2 outline-dashed outline-blossom-600/50 outline-offset-2\\\" : \\\"\\\";\\n\\n  const sharedClass = cn(\\n    \\\"sticker-btn rounded-sm font-display font-bold whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-ink focus-visible:outline-offset-3\\\",\\n    variantClasses,\\n    sizeClasses,\\n    devTodoClass,\\n    className,\\n  );\\n\\n  if (href) {\\n    return (\\n      <a\\n        href={href}\\n        onClick={(e) => {\\n          if (todoHref) {\\n            e.preventDefault();\\n          }\\n          onClick?.(e);\\n        }}\\n        target={external && !todoHref ? \\\"_blank\\\" : undefined}\\n        rel={external && !todoHref ? \\\"noopener noreferrer\\\" : undefined}\\n        title={todoHref && isDev ? \\\"TODO: link\\\" : undefined}\\n        aria-label={ariaLabel}\\n        className={sharedClass}\\n      >\\n        {children}\\n      </a>\\n    );\\n  }\\n\\n  return (\\n    <button\\n      type=\\\"button\\\"\\n      onClick={onClick}\\n      aria-label={ariaLabel}\\n      className={sharedClass}\\n    >\\n      {children}\\n    </button>\\n  );\\n}\\n\", \"Description\":\"Create StickerButton component with 3px ink shadow and dev TODO link indicator\", \"Overwrite\":true, \"TargetFile\":\"/src/components/sketch/StickerButton.tsx\", \"toolAction\":\"Writing StickerButton component\", \"toolSummary\":\"Write StickerButton.tsx\"}"
      original_name: "write_to_file"
    }

      create_file {
        instruction: "import type { CrewMember, DoodleKind, FooterAction, FooterColumn, FooterLink } from \"@/components/ui/doodle-crew-footer\";\nimport {\n  aboutPage,\n  contactPage,\n  docsPage,\n  legalDocs,\n  locationsPage,\n  modpacksPage,\n} from \"./pages\";\n\nexport * from \"./pages\";\n\nexport type PlanId =\n  | \"seed\"\n  | \"sprout\"\n  | \"sapling\"\n  | \"blossom\"\n  | \"grove\"\n  | \"orchard\"\n  | \"sakura\";\n\nexport interface Plan {\n  id: PlanId;\n  name: string;\n  ramGb: number;\n  cpu: string;\n  storage: string;\n  goodFor: string;\n  priceMonthly: string;\n  paymenterUrl: string;\n  cardLine: string;\n  ourPick?: boolean;\n}\n\nexport type VpsPlanId = \"root\" | \"branch\" | \"trunk\" | \"canopy\" | \"evergrove\";\n\nexport interface VpsPlan {\n  id: VpsPlanId;\n  name: string;\n  ramGb: number;\n  vcpu: string;\n  storage: string;\n  priceMonthly: string;\n  paymenterUrl: string;\n  cardLine: string;\n}\n\nexport interface FreeRewardTier {\n  id: string;\n  name: string;\n  invitesRequired: number;\n  ramGb: number;\n}\n\nexport interface BoostRewardTier {\n  id: string;\n  name: string;\n  boostsRequired: number;\n  ramGb: number;\n}\n\nexport interface BotPlanDraft {\n  id: string;\n  proposedName: string;\n  ram: string;\n  cpu: string;\n  storage: string;\n  priceMonthly: string;\n  paymenterUrl: string;\n}\n\nexport type ChapterId = \"seed\" | \"roots\" | \"shield\" | \"build\" | \"neighbors\" | \"bloom\";\n\nexport interface StoryChapterContent {\n  id: ChapterId;\n  vineLabel: string;\n  kicker?: string;\n  eyebrow?: string;\n  heading: string;\n  highlightWord?: string;\n  body: string;\n  todoNote?: string;\n  specs?: { label: string; value: string }[];\n  annotation: string;\n  anchorName: \"seed\" | \"ore\" | \"domeRim\" | \"house\" | \"mascots\";\n  panelLoaders?: string[];\n  panelName?: string;\n  polaroidCaption?: string;\n  ctaLabel?: string;\n}\n\nexport interface FaqItem {\n  id: number;\n  question: string;\n  answer: string;\n}\n\nexport interface ReviewItem {\n  author: string;\n  role: string;\n  quote: string;\n}\n\nexport const brand = {\n  name: \"Petalnodes\",\n  wordmark: \"PETALNODES\",\n  logoText: \"petalnodes\",\n  tagline: \"Plant a seed. Grow a world.\",\n  oneLiner: \"Minecraft & VPS hosting, grown with care.\",\n  metaTitle: \"Petalnodes \342\200\224 Cherry Blossom Minecraft & VPS Hosting\",\n  metaDescription:\n    \"Minecraft and VPS hosting across Singapore, Miami, and India on AMD Ryzen & Intel Xeon Gold hardware with DDR5, NVMe storage, DDoS protection, and daily backups.\",\n  disclaimer:\n    \"Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\",\n  copyright:\n    \"\302\251 2026 Petalnodes. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\",\n};\n\nexport const links = {\n  siteUrl: \"https://petalnodes.cloud\",\n  store: \"https://billing.petalnodes.cloud\",\n  clientArea: \"https://billing.petalnodes.cloud\",\n  gamePanel: \"https://panel.petalnodes.cloud\",\n  discord: \"https://discord.gg/GS3wuc4HGk\",\n  status: \"https://status.petalnodes.cloud\",\n  docs: \"/docs\",\n  terms: \"/terms\",\n  privacy: \"/privacy\",\n  sla: \"/sla\",\n  locations: \"/locations\",\n  modpacks: \"/modpacks\",\n  about: \"/about\",\n  contact: \"/contact\",\n  plans: \"/plans\",\n  vps: \"/vps\",\n  bots: \"/bots\",\n  socials: [\n    { label: \"YouTube\", href: \"TODO: verified YouTube URL (Petalnodes)\" },\n    { label: \"X\", href: \"TODO: verified X URL (@petalnodes)\" },\n    { label: \"Instagram\", href: \"TODO: verified Instagram URL (@petalnodes)\" },\n  ] as FooterLink[],\n};\n\nexport const planIncludes: string[] = [\n  \"Java & Bedrock Support\",\n  \"Paper, Purpur & Fabric\",\n  \"2 Allocations\",\n  \"2 Database Access Slots\",\n  \"NVMe Storage\",\n  \"DDoS Protection\",\n  \"Daily Backups Included\",\n];\n\nexport const plans: Plan[] = [\n  {\n    id: \"seed\",\n    name: \"Seed\",\n    ramGb: 2,\n    cpu: \"100%\",\n    storage: \"10GB NVMe\",\n    goodFor: \"2\342\200\2235 friends, vanilla\",\n    priceMonthly: \"\342\202\27159\",\n    paymenterUrl: \"TODO: Seed Paymenter URL\",\n    cardLine: \"Just you and a couple of friends.\",\n  },\n  {\n    id: \"sprout\",\n    name: \"Sprout\",\n    ramGb: 4,\n    cpu: \"150%\",\n    storage: \"15GB NVMe\",\n    goodFor: \"5\342\200\22310 players, light plugins\",\n    priceMonthly: \"\342\202\27199\",\n    paymenterUrl: \"TODO: Sprout Paymenter URL\",\n    cardLine: \"A cozy survival world that\'s starting to grow.\",\n  },\n  {\n    id: \"sapling\",\n    name: \"Sapling\",\n    ramGb: 8,\n    cpu: \"250%\",\n    storage: \"25GB NVMe\",\n    goodFor: \"10\342\200\22320 players, plugin servers\",\n    priceMonthly: \"\342\202\271169\",\n    paymenterUrl: \"TODO: Sapling Paymenter URL\",\n    cardLine: \"The sweet spot. Room for plugins and friends.\",\n    ourPick: true,\n  },\n  {\n    id: \"blossom\",\n    name: \"Blossom\",\n    ramGb: 12,\n    cpu: \"350%\",\n    storage: \"35GB NVMe\",\n    goodFor: \"Active SMPs & Fabric mods\",\n    priceMonthly: \"\342\202\271239\",\n    paymenterUrl: \"TODO: Blossom Paymenter URL\",\n    cardLine: \"Modded adventures, in full bloom.\",\n  },\n  {\n    id: \"grove\",\n    name: \"Grove\",\n    ramGb: 16,\n    cpu: \"400%\",\n    storage: \"45GB NVMe\",\n    goodFor: \"Heavy Paper/Fabric worlds\",\n    priceMonthly: \"\342\202\271299\",\n    paymenterUrl: \"TODO: Grove Paymenter URL\",\n    cardLine: \"Room to spare for bustling towns.\",\n  },\n  {\n    id: \"orchard\",\n    name: \"Orchard\",\n    ramGb: 20,\n    cpu: \"500%\",\n    storage: \"55GB NVMe\",\n    goodFor: \"Large communities & heavy plugins\",\n    priceMonthly: \"\342\202\271369\",\n    paymenterUrl: \"TODO: Orchard Paymenter URL\",\n    cardLine: \"A whole orchard of thriving worlds.\",\n  },\n  {\n    id: \"sakura\",\n    name: \"Sakura\",\n    ramGb: 24,\n    cpu: \"600%\",\n  
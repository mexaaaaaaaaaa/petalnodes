playwright-cli eval \\\"document.querySelector(\\\\\\\"footer\\\\\\\")?.scrollIntoView()\\\"\\nsleep 0.9\\nplaywright-cli eval \\\"(() => { const hit = document.querySelector(\\\\\\\"footer .dcf-hit\\\\\\\"); hit?.dispatchEvent(new MouseEvent(\\\\\\\"click\\\\\\\", { bubbles: true })); const bubble = document.querySelector(\\\\\\\"footer .dcf-bubble\\\\\\\")?.textContent; const sr = document.querySelector(\\\\\\\"footer h2\\\\\\\")?.textContent; const disc = document.body.innerText.includes(\\\\\\\"Not an official Minecraft product\\\\\\\"); return { bubble, sr, disc }; })()\\\"\\n\\n# Route-hopping check: Home -> Plans -> Back -> Home\\nplaywright-cli goto \\\"http://localhost:3000/plans\\\"\\nsleep 1.0\\nplaywright-cli run-code \\\"async page => { await page.screenshot({ path: \\\\\\\".playwright-verify/plans-desktop.png\\\\\\\", animations: \\\\\\\"disabled\\\\\\\" }); }\\\"\\nplaywright-cli eval \\\"({ cardCount: document.querySelectorAll(\\\\\\\"[data-plan-id]\\\\\\\").length, overflow: document.documentElement.scrollWidth > window.innerWidth, faqCount: document.querySelectorAll(\\\\\\\"[data-radix-collection-item]\\\\\\\").length })\\\"\\n\\nplaywright-cli go-back\\nsleep 1.0\\nplaywright-cli eval \\\"({ pinSpacers: document.querySelectorAll(\\\\\\\".pin-spacer\\\\\\\").length, scrollY: window.scrollY, hasCanvas: !!document.querySelector(\\\\\\\"canvas\\\\\\\") })\\\"\\n\\n# 404 check\\nplaywright-cli goto \\\"http://localhost:3000/missing-page\\\"\\nsleep 0.8\\nplaywright-cli run-code \\\"async page => { await page.screenshot({ path: \\\\\\\".playwright-verify/not-found.png\\\\\\\", animations: \\\\\\\"disabled\\\\\\\" }); }\\\"\\n\\n# Static fallback check\\nplaywright-cli goto \\\"http://localhost:3000/?static=1\\\"\\nsleep 0.8\\nplaywright-cli run-code \\\"async page => { await page.screenshot({ path: \\\\\\\".playwright-verify/home-static.png\\\\\\\", animations: \\\\\\\"disabled\\\\\\\" }); }\\\"\\nplaywright-cli eval \\\"({ mode: document.getElementById
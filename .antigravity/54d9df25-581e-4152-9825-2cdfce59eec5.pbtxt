            }
            lines {
              text: "  const sizeFactor = options.sizeFactor ?? 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const seed = options.seed ?? 42;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const radiusScale = Math.sqrt(sizeFactor);"

  code_action {
    action_spec {
      create_file {
        instruction: "import * as React from \"react\";\nimport { isTodo, plans, plansSection, planIncludes } from \"@/content\";\nimport { RoughBox, Stamp, StickerButton } from \"@/components/sketch\";\nimport { cn } from \"@/lib/utils\";\n\nexport function CompareTable() {\n  const backupsText =\n    planIncludes.find((line) => line.toLowerCase().includes(\"backup\")) ?? \"Daily backups\";\n\n  return (\n    <section aria-labelledby=\"compare-heading\" className=\"mt-20\">\n      <h2\n        id=\"compare-heading\"\n        className=\"font-display-tight text-3xl md:text-4xl text-ink mb-6\"\n      >\n        {plansSection.compareHeading}\n      </h2>\n\n      <RoughBox\n        seed={304}\n        bgClassName=\"bg-paper\"\n        padding=\"p-0\"\n        className=\"overflow-hidden shadow-[4px_5px_0_var(--color-ink)]\"\n      >\n        <div className=\"notebook-ruled overflow-x-auto\">\n          <table className=\"w-full min-w-[780px] border-collapse text-left text-sm\">\n            <thead>\n              <tr className=\"border-b-2 border-ink bg-paper-shade/85\">\n                <th\n                  scope=\"col\"\n                  className=\"sticky left-0 z-20 bg-paper-shade px-4 py-4 font-display-tight text-base text-ink border-r-2 border-blossom-200 min-w-[140px]\"\n                >\n                  Feature\n                </th>\n                {plans.map((plan) => (\n                  <th\n                    key={plan.id}\n                    scope=\"col\"\n                    className={cn(\n                      \"px-4 py-4 font-display-tight text-lg text-ink align-bottom\",\n                      plan.ourPick && \"bg-blossom-50/70\",\n                    )}\n                  >\n                    <div className=\"flex flex-col items-start gap-1\">\n                      {plan.ourPick && (\n                        <Stamp text={plansSection.ourPickLabel} rotation={-4} size=\"sm\" />\n                      )}\n                      <span>{plan.name}</span>\n                    </div>\n                  </th>\n                ))}\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-paper-line/80\">\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  RAM\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 font-pixel text-xl text-blossom-600\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {plan.ramGb} GB\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  CPU\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 font-pixel text-base text-ink\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {plan.cpu}\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  Storage\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 font-pixel text-base text-ink\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {plan.storage}\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  Good for\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 text-ink-soft\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {plan.goodFor}\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  DDoS protection\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 font-semibold text-moss\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    Always on\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  Backups\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5 text-ink-soft\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {backupsText}\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  Price\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-3.5\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    {isTodo(plan.priceMonthly) ? (\n                      <div className=\"inline-flex items-center gap-1.5\">\n                        <span className=\"font-pixel text-lg text-ink\">$\342\200\224 /mo</span>\n                        <Stamp text=\"TODO\" rotation={-4} size=\"sm\" />\n                      </div>\n                    ) : (\n                      <span className=\"font-pixel text-lg text-ink\">\n                        {plan.priceMonthly} /mo\n                      </span>\n                    )}\n                  </td>\n                ))}\n              </tr>\n              <tr>\n                <th\n                  scope=\"row\"\n                  className=\"sticky left-0 z-10 bg-paper px-4 py-4 font-bold text-ink border-r-2 border-blossom-200\"\n                >\n                  Plant\n                </th>\n                {plans.map((plan) => (\n                  <td\n                    key={plan.id}\n                    className={cn(\n                      \"px-4 py-4\",\n                      plan.ourPick && \"bg-blossom-50/50\",\n                    )}\n                  >\n                    <StickerButton\n                      href={plan.paymenterUrl}\n                      external\n                      variant={plan.ourPick ? \"primary\" : \"outline\"}\n                      size=\"sm\"\n                    >\n                      {plan.name}\n                    </StickerButton>\n                  </td>\n                ))}\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </RoughBox>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/sections/plans/CompareTable.tsx"
        }
        overwrite: true
      }
    }

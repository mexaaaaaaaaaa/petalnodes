            lines {
              text: "import { links, story, type ChapterId } from \"@/content\";"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "import { useQualityTier, useReducedMotion } from \"@/app/QualityProvider\";"

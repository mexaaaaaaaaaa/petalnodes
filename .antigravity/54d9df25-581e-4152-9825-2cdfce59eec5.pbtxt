              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const wx = ((cx % period) + period) % period;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {

, { waitUntil: \"domcontentloaded\" });  await page.waitForSelector(\"h1\", { timeout: 10000 });  await page.waitForTimeout(1600);  const devTitle = await page.title();  const devH1 = await page.locator(\"h1\").textContent();  await page.screenshot({ path: \".playwright-cli/dev-textures.png\", timeout: 20000 });  return JSON.stringify({ errors, mobileReport, devTitle, devH1 }, null, 2);})(page);```### Page- Page URL: http://localhost:3000/dev/textures- Page Title: Dev Procedural Texture Inspector | Petalnodes- Console: 0 errors, 14 warnings### Events- New console entries: .playwright-cli/console-2026-11-20T17-40-46-378Z.log#L2-L28Browser \'default\' closed\n\n### Latest snapshot (.playwright-cli/page-2026-11-20T17-40-49-728Z.yml)\n```yaml\n- generic [ref=e3]:\n  - banner [ref=e4]:\n    - generic [ref=e6]:\n      - link \"Nodey mascot petalnodes\" [ref=e7] [cursor=pointer]:\n        - /url: /\n        - img \"Nodey mascot\" [ref=e9]\n        - generic [ref=e31]: petalnodes\n      - navigation \"Primary\" [ref=e32]:\n        - link \"Home\" [ref=e33] [cursor=pointer]:\n          - /url: /\n        - link \"Minecraft Hosting\" [ref=e34] [cursor=pointer]:\n          - /url: /plans\n        - link \"VPS Hosting\" [ref=e35] [cursor=pointer]:\n          - /url: /vps\n        - link \"Bot Hosting\" [ref=e36] [cursor=pointer]:\n          - /url: /bots\n        - link \"Server Locations\" [ref=e37] [cursor=pointer]:\n          - /url: /locations\n        - link \"Documentation\" [ref=e38] [cursor=pointer]:\n          - /url: /docs\n        - link \"Discord\" [ref=e39] [cursor=pointer]:\n          - /url: https://discord.gg/GS3wuc4HGk\n      - link \"Client Area\" [ref=e46] [cursor=pointer]:\n        - /url: https://billing.petalnodes.cloud\n  - main [ref=e48]:\n    - generic [ref=e49]:\n      - generic [ref=e50]:\n        - paragraph [ref=e51]: global regions\n        - heading [level=1] [ref=e52]:\n          - text: Three\n          - generic [ref=e53]: regions\n          - 
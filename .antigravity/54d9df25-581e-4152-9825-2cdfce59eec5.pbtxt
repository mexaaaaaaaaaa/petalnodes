              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"Yes \342\200\224 Daily Backups Included, Network Protection, DDoS Protection, Cloudflare protection, and Discord Support come standard across Root through Evergrove.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

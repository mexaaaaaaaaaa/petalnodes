      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add Bot Hosting quick link in PlansHighlight navigation links\", \"EndLine\":110, \"Instruction\":\"Add link to /bots alongside /plans, /vps, and rewards in PlansHighlight.tsx\", \"ReplacementContent\":\"        <Link\\n          to=\\\"/vps\\\"\\n          className=\\\"inline-flex items-center gap-2 font-display text-base font-bold text-ink-soft hover:text-blossom-600 underline decoration-dashed underline-offset-4 transition-colors\\\"\\n        >\\n          Explore KVM VPS plans \342\206\222\\n        </Link>\\n        <Link\\n          to=\\\"/bots\\\"\\n          className=\\\"inline-flex items-center gap-2 font-display text-base font-bold text-ink-soft hover:text-blossom-600 underline decoration-dashed underline-offset-4 transition-colors\\\"\\n        >\\n          Preview Bot Hosting (Miami) \342\206\222\\n        </Link>\\n        <Link\\n          to=\\\"/plans#free-rewards\\\"\\n          className=\\\"inline-flex items-center gap-2 font-display text-base font-bold text-ink-soft hover:text-blossom-600 underline decoration-dashed underline-offset-4 transition-colors\\\"\\n        >\\n          Petal &amp; Bloom Discord rewards \342\206\222\\n        </Link>\", \"StartLine\":97, \"TargetContent\":\"        <Link\\n          to=\\\"/vps\\\"\\n          className=\\\"inline-flex items-center gap-2 font-display text-base font-bold text-ink-soft hover:text-blossom-600 underline decoration-dashed underline-offset-4 transition-colors\\\"\\n        >\\n          Explore KVM VPS plans \342\206\222\\n        </Link>\\n        <Link\\n          to=\\\"/plans#free-rewards\\\"\\n          className=\\\"inline-flex items-center gap-2 font-display text-base font-bold text-ink-soft hover:text-blossom-600 underline decoration-dashed underline-offset-4 transition-colors\\\"\\n        >\\n          Petal &amp; Bloom Discord rewards \342\206\222\\n        </Link>\", \"TargetFile\":\"/src/sections/home/PlansHi
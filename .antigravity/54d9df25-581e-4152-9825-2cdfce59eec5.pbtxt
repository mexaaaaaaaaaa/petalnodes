  view_file {
    absolute_path_uri: "file:///src/components/sketch/LineBoilFilters.tsx"
    end_line: 57
    content: "import * as React from \"react\";\nimport { useReducedMotion } from \"@/app/QualityProvider\";\n\nexport function LineBoilFilters() {\n  return (\n    <svg\n      aria-hidden=\"true\"\n      width=\"0\"\n      height=\"0\"\n      style={{ position: \"absolute\", width: 0, height: 0, overflow: \"hidden\" }}\n    >\n      <defs>\n        {[0, 1, 2].map((k) => (\n          <filter\n            key={k}\n            id={`petalnode-boil-${k}`}\n            x=\"-12%\"\n            y=\"-12%\"\n            width=\"124%\"\n            height=\"124%\"\n          >\n            <feTurbulence\n              type=\"fractalNoise\"\n              baseFrequency=\"0.032\"\n              numOctaves=\"2\"\n              seed={k * 11 + 5}\n              result=\"noise\"\n            />\n            <feDisplacementMap\n              in=\"SourceGraphic\"\n              in2=\"noise\"\n              scale=\"2.1\"\n              xChannelSelector=\"R\"\n              yChannelSelector=\"G\"\n            />\n          </filter>\n        ))}\n      </defs>\n    </svg>\n  );\n}\n\nexport function useBoilFilter(enabled = true): string | undefined {\n  const reducedMotion = useReducedMotion();\n  const [frame, setFrame] = React.useState(0);\n\n  React.useEffect(() => {\n    if (!enabled || reducedMotion) return;\n    const id = window.setInterval(() => {\n      setFrame((f) => (f + 1) % 3);\n    }, 125); // ~8 fps\n    return () => window.clearInterval(id);\n  }, [enabled, reducedMotion]);\n\n  if (!enabled || reducedMotion) return undefined;\n  return `url(#petalnode-boil-${frame})`;\n}\n"
    num_lines: 58
    num_bytes: 1486
    line_range_bytes: 1486
  }

      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { cn } from \\\"@/lib/utils\\\";\\n\\nexport function Stamp({\\n  text,\\n  rotation = -6,\\n  size = \\\"md\\\",\\n  className,\\n}: {\\n  text: string;\\n  rotation?: number;\\n  size?: \\\"sm\\\" | \\\"md\\\";\\n  className?: string;\\n}) {\\n  return (\\n    <span\\n      className={cn(\\n        \\\"inline-block font-handwriting font-bold uppercase tracking-wider text-blossom-600 border-2 border-blossom-600 rounded-[3px] select-none stamp-animate\\\",\\n        size === \\\"sm\\\" ? \\\"px-1.5 py-0.5 text-[11px] leading-none\\\" : \\\"px-2.5 py-1 text-xs leading-none\\\",\\n        className,\\n      )}\\n      style={\\n        {\\n          \\\"--stamp-rot\\\": `${rotation}deg`,\\n          transform: `rotate(${rotation}deg)`,\\n          boxShadow: \\\"inset 0 0 0 1px rgba(226, 85, 123, 0.25)\\\",\\n        } as React.CSSProperties\\n      }\\n    >\\n      {text}\\n    </span>\\n  );\\n}\\n\", \"Description\":\"Create Stamp rubber-stamp badge component for OUR PICK and TODO labels\", \"Overwrite\":true, \"TargetFile\":\"/src/components/sketch/Stamp.tsx\", \"toolAction\":\"Writing Stamp component\", \"toolSummary\":\"Write Stamp.tsx\"}"

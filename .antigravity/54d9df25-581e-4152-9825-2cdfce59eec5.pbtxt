              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const s = petalSeeds[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const yRange = 18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const y = (((s.y - t * s.speed) % yRange) + yRange) % yRange - 3;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const x = s.x + Math.sin(t * s.sway + s.phase) * 1.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const z = s.z + Math.cos(t * s.sway * 0.8 + s.phase) * 1.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _dummy.position.set(x, y, z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _dummy.rotation.set(t * 1.2 + s.phase, t * 0.9, Math.sin(t + s.phase) * 0.6);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _dummy.scale.set(0.18, 0.12, 0.04);"

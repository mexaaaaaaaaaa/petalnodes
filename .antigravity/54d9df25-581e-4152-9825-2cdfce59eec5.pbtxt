            }
            lines {
              text: "        rgb = wave > 0.68 ? cWaterFoam : mixRgb([84, 160, 212], cWater, wave);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        alpha = 215;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        h = 0.45 + wave * 0.25;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const caustic = worley(x * 0.12, y * 0.12, 8, baseSeed + 17);"

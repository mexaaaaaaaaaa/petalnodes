  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 203
    content: "import * as React from \"react\";\nimport { BrowserRouter, Route, Routes, useLocation } from \"react-router-dom\";\nimport { QualityProvider } from \"@/app/QualityProvider\";\nimport { SmoothScrollProvider, useSmoothScroll } from \"@/app/SmoothScroll\";\nimport { PageShell } from \"@/components/layout/PageShell\";\nimport { brand } from \"@/content\";\nimport { ScrollTrigger } from \"@/lib/gsap\";\nimport { chapterStart } from \"@/lib/storyStore\";\nimport Home from \"@/pages/Home\";\nimport Plans from \"@/pages/Plans\";\nimport VpsHosting from \"@/pages/VpsHosting\";\nimport BotHosting from \"@/pages/BotHosting\";\nimport Locations from \"@/pages/Locations\";\nimport Docs from \"@/pages/Docs\";\nimport Modpacks from \"@/pages/Modpacks\";\nimport About from \"@/pages/About\";\nimport Contact from \"@/pages/Contact\";\nimport LegalPage from \"@/pages/LegalPage\";\nimport NotFound from \"@/pages/NotFound\";\n\nconst DevSketchLazy = (import.meta.env && import.meta.env.DEV)\n  ? React.lazy(() => import(\"@/pages/DevSketch\"))\n  : null;\nconst DevTexturesLazy = (import.meta.env && import.meta.env.DEV)\n  ? React.lazy(() => import(\"@/pages/DevTextures\"))\n  : null;\n\nconst ROUTE_META: Record<string, { title: string; description: string }> = {\n  \"/\": {\n    title: brand.metaTitle,\n    description: brand.metaDescription,\n  },\n  \"/plans\": {\n    title: \"Minecraft Hosting Plans \342\200\224 Seed to Sakura | Petalnodes\",\n    description:\n      \"Seven Cherry Blossom Minecraft hosting tiers from 2GB Seed (\342\202\27159/mo) to 24GB Sakura (\342\202\271449/mo) with Java & Bedrock, Paper/Purpur/Fabric, NVMe, DDoS protection, and daily backups.\",\n  },\n  \"/vps\": {\n    title: \"VPS Hosting Plans \342\200\224 Root to Evergrove | Petalnodes\",\n    description:\n      \"Cherry Blossom KVM Linux VPS hosting from 4GB Root (\342\202\271300/mo) to 16GB Evergrove (\342\202\2711,600/mo) on AMD Ryzen and Intel Xeon Gold infrastructure.\",\n  },\n  \"/bots\": {\n    title: \"Bot Hosting (Draft) | Petalnodes\",\n    description:\n      \"Discord and community bot hosting backed by NVMe storage, DDoS protection, and the Petalnodes Game Panel.\",\n  },\n  \"/locations\": {\n    title: \"Server Locations \342\200\224 Singapore, Miami & India | Petalnodes\",\n    description:\n      \"Petalnodes global server locations across Singapore (SG), Miami (USA), and India (IN) powered by Ryzen & Xeon Gold hardware.\",\n  },\n  \"/docs\": {\n    title: \"Documentation & Knowledge Base | Petalnodes\",\n    description:\n      \"Step-by-step Petalnodes guides for server setup, Paper/Purpur/Fabric, Java & Bedrock, backups, and billing.\",\n  },\n  \"/modpacks\": {\n    title: \"Modpacks & Server Software \342\200\224 Paper, Purpur & Fabric | Petalnodes\",\n    description:\n      \"Run Paper, Purpur, or Fabric servers on Petalnodes with NVMe storage and easy File Management via panel.petalnodes.cloud.\",\n  },\n  \"/about\": {\n    title: \"About Petalnodes\",\n    description:\n      \"Learn about Petalnodes Cherry Blossom Minecraft and VPS infrastructure across Singapore, Miami, and India.\",\n  },\n  \"/contact\": {\n    title: \"Contact & Support | Petalnodes\",\n    description:\n      \"Reach the Petalnodes team through Discord tickets, Client Area billing tickets, and live server status.\",\n  },\n  \"/terms\": {\n    title: \"Terms of Service (Draft) | Petalnodes\",\n    description: \"Draft Terms of Service for Petalnodes hosting and community reward services.\",\n  },\n  \"/privacy\": {\n    title: \"Privacy Policy (Draft) | Petalnodes\",\n    description: \"Draft Privacy Policy for Petalnodes services.\",\n  },\n  \"/sla\": {\n    title: \"Service Level Agreement (Draft) | Petalnodes\",\n    description: \"Draft Service Level Agreement and live status practices for Petalnodes.\",\n  },\n  \"/dev/textures\": {\n    title: \"Dev Procedural Texture Inspector | Petalnodes\",\n    description: \"Development preview of 64x64 procedural PBR block textures.\",\n  },\n  \"/dev/sketch\": {\n    title: \"Dev Sketchbook Kit | Petalnodes\",\n    description: \"Development preview of Petalnodes sketchbook UI components.\",\n  },\n};\n\nfunction RouteMetaAndScrollSync() {\n  const location = useLocation();\n  const { scrollToStoryProgress, scrollToTarget } = useSmoothScroll();\n\n  React.useEffect(() => {\n    const meta = ROUTE_META[location.pathname] ?? {\n      title: `Page Not Found | ${brand.name}`,\n      description: brand.metaDescription,\n    };\n    document.title = meta.title;\n\n    const setMetaContent = (selector: string, content: string) => {\n      const el = document.querySelector(selector);\n      if (el) el.setAttribute(\"content\", content);\n    };\n    setMetaContent(\'meta[name=\"description\"]\', meta.description);\n    setMetaContent(\'meta[property=\"og:title\"]\', meta.title);\n    setMetaContent(\'meta[property=\"og:description\"]\', meta.description);\n    setMetaContent(\'meta[name=\"twitter:title\"]\', meta.title);\n    setMetaContent(\'meta[name=\"twitter:description\"]\', meta.description);\n\n    const canonical = document.querySelector(\'link[rel=\"canonical\"]\');\n    if (canonical) {\n      canonical.setAttribute(\"href\", window.location.origin + window.location.pathname);\n    }\n  }, [location.pathname]);\n\n  React.useEffect(() => {\n    if (location.pathname === \"/\" && location.hash === \"#roots\") {\n      const id = window.setTimeout(() => {\n        const staticRoots = document.getElementById(\"chapter-roots\");\n        if (staticRoots) {\n          scrollToTarget(staticRoots, -20);\n        } else {\n          scrollToStoryProgress(chapterStart(\"roots\") + 0.01);\n        }\n        ScrollTrigger.refresh();\n      }, 120);\n      return () => window.clearTimeout(id);\n    }\n\n    if (location.hash) {\n      const id = window.setTimeout(() => {\n        const target = document.getElementById(location.hash.slice(1));\n        if (target) {\n          target.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n        }\n      }, 90);\n      return () => window.clearTimeout(id);\n    }\n\n    window.scrollTo({ top: 0, behavior: \"auto\" });\n    const id = window.setTimeout(() => {\n      ScrollTrigger.refresh();\n    }, 60);\n    return () => window.clearTimeout(id);\n  }, [location.pathname, location.hash, scrollToStoryProgress, scrollToTarget]);\n\n  return null;\n}\n\nexport default function App() {\n  return (\n    <QualityProvider>\n      <BrowserRouter>\n        <SmoothScrollProvider>\n          <RouteMetaAndScrollSync />\n          <PageShell>\n            <Routes>\n              <Route path=\"/\" element={<Home />} />\n              <Route path=\"/plans\" element={<Plans />} />\n              <Route path=\"/vps\" element={<VpsHosting />} />\n              <Route path=\"/bots\" element={<BotHosting />} />\n              <Route path=\"/locations\" element={<Locations />} />\n              <Route path=\"/docs\" element={<Docs />} />\n              <Route path=\"/modpacks\" element={<Modpacks />} />\n              <Route path=\"/about\" element={<About />} />\n              <Route path=\"/contact\" element={<Contact />} />\n              <Route path=\"/terms\" element={<LegalPage docId=\"terms\" />} />\n              <Route path=\"/privacy\" element={<LegalPage docId=\"privacy\" />} />\n              <Route path=\"/sla\" element={<LegalPage docId=\"sla\" />} />\n              {(import.meta.env && import.meta.env.DEV) && DevSketchLazy && (\n                <Route\n                  path=\"/dev/sketch\"\n                  element={\n                    <React.Suspense fallback={<div className=\"pt-28 text-center\">Loading\342\200\246</div>}>\n                      <DevSketchLazy />\n                    </React.Suspense>\n                  }\n                />\n              )}\n              {(import.meta.env && import.meta.env.DEV) && DevTexturesLazy && (\n                <Route\n                  path=\"/dev/textures\"\n                  element={\n                    <React.Suspense fallback={<div className=\"pt-28 text-center\">Loading\342\200\246</div>}>\n                      <DevTexturesLazy />\n                    </React.Suspense>\n                  }\n                />\n              )}\n              <Route path=\"*\" element={<NotFound />} />\n            </Routes>\n          </PageShell>\n        </SmoothScrollProvider>\n      </BrowserRouter>\n    </QualityProvider>\n  );\n}\n"
    num_lines: 204
    num_bytes: 7990
    line_range_bytes: 7990
  }
}

lassName=\"underline decoration-wavy decoration-blossom-400 underline-offset-4 hover:text-blossom-600\"\n          >\n            Discord boost rewards \342\206\223\n          </a>\n        </div>\n      </header>\n\n      <PlanGrid />\n      <CompareTable />\n      <RewardsSection />\n\n      <div className=\"mt-20\">\n        <FAQ\n          filterIds={faq.plansPageIds}\n          className=\"mx-auto max-w-3xl py-8\"\n        />\n      </div>\n    </div>\n  );\n}\n"

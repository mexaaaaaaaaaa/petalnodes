    end_line: 198
    content: "import * as React from \"react\";\nimport { botHosting, links } from \"@/content\";\nimport {\n  RoughBox,\n  RoughUnderline,\n  Stamp,\n  StickerButton,\n  WashiTape,\n} from \"@/components/sketch\";\n\nexport default function BotHosting() {\n  const parts = botHosting.heading.split(botHosting.highlightWord);\n\n  return (\n    <div className=\"mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-28 pb-16\">\n      <header className=\"max-w-2xl mb-12\">\n        <p className=\"font-handwriting text-lg font-semibold text-blossom-600 mb-2\">\n          {botHosting.eyebrow}\n        </p>\n        <h1 className=\"font-display-tight text-4xl sm:text-5xl md:text-6xl text-ink\">\n          {parts[0]}\n          <RoughUnderline drawIn>{botHosting.highlightWord}</RoughUnderline>\n          {parts.slice(1).join(botHosting.highlightWord)}\n        </h1>\n        <p className=\"mt-5 text-lg text-ink-soft leading-relaxed\">\n          {botHosting.sub}\n        </p>\n        <div className=\"mt-6 flex flex-wrap gap-3\">\n          <StickerButton href={links.discord} external variant=\"primary\" size=\"md\">\n            Ask or Enquire on Discord\n          </StickerButton>\n          <StickerButton href={links.store} external variant=\"outline\" size=\"md\">\n            Open Billing Store\n          </StickerButton>\n        </div>\n      </header>\n\n      {/* Owner confirmation banner */}\n      <RoughBox\n        seed={901}\n        bgClassName=\"bg-blossom-50\"\n        padding=\"p-5 sm:p-6\"\n        className=\"mb-14 shadow-[4px_4px_0_var(--color-ink)]\"\n      >\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div className=\"space-y-1\">\n            <h2 className=\"font-display-tight text-xl text-ink\">\n              Specifications &amp; Runtimes Awaiting Confirmation\n            </h2>\n            <p className=\"text-sm text-ink-soft\">{botHosting.draftNotice}</p>\n            <p className=\"text-xs font-handwriting text-blossom-600\">\n              {botHosting.proposedNamingNote}\n            </p>\n          </div>\n          <Stamp text=\"TODO\" rotation={-4} size=\"md\" className=\"shrink-0 bg-paper\" />\n        </div>\n      </RoughBox>\n\n      {/* Features grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-16\">\n        {botHosting.features.map((feat, i) => (\n          <RoughBox\n            key={feat.title}\n            seed={910 + i}\n            bgClassName=\"bg-paper-shade\"\n            padding=\"p-6\"\n            className=\"shadow-[3px_4px_0_var(--color-ink)]\"\n          >\n            <h2 className=\"font-display-tight text-xl text-ink\">{feat.title}</h2>\n            <p className=\"mt-2 text-sm text-ink-soft leading-relaxed\">{feat.detail}</p>\n          </RoughBox>\n        ))}\n      </div>\n\n      {/* Proposed Plans (unconfirmed TODO placeholders, zero invented prices/specs) */}\n      <section aria-labelledby=\"bot-plans-heading\" className=\"mb-16\">\n        <div className=\"flex flex-wrap items-center justify-between gap-4 mb-8\">\n          <h2 id=\"bot-plans-heading\" className=\"font-display-tight text-3xl text-ink\">\n            Proposed Botanical Tiers\n          </h2>\n          <span className=\"font-handwriting text-sm text-blossom-600\">\n            {botHosting.supportedRuntimesTodo}\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-7\">\n          {botHosting.plans.map((tier, idx) => (\n            <div key={tier.id} className=\"relative\">\n              <div className=\"pointer-events-none absolute -top-3 left-1/2 -translate-x-1/2 z-20\">\n                <WashiTape rotation={idx === 1 ? 0 : idx === 0 ? -4 : 4} length={80} />\n              </div>\n              <RoughBox\n                seed={920 + idx}\n                bgClassName=\"bg-paper\"\n                padding=\"p-6 pt-7\"\n                className=\"shadow-[4px_5px_0_var(--color-ink)] h-full flex flex-col\"\n              >\n                <div className=\"flex items-start justify-between gap-2\">\n                  <h3 className=\"font-display-tight text-2xl text-ink\">\n                    {tier.proposedName}\n                  </h3>\n                  <Stamp text=\"DRAFT\" rotation={5} size=\"sm\" />\n                </div>\n\n                <dl className=\"mt-4 space-y-2 border-y border-dashed border-paper-line py-3 text-sm\">\n                  <div className=\"flex justify-between\">\n                    <dt className=\"text-ink-soft font-semibold\">RAM</dt>\n                    <dd className=\"font-pixel text-ink\">{tier.ram}</dd>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <dt className=\"text-ink-soft font-semibold\">CPU</dt>\n                    <dd className=\"font-pixel text-ink\">{tier.cpu}</dd>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <dt className=\"text-ink-soft font-semibold\">NVMe Storage</dt>\n                    <dd className=\"font-pixel text-ink\">{tier.storage}</dd>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <dt className=\"text-ink-soft font-semibold\">Runtimes</dt>\n                    <dd className=\"font-pixel text-ink\">TODO</dd>\n                  </div>\n                </dl>\n\n                <div className=\"mt-auto pt-5\">\n                  <div className=\"mb-3 flex items-center gap-2\">\n                    <span className=\"font-pixel text-2xl text-ink\">\342\202\271\342\200\224 /mo</span>\n                    <Stamp text=\"TODO\" rotation={-4} size=\"sm\" />\n                  </div>\n                  <StickerButton\n                    href={links.discord}\n                    external\n                    variant=\"outline\"\n                    size=\"md\"\n                    className=\"w-full\"\n                  >\n                    Enquire on Discord \342\206\222\n                  </StickerButton>\n                </div>\n              </RoughBox>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Comparison Table */}\n      <section aria-labelledby=\"bot-compare-heading\">\n        <h2 id=\"bot-compare-heading\" className=\"font-display-tight text-3xl text-ink mb-6\">\n          Bot Hosting Comparison (Draft)\n        </h2>\n        <RoughBox\n          seed={935}\n          bgClassName=\"bg-paper\"\n          padding=\"p-0\"\n          className=\"overflow-hidden shadow-[4px_5px_0_var(--color-ink)]\"\n        >\n          <div className=\"notebook-ruled overflow-x-auto\">\n            <table className=\"w-full min-w-[640px] border-collapse text-left text-sm\">\n              <thead>\n                <tr className=\"border-b-2 border-ink bg-paper-shade/85\">\n                  <th scope=\"col\" className=\"sticky left-0 z-20 bg-paper-shade px-4 py-4 font-display-tight text-base text-ink border-r-2 border-blossom-200\">\n                    Specification\n                  </th>\n                  {botHosting.plans.map((p) => (\n                    <th key={p.id} scope=\"col\" className=\"px-4 py-4 font-display-tight text-lg text-ink\">\n                      {p.proposedName}\n                    </th>\n                  ))}\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-paper-line/80\">\n                <tr>\n                  <th scope=\"row\" className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\">RAM</th>\n                  {botHosting.plans.map((p) => <td key={p.id} className=\"px-4 py-3.5 font-pixel text-ink\">{p.ram}</td>)}\n                </tr>\n                <tr>\n                  <th scope=\"row\" className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\">CPU</th>\n                  {botHosting.plans.map((p) => <td key={p.id} className=\"px-4 py-3.5 font-pixel text-ink\">{p.cpu}</td>)}\n                </tr>\n                <tr>\n                  <th scope=\"row\" className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\">NVMe Storage</th>\n                  {botHosting.plans.map((p) => <td key={p.id} className=\"px-4 py-3.5 font-pixel text-ink\">{p.storage}</td>)}\n                </tr>\n                <tr>\n                  <th scope=\"row\" className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\">Panel &amp; Protection</th>\n                  {botHosting.plans.map((p) => <td key={p.id} className=\"px-4 py-3.5 text-ink-soft\">Game Panel \302\267 DDoS Protection</td>)}\n                </tr>\n                <tr>\n                  <th scope=\"row\" className=\"sticky left-0 z-10 bg-paper px-4 py-3.5 font-bold text-ink border-r-2 border-blossom-200\">Price</th>\n                  {botHosting.plans.map((p) => <td key={p.id} className=\"px-4 py-3.5 font-pixel text-ink\">{p.priceMonthly}</td>)}\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </RoughBox>\n      </section>\n    </div>\n  );\n}\n"
    num_lines: 199

              text: "          rgb = mixRgb(cDeepDark, cDeepLight, strata * 0.62 + cells.id * 0.38);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rgb = shadeRgb(rgb, 1 + (micro - 0.5) * 0.12 * grain);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (cells.edge < 0.11) rgb = mixRgb(rgb, cDeepLight, 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          h = 0.34 + strata * 0.36 + cells.id * 0.18;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          rough = 0.6 + (1 - cells.id) * 0.22;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          h = clamp01(0.32 + strata * 0.38 + cells.id * 0.2 + microGrain * 0.85);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rough = clamp01(0.58 + (1 - cells.id) * 0.24 + (micro - 0.5) * 0.1 * grain);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      } else if (type === \"glow_ore\") {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const strata = fbm(x * 0.14, y * 0.2, baseSeed, 4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const slate = worley(x * 0.14, y * 0.14, 9, baseSeed + 14);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        rgb = mixRgb(cDeepDark, cDeepStone, strata * 0.65 + slate.id * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        h = 0.32 + strata * 0.32;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        rough = 0.78;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Faceted crystalline geode pockets with dark rim socket & bright faceted heart"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const crystalField = fbm(x * 0.15 + 2, y * 0.15 + 4, baseSeed + 55, 3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const crystalCells = worley(x * 0.22, y * 0.22, 14, baseSeed + 66);"

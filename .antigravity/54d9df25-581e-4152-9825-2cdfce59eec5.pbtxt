            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  for (let dy = -1; dy <= 1; dy++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    for (let dx = -1; dx <= 1; dx++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const cx = ix + dx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {

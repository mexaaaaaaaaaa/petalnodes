              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uShimmer: { value: 0 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uTime: { value: 0 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    [],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Deterministic attack particle trajectories"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const attacks = React.useMemo(() => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return Array.from({ length: 18 }, (_, i) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const angle = (i / 18) * Math.PI * 2 + (i % 3) * 0.25;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const elev = 0.22 + ((i * 7) % 10) * 0.055;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dir = new THREE.Vector3("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Math.cos(angle) * Math.cos(elev),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Math.sin(elev),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Math.sin(angle) * Math.cos(elev),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dir,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        phaseOffset: (i * 0.13) % 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }, []);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  useFrame(({ clock }) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const p = storyStore.progress;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const shieldP = chapterProgress(p, \"shield\");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const buildP = chapterProgress(p, \"build\");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = clock.getElapsedTime();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Dome grows bottom-up during Shield and fades with a shimmer in Build"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const reveal = THREE.MathUtils.smoothstep(shieldP, 0.05, 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const fade = 1 - THREE.MathUtils.smoothstep(buildP, 0.25, 0.78);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const shimmer = buildP > 0.1 && buildP < 0.85 ? buildP : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domeUniforms.uReveal.value = reveal;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domeUniforms.uFade.value = fade;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domeUniforms.uShimmer.value = shimmer;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domeUniforms.uTime.value = t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const active = reveal > 0.02 && fade > 0.02;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (domeRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      domeRef.current.visible = active;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Attack cubes fly in and bounce off the dome during Shield"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (attackMeshRef.current && sparkMeshRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const showAttacks = shieldP > 0.18 && shieldP < 0.98 && fade > 0.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      attackMeshRef.current.visible = showAttacks;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      sparkMeshRef.current.visible = showAttacks;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (showAttacks) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (let i = 0; i < attacks.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const a = attacks[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const cycle = (t * 0.62 + a.phaseOffset) % 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let r = domeRadius;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let scale = 0.42;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let sparkScale = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (cycle < 0.48) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Flying inward"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const k = cycle / 0.48;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            r = THREE.MathUtils.lerp(domeRadius + 14, domeRadius + 0.3, k);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Boing! Bouncing outward and fading"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const k = (cycle - 0.48) / 0.52;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            r = domeRadius + 0.3 + Math.sin(k * Math.PI * 0.5) * 6.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            scale = 0.42 * (1 - k);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            sparkScale = Math.sin(Math.min(1, k * 2.5) * Math.PI) * 0.75;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.position.copy(a.dir).multiplyScalar(r);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.position.y += 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.rotation.set(t * 2 + i, t * 1.5, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.scale.setScalar(Math.max(0.001, scale));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.updateMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          attackMeshRef.current.setMatrixAt(i, _dummy.matrix);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Impact spark on dome surface"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.position.copy(a.dir).multiplyScalar(domeRadius + 0.15);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.position.y += 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.scale.setScalar(Math.max(0.001, sparkScale));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.updateMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          sparkMeshRef.current.setMatrixAt(i, _dummy.matrix);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        attackMeshRef.current.instanceMatrix.needsUpdate = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        sparkMeshRef.current.instanceMatrix.needsUpdate = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    <group>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <mesh ref={domeRef} position={[0, 0.5, 0]}>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <icosahedronGeometry args={[domeRadius, 2]} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <shaderMaterial"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          transparent"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          depthWrite={false}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          side={THREE.DoubleSide}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          uniforms={domeUniforms}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          vertexShader={`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vNormalDir;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vViewDir;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vLocalPos;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vLocalPos = position;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vec4 wp = modelMatrix * vec4(position, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vNormalDir = normalize(mat3(modelMatrix) * normal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vViewDir = normalize(cameraPosition - wp.xyz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              gl_Position = projectionMatrix * viewMatrix * wp;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          `}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          fragmentShader={`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            uniform float uReveal;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            uniform float uFade;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            uniform float uShimmer;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            uniform float uTime;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vNormalDir;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vViewDir;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            varying vec3 vLocalPos;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Hemisphere from base (-2) to top (+domeRadius)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float hNorm = clamp((vLocalPos.y + 3.0) / 19.0, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (vLocalPos.y < -3.0) discard;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float growMask = 1.0 - smoothstep(uReveal - 0.14, uReveal + 0.02, hNorm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (growMask <= 0.01) discard;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float fresnel = pow(1.0 - abs(dot(vNormalDir, vViewDir)), 2.2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Subtle petal-hex cell shimmer"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float cell = sin(vLocalPos.x * 2.2) * cos(vLocalPos.y * 2.2) * sin(vLocalPos.z * 2.2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float shimmerBand = exp(-pow((hNorm - uShimmer) * 7.0, 2.0)) * step(0.01, uShimmer);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vec3 basePink = vec3(1.0, 0.788, 0.839); // #FFC9D6"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vec3 rimPink  = vec3(1.45, 0.62, 0.85);  // Emissive bloom rim"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              vec3 col = mix(basePink, rimPink, clamp(fresnel + shimmerBand * 0.9, 0.0, 1.0));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              float alpha = (0.14 + fresnel * 0.52 + abs(cell) * 0.08 + shimmerBand * 0.45) * growMask * uFade;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              gl_FragColor = vec4(col, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          `}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </mesh>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {/* Red attack particles */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <instancedMesh ref={attackMeshRef} args={[undefined, undefined, attacks.length]}>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <boxGeometry args={[1, 1, 1]} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <meshStandardMaterial color=\"#D94A3A\" emissive=\"#D94A3A\" emissiveIntensity={1.4} roughness={0.4} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </instancedMesh>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {/* Bounce sparks */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <instancedMesh ref={sparkMeshRef} args={[undefined, undefined, attacks.length]}>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <octahedronGeometry args={[0.7, 0]} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <meshBasicMaterial color=\"#FFC75A\" transparent opacity={0.9} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </instancedMesh>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    </group>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Falling cherry petals (instanced curved quads in 3 pinks) + Neighbors fireflies."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function PetalsAndFireflies({ tier }: { tier: QualityTier }) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const petalCount = tier === \"high\" ? 600 : tier === \"medium\" ? 250 : 80;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const fireflyCount = tier === \"low\" ? 18 : 36;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const petalRef = React.useRef<THREE.InstancedMesh | null>(null);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const fireflyRef = React.useRef<THREE.InstancedMesh | null>(null);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const petalSeeds = React.useMemo(() => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return Array.from({ length: petalCount }, (_, i) => ({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      x: ((Math.sin(i * 12.9898) * 43758.5453) % 1) * 28,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      y: Math.abs((Math.sin(i * 78.233) * 19341.123) % 1) * 18 - 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      z: ((Math.sin(i * 45.164) * 29311.71) % 1) * 28,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      speed: 0.7 + (i % 7) * 0.15,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      sway: 0.6 + (i % 5) * 0.25,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      phase: i * 0.73,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      pinkVariant: i % 3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }, [petalCount]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  React.useLayoutEffect(() => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!petalRef.current) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const colors = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      new THREE.Color(\"#FFC9D6\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      new THREE.Color(\"#FF8FAB\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      new THREE.Color(\"#FFF1F4\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i < petalSeeds.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      petalRef.current.setColorAt(i, colors[petalSeeds[i].pinkVariant]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (petalRef.current.instanceColor) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      petalRef.current.instanceColor.needsUpdate = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }, [petalSeeds]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  useFrame(({ clock }) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const p = storyStore.progress;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = clock.getElapsedTime();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Few petals in hero, ramp up in Build/Bloom"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const activeRatio ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      p < 0.1 ? 0.12 : p < 0.5 ? 0.35 : p < 0.86 ? 0.65 : 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const activeCount = Math.max(12, Math.floor(petalCount * activeRatio));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (petalRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < petalCount; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (i >= activeCount) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.scale.setScalar(0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _dummy.updateMatrix();"

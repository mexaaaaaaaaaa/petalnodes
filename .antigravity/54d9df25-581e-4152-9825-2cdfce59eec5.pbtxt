            }
            lines {
              text: "        const leafR = Math.hypot(x - 42, y - 20);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const blossomTop = Math.hypot(x - 32, y - 15);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (blossomTop < 9.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const rim = blossomTop < 5.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rgb = rim || (x + y) % 3 === 0 ? cBlossom100 : cBlossom400;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

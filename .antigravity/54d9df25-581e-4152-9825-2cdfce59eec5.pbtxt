            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const clampedLx = Math.max(16, Math.min(width - 210, lx));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const clampedLy = Math.max(64, Math.min(height - 56, ly));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

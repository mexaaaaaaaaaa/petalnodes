    end_line: 54
    content: "import * as React from \"react\";\nimport { faq, isTodo } from \"@/content\";\nimport {\n  Accordion,\n  AccordionContent,\n  AccordionItem,\n  AccordionTrigger,\n} from \"@/components/ui/accordion\";\nimport { Stamp } from \"@/components/sketch\";\n\nexport function FAQ({\n  filterIds,\n  className,\n}: {\n  filterIds?: number[];\n  className?: string;\n}) {\n  const items = React.useMemo(() => {\n    if (!filterIds || filterIds.length === 0) return faq.items;\n    return filterIds\n      .map((id) => faq.items.find((item) => item.id === id))\n      .filter((item): item is NonNullable<typeof item> => Boolean(item));\n  }, [filterIds]);\n\n  return (\n    <section\n      aria-labelledby=\"faq-heading\"\n      className={className ?? \"mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 md:py-24\"}\n    >\n      <h2\n        id=\"faq-heading\"\n        className=\"font-display-tight text-3xl md:text-4xl text-ink mb-8\"\n      >\n        {faq.heading}\n      </h2>\n\n      <Accordion type=\"single\" collapsible className=\"space-y-3\">\n        {items.map((item) => (\n          <AccordionItem key={item.id} value={`faq-${item.id}`}>\n            <AccordionTrigger>{item.question}</AccordionTrigger>\n            <AccordionContent>\n              <p>{item.answer}</p>\n              {isTodo(item.answer) && (\n                <div className=\"mt-2\">\n                  <Stamp text=\"TODO\" rotation={-3} size=\"sm\" />\n                </div>\n              )}\n            </AccordionContent>\n          </AccordionItem>\n        ))}\n      </Accordion>\n    </section>\n  );\n}\n"
    num_lines: 55
    num_bytes: 1509
    line_range_bytes: 1509
  }
}

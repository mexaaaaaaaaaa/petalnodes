            }
            lines {
              text: "          steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"After ordering one of the five KVM VPS plans (Root through Evergrove), locate your assigned server IPv4 (subject to availability) and root credentials inside billing.petalnodes.cloud.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"Connect from your terminal or SSH client using `ssh root@<your-server-ip>` and update OS packages on first login.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \"Keep firewall rules clean, use SSH keys instead of plain passwords when possible, and confirm DDoS / Cloudflare network settings for exposed web services.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }

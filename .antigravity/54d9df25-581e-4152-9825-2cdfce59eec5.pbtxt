            lines {
              text: "          rgb = r < 13 ? mixRgb(cBlossom200, cBlossomHi, vein * 0.5) : mixRgb(cBlossom400, cBlossom200, vein * 0.4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          h = 0.76 + (1 - r / 24) * 0.12;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rough = 0.72;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else if (y > 38 && Math.abs(dx) < 3) {"

    end_line: 66
    content: "import * as React from \"react\";\nimport * as THREE from \"three\";\nimport { Canvas, useFrame } from \"@react-three/fiber\";\nimport { BLOCK_TYPES, type BlockType } from \"@/three/island/islandGenerator\";\nimport { getBlockMaterial } from \"@/three/island/textures\";\n\nfunction SpinningBlock({ type }: { type: BlockType }) {\n  const meshRef = React.useRef<THREE.Mesh | null>(null);\n  const materials = React.useMemo(() => {\n    const mat = getBlockMaterial(type, \"high\");\n    return mat;\n  }, [type]);\n\n  useFrame((_, delta) => {\n    if (meshRef.current) {\n      meshRef.current.rotation.y += delta * 0.65;\n    }\n  });\n\n  return (\n    <mesh\n      ref={meshRef}\n      rotation={[0.42, 0.65, 0]}\n      material={materials}\n    >\n      <boxGeometry args={[1.35, 1.35, 1.35]} />\n    </mesh>\n  );\n}\n\nexport default function DevTextures() {\n  return (\n    <div className=\"mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-28 pb-20\">\n      <header className=\"mb-10\">\n        <p className=\"font-handwriting text-lg text-blossom-600\">dev preview</p>\n        <h1 className=\"font-display-tight text-4xl text-ink\">\n          64\303\22764 Procedural Block Textures\n        </h1>\n      </header>\n\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6\">\n        {BLOCK_TYPES.map((type: BlockType) => (\n          <div\n            key={type}\n            className=\"border-2 border-ink bg-paper-shade rounded-sm p-3 shadow-[3px_3px_0_var(--color-ink)]\"\n          >\n            <div className=\"h-36 w-full bg-paper border border-ink/20 rounded-sm overflow-hidden\">\n              <Canvas\n                dpr={[1, 1.5]}\n                camera={{ position: [0, 0.25, 3.1], fov: 36 }}\n                gl={{ toneMapping: THREE.ACESFilmicToneMapping }}\n              >\n                <ambientLight intensity={0.65} color=\"#FFF1F4\" />\n                <directionalLight position={[4, 6, 4]} intensity={1.8} color=\"#FFE5B4\" />\n                <SpinningBlock type={type} />\n              </Canvas>\n            </div>\n            <p className=\"mt-2.5 text-center font-pixel text-sm text-ink\">\n              {type}\n            </p>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 67
    num_bytes: 2173
    line_range_bytes: 2173
  }
}

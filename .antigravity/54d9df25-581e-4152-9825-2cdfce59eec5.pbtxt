      thinking_signature: "\022\225\004\n\222\004\001i\024}\023\001\035F,\002\aY\025P\ao\330\312\"\035\023\214\037\343\275\361\252\366\341/c\202T\307\031\264\376g\002\353)\244\365\263\343^B;\207R\f\003\222\370\306\332\r\250\242,\314\350\260\312\206\346u\261\274\222\207r\362Pa\000\244x\222\226\210\2565\376\000\317\023\263\330_\f\237\372F\240\376\rhP\314\343\263c\300-D_m \223\232\264P*\236\203~\260\301z\020v\350S <\237\331\361f\276\246\\\350\275\366;\032\3524\364\004\317H\244\226\370PM\025\213\"\364\244\354oj\243\224\002?\003\226\000\255^\033\250R\315\027,\022\353-\272\356\346\266\314\350\2704\244Z\273q\255\r%U\245\266+\223\264\026\234\213\220\026h\303\341f2\235L 0\310\237\303\250{Q\252\372K\006\021y\337\376\201\306s-%\"+#\032.\"\034\264\242@\303vNs\024\005S\341L\333\027L\316<K\353x\221\335\200M>mp\2113\"\312\372\240\3207aC\270\324O\246\244\201L8\330\004\240+~s\230\331j6%\302\027\240\263\243\373\331\262\2576G\317Q`UIi\273\372U\026\356\221\307\tv\b\027f8)\372\037\\\215W\036\247\030\006c\226T\227\345\264\207\220\306\201\357\251\370\260\302B%\327:\034\302d\3139\004\311_E\300\376\004Z@\273R\311\373\317\263\231\237%\t\320\236\256y\376\331\374\027\372\344\223\026F\320$\005\a\203c\030\360\031\0206h\333\202x\350T#\365\253s\214\237\212\030\300\2155Z\320XWU\316\225\323Na\320m\320\036\n<\204\240\316\357J\236\327\202\335\331{\021\210\002\005\253\323\371P\024\205\353\331\227\224\201B\302\216\310\261\212\371\262\236\347}7\222#\206\0309\a\271\215\302Y\317*\220\215\207+\330f\001T-T\237Fg\207\315\351*c\227\037\344\236\242)\320\271\374\326\357q\272\"]\274\354\255\35000\325\254\356\224D\031\255\357\265"

    content: "{\n  \"name\": \"react-example\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite --port=3000 --host=0.0.0.0\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"clean\": \"rm -rf dist server.js\",\n    \"lint\": \"tsc --noEmit\",\n    \"check:release\": \"tsx scripts/check-release.ts\"\n  },\n  \"dependencies\": {\n    \"@google/genai\": \"^2.4.0\",\n    \"@gsap/react\": \"^2.1.2\",\n    \"@radix-ui/react-accordion\": \"^1.3.1\",\n    \"@radix-ui/react-dialog\": \"^1.3.1\",\n    \"@react-three/drei\": \"^10.7.9\",\n    \"@react-three/fiber\": \"^9.8.2\",\n    \"@react-three/postprocessing\": \"^3.2.2\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"@types/three\": \"^0.187.0\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"clsx\": \"^2.1.1\",\n    \"dotenv\": \"^17.2.3\",\n    \"express\": \"^4.21.2\",\n    \"gsap\": \"^3.15.1\",\n    \"lenis\": \"^1.3.27\",\n    \"lucide-react\": \"^0.546.0\",\n    \"motion\": \"^12.23.24\",\n    \"n8ao\": \"^2.1.0\",\n    \"postprocessing\": \"^6.39.6\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"react-router-dom\": \"^7.18.6\",\n    \"roughjs\": \"^4.6.6\",\n    \"tailwind-merge\": \"^3.7.1\",\n    \"three\": \"^0.187.0\",\n    \"vite\": \"^8.3.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.14.0\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.25.0\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"^7.0.2\",\n    \"@types/express\": \"^4.17.21\"\n  }\n}\n"

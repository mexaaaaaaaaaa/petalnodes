  code_action {
    action_spec {
      create_file {
        instruction: "import * as React from \"react\";\nimport {\n  generateRoughCirclePaths,\n  generateRoughUnderlinePaths,\n} from \"@/lib/roughPaths\";\nimport { gsap, useGSAP } from \"@/lib/gsap\";\nimport { useReducedMotion } from \"@/app/QualityProvider\";\nimport { cn } from \"@/lib/utils\";\n\nexport function RoughUnderline({\n  children,\n  seed = 19,\n  drawIn = true,\n  className,\n}: {\n  children: React.ReactNode;\n  seed?: number;\n  drawIn?: boolean;\n  className?: string;\n}) {\n  const wrapRef = React.useRef<HTMLSpanElement | null>(null);\n  const svgRef = React.useRef<SVGSVGElement | null>(null);\n  const reducedMotion = useReducedMotion();\n\n  const paths = React.useMemo(\n    () =>\n      generateRoughUnderlinePaths({\n        width: 140,\n        y: 8,\n        seed,\n        stroke: \"#E2557B\",\n        strokeWidth: 3.4,\n      }),\n    [seed],\n  );\n\n  useGSAP(\n    () => {\n      if (!drawIn || reducedMotion || !svgRef.current) return;\n      const strokes = svgRef.current.querySelectorAll(\"path\");\n      gsap.fromTo(\n        strokes,\n        { drawSVG: \"0%\" },\n        {\n          drawSVG: \"100%\",\n          duration: 0.6,\n          stagger: 0.12,\n          ease: \"power2.inOut\",\n          scrollTrigger: {\n            trigger: wrapRef.current,\n            start: \"top 92%\",\n            once: true,\n          },\n        },\n      );\n    },\n    { scope: wrapRef, dependencies: [drawIn, reducedMotion] },\n  );\n\n  return (\n    <span ref={wrapRef} className={cn(\"relative inline-block whitespace-nowrap\", className)}>\n      <span className=\"relative z-10\">{children}</span>\n      <svg\n        ref={svgRef}\n        aria-hidden=\"true\"\n        viewBox=\"0 0 140 16\"\n        preserveAspectRatio=\"none\"\n        className=\"pointer-events-none absolute -bottom-1.5 left-0 h-3.5 w-full overflow-visible\"\n      >\n        {paths.map((p, idx) => (\n          <path\n            key={idx}\n            d={p.d}\n            stroke={p.stroke}\n            strokeWidth={p.strokeWidth}\n            strokeLinecap=\"round\"\n            fill=\"none\"\n          />\n        ))}\n      </svg>\n    </span>\n  );\n}\n\nexport function RoughCircle({\n  children,\n  seed = 23,\n  drawIn = true,\n  className,\n}: {\n  children: React.ReactNode;\n  seed?: number;\n  drawIn?: boolean;\n  className?: string;\n}) {\n  const wrapRef = React.useRef<HTMLSpanElement | null>(null);\n  const svgRef = React.useRef<SVGSVGElement | null>(null);\n  const reducedMotion = useReducedMotion();\n\n  const paths = React.useMemo(\n    () =>\n      generateRoughCirclePaths({\n        cx: 60,\n        cy: 26,\n        width: 112,\n        height: 44,\n        seed,\n        stroke: \"#E2557B\",\n        strokeWidth: 2.6,\n      }),\n    [seed],\n  );\n\n  useGSAP(\n    () => {\n      if (!drawIn || reducedMotion || !svgRef.current) return;\n      const strokes = svgRef.current.querySelectorAll(\"path\");\n      gsap.fromTo(\n        strokes,\n        { drawSVG: \"0%\" },\n        {\n          drawSVG: \"100%\",\n          duration: 0.65,\n          ease: \"power2.inOut\",\n          scrollTrigger: {\n            trigger: wrapRef.current,\n            start: \"top 92%\",\n            once: true,\n          },\n        },\n      );\n    },\n    { scope: wrapRef, dependencies: [drawIn, reducedMotion] },\n  );\n\n  return (\n    <span ref={wrapRef} className={cn(\"relative inline-block px-1.5 whitespace-nowrap\", className)}>\n      <span className=\"relative z-10\">{children}</span>\n      <svg\n        ref={svgRef}\n        aria-hidden=\"true\"\n        viewBox=\"0 0 120 52\"\n        preserveAspectRatio=\"none\"\n        className=\"pointer-events-none absolute -inset-x-1.5 -inset-y-1 h-[calc(100%+8px)] w-[calc(100%+12px)] overflow-visible\"\n      >\n        {paths.map((p, idx) => (\n          <path\n            key={idx}\n            d={p.d}\n            stroke={p.stroke}\n            strokeWidth={p.strokeWidth}\n            strokeLinecap=\"round\"\n            fill=\"none\"\n          />\n        ))}\n      </svg>\n    </span>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/sketch/RoughHighlight.tsx"
        }
        overwrite: true
      }
    }

            }
            lines {
              text: "        body: \"These Terms of Service govern access to Petalnodes websites (petalnodes.cloud), billing systems (billing.petalnodes.cloud), game panel (panel.petalnodes.cloud), Minecraft hosting, VPS hosting, and community reward services.\","

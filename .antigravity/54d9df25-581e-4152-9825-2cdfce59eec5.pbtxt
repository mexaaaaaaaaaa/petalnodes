            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function deriveCavityAoFromHeight(height: Float32Array): Uint8Array {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const out = new Uint8Array(SIZE * SIZE * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  for (let i = 0; i < SIZE * SIZE; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const h = height[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = clamp01((h - 0.08) / 0.48);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const smooth = t * t * (3 - 2 * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ao = clampByte((0.22 + 0.78 * smooth) * 255);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const p4 = i * 4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out[p4] = ao;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out[p4 + 1] = ao;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out[p4 + 2] = ao;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

    combined_output {
      full: "Unknown option: --viewport-sizeplaywright-cli open [url]Open the browserArguments:  [url]                       the url to navigate toOptions:  --browser                   browser or chrome channel to use, possible values: chrome, firefox, webkit, msedge.  --config                    path to the configuration file, defaults to .playwright/cli.config.json  --device                    emulate a specific device, for example \"iphone 15\".  --headed                    run browser in headed mode  --idle-timeout              shut the session down after this many milliseconds without a command. defaults to one hour for headless browsers, never for headed ones. pass 0 to disable.  --mobile                    emulate a generic mobile device (pixel 10 for chromium, iphone 17 for webkit). mobile pages are usually lighter, which saves tokens.  --persistent                use persistent browser profile  --profile                   path to a persistent user data directory."
    }
    command_line: "mkdir -p /tmp/petalnode-verify && bash -c \'\nset -euo pipefail\ntrap \"playwright-cli close >/dev/null 2>&1 || true\" EXIT\n\nplaywright-cli open \"http://localhost:3000/\" --viewport-size=1440x900\nsleep 3\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/home-hero.png\n\n# Scroll to Roots (~18% of 5*900 = 810px), Shield (~1665px), Build (~2520px), Neighbors (~3420px), Bloom (~4275px)\nplaywright-cli eval \"window.scrollTo(0, 820)\"\nsleep 1.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/story-roots.png\n\nplaywright-cli eval \"window.scrollTo(0, 1680)\"\nsleep 1.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/story-shield.png\n\nplaywright-cli eval \"window.scrollTo(0, 2550)\"\nsleep 1.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/story-build.png\n\nplaywright-cli eval \"window.scrollTo(0, 3440)\"\nsleep 1.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/story-neighbors.png\n\nplaywright-cli eval \"window.scrollTo(0, 4280)\"\nsleep 1.5\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/story-bloom.png\n\n# Scroll past pinned story to PlansHighlight, TrustStrip, FAQ, Footer\nplaywright-cli eval \"document.getElementById(\\\"plans-highlight\\\")?.scrollIntoView()\"\nsleep 0.8\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/home-plans.png\n\n# Click FAQ #1 and Footer crew\nplaywright-cli eval \"document.querySelector(\\\"#faq-heading\\\")?.scrollIntoView()\"\nsleep 0.6\nplaywright-cli eval \"document.querySelector(\\\"[data-radix-collection-item]\\\")?.click()\"\nsleep 0.4\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/home-faq.png\n\nplaywright-cli eval \"document.querySelector(\\\"footer\\\")?.scrollIntoView()\"\nsleep 1.2\nplaywright-cli eval \"document.querySelector(\\\"footer .dcf-hit\\\")?.dispatchEvent(new MouseEvent(\\\"click\\\", { bubbles: true }))\"\nsleep 0.4\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/home-footer.png\n\n# Check Plans page\nplaywright-cli goto \"http://localhost:3000/plans\"\nsleep 1.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/plans-desktop.png\n\n# Check 404 page\nplaywright-cli goto \"http://localhost:3000/missing-page\"\nsleep 0.8\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/not-found.png\n\n# Check static fallback mode\nplaywright-cli goto \"http://localhost:3000/?static=1\"\nsleep 0.8\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/home-static.png\n\n# Check mobile 390x844\nplaywright-cli open \"http://localhost:3000/\" --viewport-size=390x844\nsleep 2.2\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/mobile-hero.png\nplaywright-cli eval \"document.querySelector(\\\"button[aria-label=\\\\\\\"Open menu\\\\\\\"]\\\")?.click()\"\nsleep 0.5\nplaywright-cli screenshot --filename=/tmp/petalnode-verify/mobile-menu.png\n\n# Collect console errors & DOM checks\nplaywright-cli console\n\'"

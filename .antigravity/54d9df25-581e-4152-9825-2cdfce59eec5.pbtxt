            }
            lines {
              text: " * Pure deterministic island layout and reveal schedule."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - sizeFactor = 1 produces ~4,500\342\200\2235,200 blocks (within 4,000\342\200\2236,000 budget)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - sizeFactor = 0.6 produces ~60% of that (~2,700\342\200\2233,100 blocks)."

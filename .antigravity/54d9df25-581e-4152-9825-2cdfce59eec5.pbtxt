      thinking_signature: "\022\302\027\n\277\027\001i\024}\023\226wNr\371\270\342\'\243\262\311\2620\227\332\326\260D\275iF\264\346\257Q\327c\360\t\303\003V$\271\226\3554d\261\331p\275\365\354\331\347Ibo\272\357\312\016\206\230wS\277\307\202\016\307\2223\217\253\021q9\367\255\250\263\271\310\300\261\255\222G\225\371\246\343`(\324X\231p<\230\314\316\353`\017\216\016\240\3239\005\365\017\221M\307\247V\177NM\177#8/\023-\2504w2\373;\345\367^\331B\321A\356\255S1\237]\263\032k\211c\260\037\252\364\214+\327R\327\331\205\206\326k\"\376\036d\032\027\327$\302\024|\360\v\243\204\302\227\315!\035&\002\274b\023\304\257\324\367\333\330\322\245\223M\327p\342\025\213\344\031\213\213u\364\204R\230f\341\203\360\031\235\337d\037\017p\226U\234\377>\243\244b\223\250z\036\005\312\332\373\034\332\206h\2221V*\312I\"\377\305\203\240\374\215\256\315\230\275I#Eu\216\375\016n\a\357\326\270-\034ET\027!,:yS\351I\203\202\351\241n\033\245\341`FE\371\310\317\355\247_\265\212\232\356\033X\3269\312.\372\323d\305\372\225V\352\3116\260\370\005\224\304\341\2204\335\202\346r4\302\333I#d\025Zj\3132\354\256\376\344\331,m\205xrTZ|\361\217\342p\033\340\352\324\324M\315\340c-\261\330\361\333\261\333\240\252\002_!\352\277\364\000\2147\301\340\002Ar\322;\037a\366\313\341\3322j\327!^\343\346\226\030\366\376\370\ta\201\2457\3608\260\255\023w\211e\177):\003g\237\204\034\027pr\\~k\311\271\017\232\255sp\004\252\316y\377\032Yc\303Gm\303,\211\335\257\316\355\260\214gD0\322\240\320d\r\005\271\222\365\245p}a\327+n\264\212\344[\233\2170I\033\272\330\021\265\216\347dAf$\240\031T-\t\002\026\366\276\302D{u*-m\036\026\234;\233\224+\262\230\243\372\215!\006\216\005\025\274\322C\r^\3668\371X[a\305\201\330\306\027\320\261I\037\274\266\375;\235\264\257\301\272\0007\325\r\330\ro\263\214\306s\362\276Gc\342\207\034\036?ozZ\367^v\330\367\336\307\ad\021\336ik\222\302\003\277\216\006v\270%\342\340\342\254\363&\210\353aQ\220\336\267t\360<r\343\3567\3244 D46o/p\300\314h\002\034\r\250\237w\321\344\335\242\314a\333,A\342K\v_c4l\244[\224]\254\256\265\243\277\330\"\316\324e?\254\234\361\347@\207e=P\323\213\212\300d\376\370\357\347WJ\272%\341\005L\325\000\324\365\240\343\277\312\377\037\027\032\251\005\314\261\261\347\"\0231sO\344\271\305\023\223M\261i(\241\325\r\207\035\300\020[CNn\352\003\276\020\036\216\351\363\033\231D\273\364\371\377H\2460\370\020\210\017\213N\354e~Y\323\310\376\336\r\314!\216\253@d*b~\317\306>\330Y\201\215\350]J66\220%b\363\205\302&\a\360R\301Q\267\301\234\210\362}\236\346\215\347\265\031\236\027\032\270\331\354\201o{\246\326\306\3420\361\001B\033\350;\200\234\371\330\363\'%\256\325e,\242Q\377b\026\201\177E\202\335\037D\362-\341\224\004kWd\006]\232;\240\0201\306\357\213\370\247\312\316m\274\317}}@\016!$\333T\263\"M\271\v\330\356\264Rr\217\v\261\036\023\350_\236\177_iDR3\246f\350\373\364!H&#\347\033pw\337\213\202\n<\023K\303]L\202K\337\372\230\277\204n\\\'\026\rp\244%|\3059\302zM\0000SU\r\346\016o%^D3h\311\361\351\310\326&E\226\a\bE}GT\264\332\334\n\002V\264\316j2\321+\243\343x\030\313V.b<\002\371\310%\024\212\327I^\032\267\376e\246\302>H\351\332\363a\'\325\347\243\355 \3724\254HW\220<(\fE\217q\214\353ZD\0054\273x\301aY\335NLdo\003\023\236\332\313\343\232&N\220\220\374\200wx\023\'f\206\234\357}o\267!\266]RT\237\330\336\005\031\366V\350\022J\036\022p\252|R\226\212\314\\\215\353v]+\0016qV\233\177\0017c\316\355\026P\311{\236yb\216\333\265\257s\327h\346\031\3364N\030\177AJ\254\232\001\347r\324\377\2733\221V\"\341\310\376\252\335\237\316)\321X\256`\206h\246T\327\351b\324\217\277Y\306\326z$\323\2441s\035\f;\034\357V/{\213\257\207\226T\362^A\316\347h\241\305W\365;\030\304\252ov\250q\351\375\234\227g\263\3738\334$k\307\220&\231\334<\353\021\212\236,\323}\246\371\342\275H\247\225\331\211v\354\024\260\275s;\246\272\3360c\\\313\377\312\376\355*q\272\027\376e\263n\324{\352\275\000\252\244\256\311<4XB\265(g!\321\353e\313\001`V_\231\343\001\202\344\274a\237\345<\275B\005L\244\366\324\245\372|\264\243\326)\236\314\212\357\310a\b\246\361B`\241\204;4\203\263\037|\301\346\365\224*\301-Zy\377)\220\216\336\316\231>\274\313\247\a\222%1\376j\031\345\371/*H\326\224\267\247\341\374S\a{[2RR\316\265\200\351\304\331t\243\002\224\221\265\373y\316d{\367\220\036S\f \226L\265On\f\220\032\264\252Aw}5\2246\035\367C\255W\v%\001\340B\276-Q\204D\230\025e\331\t\022\322\001\033Q\305\372\345\305\272C\272,`\370\342\fwG\275m\t\331\253s=\355\336[\322.\217\377(7S\355P\330\373\003\263\324Kw\366i\021;\206\236l\235z\256\261\350\257\263\206\374\253Q\000XV\230,\377z!^\017\023\364S\211RP\303\307?\276\211t\257\204*\022F3\001D\027w$\256\276hc\006\320\327\225n\n\312\204\241\352\211\352\vO+\370\262Gd\373ey\320\241\235\201\200hg\251\231\241\213_a\235\22596\314\275l\001i\211=\251i\2278q\022\202\024\254`\331\242=r\332\307r\211\363\265_l\v\314\252}\017\360fe#b\273\257\371\323\000z\337\307\322Z\315\266\200CV\251\354rx\361L\035CA\212(%\374[\227xm\'\244\'\bD\277\352\242\224\246xg\017\262\230v{\037j\242z\235^\311\303\260\375\177\271\003A\354\033\301\367\343\246\277\017H\320\372iS\253\325\202\311\346\036\005n\026\016\022\205\326YQ\304\311H-\363d2\231\342\000]E\242\312\244\264\225\267Q\023U>(\n\v\240&\356}\320\254\213\225b\200`\243hs}\255j@\270\004`\225-\216\005\377\366\031\24676\330k\236\372h\333\"K\2405\'\031\363\267b\235\272-\351`%\366pBJ\272\332\2151\2354;c\334\256\203Kt\352b\206\275\222\f\b \030\220\017k\353\211\023\276n\006\351\004\200\266\026\005G\234\235\257\312!$\262\037\264D\r\307\022\002\216\313\315+_n\\\250\212\323\222\b`\203\177\366\333\023VbeH&\315qht\305\274~ \312\362\036\325\205Tn\3205g\255\341w\2445:q\214q\331@\v\312v\333C\220\221\366\374\314a^\362\302\255\017\243B\276\321\237 \026\000@\213R\342\305\366?\260\3349nB 0\"\331?i\"f\244m\303*\2030\260C\207\2103I\204\204\364\263F\333\323\210wgc\n\225=\301\177\330\366\036\330\243Bv\327r\250a\231G\377\273B\241\351,\320\264v\220\274\307\253g!~\263\245\377P\336\211\325\340\261\002k\353WEc\352FU\354\255\230\324\221\006\236;\362\016P\'\321\352\273$\333\237_\v\334\003\350\231\202\255\276\0061\v!\330j\303\374)\031C\357\1772X\030i\211\262\310\376^\22
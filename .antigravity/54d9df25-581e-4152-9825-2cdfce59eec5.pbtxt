    end_line: 491
    content: "export interface LocationInfo {\n  id: \"sg\" | \"miami\" | \"in\";\n  code: string;\n  city: string;\n  country: string;\n  regionLabel: string;\n  pinX: number;\n  pinY: number;\n  services: string[];\n  summary: string;\n}\n\nexport const locationsPage = {\n  eyebrow: \"global regions\",\n  heading: \"Three regions, one cozy network.\",\n  highlightWord: \"regions\",\n  sub: \"Petalnodes operates Minecraft and VPS infrastructure across Singapore, Miami, and India so friends and communities can host closer to home.\",\n  infraHeading: \"Infrastructure across our network\",\n  infraNote:\n    \"Our network uses AMD Ryzen and Intel Xeon Gold processors with DDR5 memory, NVMe storage, Cloudflare protection, and DDoS protection. Specific CPU models and node hardware vary by location and availability.\",\n  infraBadges: [\n    \"AMD Ryzen Processors\",\n    \"Intel Xeon Gold Processors\",\n    \"DDR5 Memory\",\n    \"NVMe Storage\",\n    \"Cloudflare Protection\",\n    \"DDoS Protection\",\n  ],\n  locations: [\n    {\n      id: \"miami\",\n      code: \"USA\",\n      city: \"Miami\",\n      country: \"United States\",\n      regionLabel: \"North America East\",\n      pinX: 146,\n      pinY: 132,\n      services: [\"Minecraft Hosting\", \"VPS Infrastructure\"],\n      summary:\n        \"Available for players across North America, Central America, and South America.\",\n    },\n    {\n      id: \"in\",\n      code: \"IN\",\n      city: \"India\",\n      country: \"India\",\n      regionLabel: \"South Asia\",\n      pinX: 356,\n      pinY: 140,\n      services: [\"Minecraft Hosting\", \"VPS Infrastructure\"],\n      summary:\n        \"Available for Indian and neighboring South Asian communities.\",\n    },\n    {\n      id: \"sg\",\n      code: \"SG\",\n      city: \"Singapore\",\n      country: \"Singapore\",\n      regionLabel: \"Southeast Asia\",\n      pinX: 396,\n      pinY: 170,\n      services: [\"Minecraft Hosting\", \"VPS Infrastructure\"],\n      summary:\n        \"Available for players across Southeast Asia and nearby Asia-Pacific regions.\",\n    },\n  ] as LocationInfo[],\n  missingSpecsTodo:\n    \"TODO: add verified network speeds or routing notes only after owner confirmation\",\n};\n\nexport interface DocArticle {\n  id: string;\n  title: string;\n  summary: string;\n  steps: string[];\n  note?: string;\n}\n\nexport interface DocCategory {\n  id: string;\n  title: string;\n  description: string;\n  articles: DocArticle[];\n}\n\nexport const docsPage = {\n  eyebrow: \"knowledge base\",\n  heading: \"How everything works.\",\n  highlightWord: \"everything\",\n  sub: \"Step-by-step guides for setting up your server, picking Paper, Purpur, or Fabric, managing backups, and using your Petalnodes account.\",\n  categories: [\n    {\n      id: \"getting-started\",\n      title: \"Getting Started\",\n      description: \"From ordering at billing.petalnodes.cloud to opening panel.petalnodes.cloud.\",\n      articles: [\n        {\n          id: \"order-to-panel\",\n          title: \"Accessing your billing area and Game Panel\",\n          summary: \"Where to manage your subscription and launch your server.\",\n          steps: [\n            \"Complete your plan checkout or reward claim through the Client Area at billing.petalnodes.cloud or via Discord.\",\n            \"Log in to the Game Panel at panel.petalnodes.cloud to view your provisioned server.\",\n            \"Confirm your server region (Singapore, Miami, or India) and start your instance from the console view.\",\n          ],\n        },\n        {\n          id: \"allocations-databases\",\n          title: \"Using your 2 allocations and 2 database slots\",\n          summary: \"Every Minecraft plan includes 2 network allocations and 2 databases.\",\n          steps: [\n            \"Your primary allocation serves the main Minecraft port for players.\",\n            \"Use your second allocation when configuring crossplay plugins or companion listeners.\",\n            \"Create up to 2 databases inside the Databases tab on the Game Panel for plugins that store player or economy data.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"minecraft-setup\",\n      title: \"Minecraft Server Setup\",\n      description: \"First boot, EULA acceptance, world creation, and joining.\",\n      articles: [\n        {\n          id: \"first-boot\",\n          title: \"Starting your Minecraft world for the first time\",\n          summary: \"Launch your server cleanly and copy your connection address.\",\n          steps: [\n            \"Open your server in panel.petalnodes.cloud and choose your server software (Paper, Purpur, or Fabric).\",\n            \"Start the server and accept the Minecraft EULA prompt when requested in the panel.\",\n            \"Copy the IP and port from your primary allocation and add the server in Minecraft.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"java-bedrock\",\n      title: \"Java & Bedrock\",\n      description: \"Confirmed support for both Java Edition and Bedrock Edition worlds.\",\n      articles: [\n        {\n          id: \"editions-overview\",\n          title: \"Java & Bedrock compatibility\",\n          summary: \"Both paid Minecraft plans and Bloom Boost Rewards include Java & Bedrock support.\",\n          steps: [\n            \"Java Edition players connect directly using your primary server address.\",\n            \"Bedrock Edition support is included on Minecraft hosting plans and Bloom boost reward tiers.\",\n            \"Keep your secondary allocation available when setting up crossplay port listeners.\",\n          ],\n          note: \"TODO: add exact Geyser/Bedrock port instructions once confirmed with owner.\",\n        },\n      ],\n    },\n    {\n      id: \"server-software\",\n      title: \"Server Software\",\n      description: \"Confirmed engines supported on Petalnodes Minecraft plans.\",\n      articles: [\n        {\n          id: \"paper-purpur-fabric\",\n          title: \"Choosing between Paper, Purpur, and Fabric\",\n          summary: \"Only verified software options are listed here.\",\n          steps: [\n            \"Paper: fast Bukkit/Spigot-compatible engine suited for multiplayer SMPs and plugins.\",\n            \"Purpur: Paper fork adding gameplay and configuration toggles while staying compatible with Paper plugins.\",\n            \"Fabric: lightweight modular loader suited for Fabric-compatible server mods.\",\n          ],\n          note: \"TODO: confirm whether Forge, NeoForge, or Velocity should be added.\",\n        },\n      ],\n    },\n    {\n      id: \"plugins-and-mods\",\n      title: \"Plugins and Mods\",\n      description: \"Installing plugins on Paper/Purpur or mods on Fabric safely.\",\n      articles: [\n        {\n          id: \"installing-plugins-mods\",\n          title: \"Uploading plugins (.jar) and Fabric mods\",\n          summary: \"Use the File Manager inside panel.petalnodes.cloud.\",\n          steps: [\n            \"Stop your server safely before adding or removing jar files.\",\n            \"Open File Management in panel.petalnodes.cloud and navigate to /plugins (Paper/Purpur) or /mods (Fabric).\",\n            \"Upload jars matching your exact Minecraft version and restart the server, watching Console for errors.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"file-management\",\n      title: \"File Management\",\n      description: \"Uploading worlds, editing configs, and organizing directories.\",\n      articles: [\n        {\n          id: \"managing-files\",\n          title: \"Using the built-in panel file manager\",\n          summary: \"Edit YAML/properties files and upload world archives directly in your browser.\",\n          steps: [\n            \"Open the Files tab inside panel.petalnodes.cloud to browse server directories.\",\n            \"Edit configuration files like server.properties or bukkit.yml directly in the web editor.\",\n            \"Compress large world folders before uploading and extract them inside the root directory.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"backups\",\n      title: \"Backups\",\n      description: \"Daily Backups Included on Minecraft and VPS plans.\",\n      articles: [\n        {\n          id: \"daily-backups\",\n          title: \"Creating and restoring daily backups\",\n          summary: \"Daily backups are included across active Minecraft and VPS tiers.\",\n          steps: [\n            \"Open the Backups section on the Game Panel before major plugin or world updates.\",\n            \"Verify your latest daily backup snapshot is listed prior to making changes.\",\n            \"Restore directly from a snapshot if a config change or world edit goes wrong.\",\n          ],\n          note: \"TODO: document exact backup retention days and slot limit once confirmed.\",\n        },\n      ],\n    },\n    {\n      id: \"server-configuration\",\n      title: \"Server Configuration\",\n      description: \"Essential settings for smooth multiplayer worlds.\",\n      articles: [\n        {\n          id: \"whitelist-operators\",\n          title: \"Enabling whitelist and operator permissions\",\n          summary: \"Protect private worlds for you and your friends.\",\n          steps: [\n            \"In server.properties, set white-list=true or run `whitelist on` in the panel console.\",\n            \"Add friend usernames with `whitelist add <username>`.\",\n            \"Grant admin permissions only to trusted players via `op <username>`.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"troubleshooting\",\n      title: \"Troubleshooting\",\n      description: \"Quick diagnostics using Console, Status, and Discord support.\",\n      articles: [\n        {\n          id: \"server-wont-start\",\n          title: \"When a server fails to boot after changes\",\n          summary: \"Check startup logs, software versions, and status.petalnodes.cloud.\",\n          steps: [\n            \"Inspect the Console output in panel.petalnodes.cloud for plugin/mod version mismatch messages.\",\n            \"Check https://status.petalnodes.cloud to verify regional node health (Singapore, Miami, India).\",\n            \"Join Discord (discord.gg/GS3wuc4HGk) or open a Client Area ticket if an issue persists.\",\n          ],\n        },\n      ],\n    },\n    {\n      id: \"billing-account\",\n      title: \"Billing and Account Help\",\n      description: \"Invoices, client area tickets, Free Rewards, and Boost Rewards.\",\n      articles: [\n        {\n          id: \"client-area-rewards\",\n          title: \"Managing billing and claiming Discord rewards\",\n          summary: \"Use billing.petalnodes.cloud for paid plans and Discord tickets for Petal / Bloom rewards.\",\n          steps: [\n            \"Manage paid Minecraft and VPS services, invoices, and upgrades at billing.petalnodes.cloud.\",\n            \"To claim Petal Free Server Rewards (6\342\200\22330 invites) or Bloom Boost Rewards (1\342\200\2234 active boosts), open a Discord Support Ticket.\",\n            \"Remember that Bloom rewards require active server boosts to remain active, and invite rewards follow posted leave/rejoin/alt rules.\",\n          ],\n        },\n      ],\n    },\n  ] as DocCategory[],\n};\n\nexport const modpacksPage = {\n  eyebrow: \"server software & modpacks\",\n  heading: \"Built for Paper, Purpur, and Fabric.\",\n  highlightWord: \"Fabric\",\n  sub: \"Run multiplayer SMPs with plugins or upload your own Fabric modpack setup using your Game Panel and NVMe storage.\",\n  verifiedSoftware: [\n    {\n      name: \"Paper\",\n      role: \"High-performance plugin server\",\n      detail:\n        \"Ideal for survival worlds, communities, and Spigot/Paper plugin setups.\",\n    },\n    {\n      name: \"Purpur\",\n      role: \"Customizable Paper drop-in\",\n      detail:\n        \"Adds deep gameplay and entity behavior toggles while keeping full Paper plugin compatibility.\",\n    },\n    {\n      name: \"Fabric\",\n      role: \"Lightweight modded loader\",\n      detail:\n        \"Great for server-side optimization mods and curated Fabric modpack environments.\",\n    },\n  ],\n  workflowSteps: [\n    {\n      step: \"01\",\n      title: \"Pick your Cherry Blossom tier\",\n      detail:\n        \"Vanilla and light plugin worlds fit comfortably on Seed through Sapling, while heavier modded worlds can scale up to Grove, Orchard, or Sakura (up to 24GB RAM).\",\n    },\n    {\n      step: \"02\",\n      title: \"Select Paper, Purpur, or Fabric\",\n      detail:\n        \"Choose a confirmed server engine in panel.petalnodes.cloud with Java & Bedrock support and 2 database slots ready.\",\n    },\n    {\n      step: \"03\",\n      title: \"Upload mods or packs via File Manager\",\n      detail:\n        \"Upload your curated mods, configs, and custom world files directly into your server directory on NVMe storage.\",\n    },\n  ],\n  catalogNotice:\n    \"TODO: confirm pre-installed modpack catalog and Forge/NeoForge support before adding specific named modpacks.\",\n};\n\nexport const aboutPage = {\n  eyebrow: \"about petalnodes\",\n  heading: \"Hosting grown with care, not bloat.\",\n  highlightWord: \"care\",\n  intro:\n    \"Petalnodes is built around a simple promise: fast hardware, honest specifications, always-on protection, and real humans ready on Discord when your server needs a hand.\",\n  pillars: [\n    {\n      title: \"Honest infrastructure\",\n      body: \"Our nodes run on AMD Ryzen and Intel Xeon Gold processors, DDR5 memory, and NVMe storage across Singapore, Miami, and India \342\200\224 protected by DDoS mitigation and Cloudflare.\",\n    },\n    {\n      title: \"Community first\",\n      body: \"From \342\202\27159/mo Seed worlds to free Petal invite servers and Bloom Discord boost rewards, we build room for friend groups and growing communities alike.\",\n    },\n    {\n      title: \"Friendly panel & root VPS access\",\n      body: \"Manage Minecraft worlds cleanly at panel.petalnodes.cloud with daily backups included, or deploy full-root KVM Linux instances on our Cherry Blossom VPS tiers.\",\n    },\n  ],\n  ownerDetailsTodo:\n    \"TODO: confirm founding story, team members, and registered business details with owner.\",\n};\n\nexport const contactPage = {\n  eyebrow: \"contact & support\",\n  heading: \"Talk to real humans.\",\n  highlightWord: \"humans\",\n  sub: \"Whether you have a pre-sales question, need help configuring a world, or want to claim a Discord reward, reach us through our verified support channels.\",\n  channels: [\n    {\n      id: \"discord\",\n      title: \"Discord Community & Tickets\",\n      description:\n        \"Fastest way to reach the team, ask pre-sales questions, or claim Petal Free Server & Bloom Boost rewards.\",\n      ctaLabel: \"Join Discord Server\",\n      hrefKey: \"discord\" as const,\n      stamp: \"ACTIVE\",\n    },\n    {\n      id: \"billing\",\n      title: \"Client Area & Billing Tickets\",\n      description:\n        \"Open an account or billing ticket, manage invoices, and access your services at billing.petalnodes.cloud.\",\n      ctaLabel: \"Open Client Area\",\n      hrefKey: \"clientArea\" as const,\n      stamp: \"VERIFIED\",\n    },\n    {\n      id: \"panel\",\n      title: \"Game Panel & Status\",\n      description:\n        \"Control running Minecraft servers at panel.petalnodes.cloud or check live uptime notices at status.petalnodes.cloud.\",\n      ctaLabel: \"Open Game Panel\",\n      hrefKey: \"gamePanel\" as const,\n      stamp: \"LIVE\",\n    },\n  ],\n  emailTodo: \"TODO: official support email address (ask owner before publishing)\",\n  hoursTodo: \"TODO: typical support response window (ask owner before publishing)\",\n};\n\nexport interface LegalSection {\n  title: string;\n  body: string;\n  todoMarker?: string;\n}\n\nexport interface LegalDocument {\n  id: \"terms\" | \"privacy\" | \"sla\";\n  eyebrow: string;\n  heading: string;\n  lastUpdated: string;\n  draftNotice: string;\n  sections: LegalSection[];\n}\n\nexport const legalDocs: Record<\"terms\" | \"privacy\" | \"sla\", LegalDocument> = {\n  terms: {\n    id: \"terms\",\n    eyebrow: \"legal draft \302\267 pending approval\",\n    heading: \"Terms of Service (Draft)\",\n    lastUpdated: \"TODO: effective date\",\n    draftNotice:\n      \"INITIAL DRAFT FOR OWNER REVIEW \342\200\224 Business registration details, refund eligibility window, billing rules, and governing jurisdiction are marked TODO until explicitly approved.\",\n    sections: [\n      {\n        title: \"1. Service Scope & Operator\",\n        body: \"These Terms of Service govern access to Petalnodes websites (petalnodes.cloud), billing systems (billing.petalnodes.cloud), game panel (panel.petalnodes.cloud), Minecraft hosting, VPS hosting, and community reward services.\",\n        todoMarker: \"TODO: legal entity name, registered address, and contact email\",\n      },\n      {\n        title: \"2. Acceptable Use & Compliance\",\n        body: \"Customers agree to use Petalnodes servers lawfully and in accordance with applicable Minecraft EULA guidelines (Not an official Minecraft product; not approved by or associated with Mojang or Microsoft). Abusive traffic generation, unauthorized scanning, or service disruption is prohibited.\",\n      },\n      {\n        title: \"3. Billing, Renewals & Refunds\",\n        body: \"Plan pricing is displayed in INR (\342\202\271) per month on petalnodes.cloud and managed via billing.petalnodes.cloud. Unpaid invoices may result in service suspension.\",\n        todoMarker: \"TODO: owner-approved refund policy, cancellation window, and chargeback terms\",\n      },\n      {\n        title: \"4. Free & Boost Reward Tiers\",\n        body: \"Petal invite servers and Bloom Discord boost reward servers are claimed via Discord Support Tickets. Free invite rewards remain subject to invite-integrity rules (Member Leave \342\210\2222, Rejoin \342\210\2221, Fake/Alt \342\210\2222, Mass Ping Invite Reset). Bloom boost rewards require active boosts to be maintained.\",\n      },\n      {\n        title: \"5. Governing Law\",\n        body: \"Disputes, venue, and governing jurisdiction will be finalized upon legal review.\",\n        todoMarker: \"TODO: governing country/state jurisdiction\",\n      },\n    ],\n  },\n  privacy: {\n    id: \"privacy\",\n    eyebrow: \"legal draft \302\267 pending approval\",\n    heading: \"Privacy Policy (Draft)\",\n    lastUpdated: \"TODO: effective date\",\n    draftNotice:\n      \"INITIAL DRAFT FOR OWNER REVIEW \342\200\224 Exact data-retention windows, third-party processors, and DPO/privacy contact details are marked TODO until owner confirmation.\",\n    sections: [\n      {\n        title: \"1. Information Collected\",\n        body: \"Account, billing, and support ticket data submitted through billing.petalnodes.cloud, panel.petalnodes.cloud, or Discord support tickets is used solely to provision, secure, and support requested hosting services.\",\n        todoMarker: \"TODO: list exact telemetry, analytics, and payment processor disclosures\",\n      },\n      {\n        title: \"2. Backups & Server Data\",\n        body: \"Customer game worlds, configurations, and VPS storage remain isolated to assigned instances. Daily backups are included to aid recovery.\",\n        todoMarker: \"TODO: specify exact backup & account-deletion retention periods\",\n      },\n      {\n        title: \"3. Security Measures\",\n        body: \"Petalnodes employs DDoS mitigation, Cloudflare protection, and panel authentication controls to safeguard infrastructure.\",\n      },\n      {\n        title: \"4. Privacy Requests\",\n        body: \"Requests for data export or deletion can be routed through verified client area or Discord channels once the official privacy contact is confirmed.\",\n        todoMarker: \"TODO: official privacy contact email & jurisdiction-specific rights\",\n      },\n    ],\n  },\n  sla: {\n    id: \"sla\",\n    eyebrow: \"legal draft \302\267 pending approval\",\n    heading: \"Service Level Agreement (Draft)\",\n    lastUpdated: \"TODO: effective date\",\n    draftNotice:\n      \"INITIAL DRAFT FOR OWNER REVIEW \342\200\224 Specific uptime percentage targets, credit compensation schedules, and scheduled maintenance windows are marked TODO until approved.\",\n    sections: [\n      {\n        title: \"1. Live Status Transparency\",\n        body: \"Infrastructure incidents and regional availability across Singapore, Miami, and India are communicated via https://status.petalnodes.cloud and Discord.\",\n      },\n      {\n        title: \"2. Uptime Target & Credits\",\n        body: \"Specific monthly uptime targets and service-credit compensation rules are pending final owner sign-off and are intentionally not guessed here.\",\n        todoMarker: \"TODO: confirmed monthly uptime SLA target and credit schedule\",\n      },\n      {\n        title: \"3. Exclusions\",\n        body: \"Customer-caused misconfigurations, plugin/mod crashes, exceeded resource limits, upstream force majeure events, and announced maintenance windows are typically excluded from SLA calculations.\",\n        todoMarker: \"TODO: confirm maintenance notice period and claim window\",\n      },\n    ],\n  },\n};\n"

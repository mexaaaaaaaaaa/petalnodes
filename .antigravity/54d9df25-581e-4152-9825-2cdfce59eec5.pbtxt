            }
            lines {
              text: "          h = 0.2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rough = 0.9;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      } else if (type === \"path\") {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const n = fbm(x * 0.17, y * 0.17, baseSeed, 4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const cobble = worley(x * 0.15, y * 0.15, 9, baseSeed + 88);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (cobble.f1 < 0.23 && cobble.id > 0.45) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          rgb = mixRgb(cStoneDark, cPathStone, cobble.id * 0.7 + n * 0.3);"

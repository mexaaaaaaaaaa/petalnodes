              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      question: \"What level of control do I get with Petalnodes VPS?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"Every Cherry Blossom VPS uses KVM virtualization and includes full root Linux OS access, allowing you to configure packages, firewalls, Docker, or custom daemons.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      question: \"Which processors do the VPS nodes run?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \"Our infrastructure uses AMD Ryzen and Intel Xeon Gold processors paired with DDR5 memory and NVMe storage. Exact CPU hardware depends on the region and node pool.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

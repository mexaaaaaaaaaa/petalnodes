  code_action {
    action_spec {
      create_file {
        instruction: "import * as THREE from \"three\";\nimport type { BlockType } from \"./islandGenerator\";\nimport type { QualityTier } from \"@/lib/quality\";\n\nexport type BlockFace = \"top\" | \"side\" | \"bottom\";\n\nexport interface PaintedBlockBuffers {\n  albedo: Uint8Array;\n  normal: Uint8Array;\n  emissive: Uint8Array;\n  roughness: Uint8Array;\n  height: Float32Array;\n}\n\nconst SIZE = 64;\n\nfunction hash(x: number, y: number, seed: number): number {\n  const n = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453123;\n  return n - Math.floor(n);\n}\n\nfunction hash2(x: number, y: number, seed: number): [number, number] {\n  return [hash(x, y, seed), hash(x + 19.3, y + 47.1, seed + 93)];\n}\n\nfunction vnoise(x: number, y: number, seed: number): number {\n  const ix = Math.floor(x);\n  const iy = Math.floor(y);\n  const fx = x - ix;\n  const fy = y - iy;\n  const ux = fx * fx * (3 - 2 * fx);\n  const uy = fy * fy * (3 - 2 * fy);\n  const a = hash(ix, iy, seed);\n  const b = hash(ix + 1, iy, seed);\n  const c = hash(ix, iy + 1, seed);\n  const d = hash(ix + 1, iy + 1, seed);\n  return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;\n}\n\nfunction fbm(x: number, y: number, seed: number, octaves = 4): number {\n  let sum = 0;\n  let amp = 0.5;\n  let freq = 1;\n  let norm = 0;\n  for (let i = 0; i < octaves; i++) {\n    sum += vnoise(x * freq, y * freq, seed + i * 17) * amp;\n    norm += amp;\n    amp *= 0.5;\n    freq *= 2.02;\n  }\n  return sum / norm;\n}\n\n/**\n * Tileable / periodic Worley cellular distance (F1, F2, cellId) for crisp stone facets,\n * bark plates, and pebble distributions.\n */\nfunction worley(\n  x: number,\n  y: number,\n  period: number,\n  seed: number,\n): { f1: number; f2: number; edge: number; id: number } {\n  const ix = Math.floor(x);\n  const iy = Math.floor(y);\n  let f1 = 99;\n  let f2 = 99;\n  let bestId = 0;\n\n  for (let dy = -1; dy <= 1; dy++) {\n    for (let dx = -1; dx <= 1; dx++) {\n      const cx = ix + dx;\n      const cy = iy + dy;\n      const wx = ((cx % period) + period) % period;\n      const wy = ((cy % period) + period) % period;\n      const [ox, oy] = hash2(wx, wy, seed);\n      const px = cx + 0.15 + ox * 0.7;\n      const py = cy + 0.15 + oy * 0.7;\n      const dist = Math.hypot(x - px, y - py);\n      if (dist < f1) {\n        f2 = f1;\n        f1 = dist;\n        bestId = hash(wx, wy, seed + 51);\n      } else if (dist < f2) {\n        f2 = dist;\n      }\n    }\n  }\n\n  return { f1, f2, edge: f2 - f1, id: bestId };\n}\n\nfunction hexRgb(hex: number): [number, number, number] {\n  return [(hex >> 16) & 255, (hex >> 8) & 255, hex & 255];\n}\n\nfunction mixRgb(\n  a: [number, number, number],\n  b: [number, number, number],\n  t: number,\n): [number, number, number] {\n  const k = Math.max(0, Math.min(1, t));\n  return [\n    Math.round(a[0] + (b[0] - a[0]) * k),\n    Math.round(a[1] + (b[1] - a[1]) * k),\n    Math.round(a[2] + (b[2] - a[2]) * k),\n  ];\n}\n\nfunction shadeRgb(\n  rgb: [number, number, number],\n  factor: number,\n): [number, number, number] {\n  return [\n    clampByte(rgb[0] * factor),\n    clampByte(rgb[1] * factor),\n    clampByte(rgb[2] * factor),\n  ];\n}\n\nfunction clampByte(v: number): number {\n  return v < 0 ? 0 : v > 255 ? 255 : Math.round(v);\n}\n\nfunction clamp01(v: number): number {\n  return v < 0 ? 0 : v > 1 ? 1 : v;\n}\n\nconst TYPE_SEEDS: Record<BlockType, number> = {\n  cherry_leaves: 101,\n  cherry_log: 202,\n  cherry_planks: 303,\n  grass: 404,\n  dirt: 505,\n  stone: 606,\n  deep_stone: 707,\n  glow_ore: 808,\n  path: 909,\n  paper_lantern: 1010,\n  moss_carpet: 1111,\n  water: 1212,\n  flower: 1313,\n  sapling: 1414,\n};\n\nexport function paintBlockBuffers(\n  type: BlockType,\n  face: BlockFace = \"side\",\n): PaintedBlockBuffers {\n  const albedo = new Uint8Array(SIZE * SIZE * 4);\n  const emissive = new Uint8Array(SIZE * SIZE * 4);\n  const roughness = new Uint8Array(SIZE * SIZE * 4);\n  const height = new Float32Array(SIZE * SIZE);\n  const normal = new Uint8Array(SIZE * SIZE * 4);\n  const baseSeed = TYPE_SEEDS[type] + (face === \"top\" ? 11 : face === \"bottom\" ? 29 : 0);\n\n  const cBlossom100 = hexRgb(0xffdfe7);\n  const cBlossom200 = hexRgb(0xffc9d6);\n  const cBlossom400 = hexRgb(0xff8fab);\n  const cBlossomDeep = hexRgb(0xd96187);\n  const cBlossomShadow = hexRgb(0xb24468);\n  const cBlossomHi = hexRgb(0xfff5f8);\n\n  const cMoss = hexRgb(0x6faf5b);\n  const cMossLight = hexRgb(0x8ecc73);\n  const cMossDark = hexRgb(0x528d44);\n  const cMossDeep = hexRgb(0x3f6e33);\n\n  const cBark = hexRgb(0x6b4a3a);\n  const cBarkDark = hexRgb(0x3f271d);\n  const cBarkLight = hexRgb(0x946856);\n  const cBarkStrip = hexRgb(0xb68674);\n  const cRingLight = hexRgb(0xf1ccbd);\n  const cRingMid = hexRgb(0xd49c89);\n  const cHeartwood = hexRgb(0xb57463);\n\n  const cPlank = hexRgb(0xe7b9a6);\n  const cPlankLight = hexRgb(0xf4d3c5);\n  const cPlankWarm = hexRgb(0xdba28e);\n  const cPlankSeam = hexRgb(0x986758);\n  const cPlankPeg = hexRgb(0x5b3b31);\n\n  const cDirt = hexRgb(0x845f47);\n  const cDirtDark = hexRgb(0x5b3e2c);\n  const cDirtLight = hexRgb(0xa47b5f);\n\n  const cStone = hexRgb(0x9892a0);\n  const cStoneLight = hexRgb(0xbcb6c4);\n  const cStoneDark = hexRgb(0x6c6574);\n  const cStoneCrevice = hexRgb(0x514b58);\n\n  const cDeepStone = hexRgb(0x5c5265);\n  const cDeepDark = hexRgb(0x3d3445);\n  const cDeepLight = hexRgb(0x7c7086);\n\n  const cLantern = hexRgb(0xffc75a);\n  const cLanternWarm = hexRgb(0xffe6a1);\n  const cPaper = hexRgb(0xfbf6ee);\n  const cPath = hexRgb(0xc7b194);\n  const cPathDark = hexRgb(0x9a8267);\n  const cPathStone = hexRgb(0x9f99a3);\n  const cWater = hexRgb(0x66b6e6);\n  const cWaterDeep = hexRgb(0x4692c4);\n  const cWaterFoam = hexRgb(0xe2f5ff);\n\n  for (let y = 0; y < SIZE; y++) {\n    for (let x = 0; x < SIZE; x++) {\n      const idx = y * SIZE + x;\n      const p4 = idx * 4;\n      let rgb: [number, number, number] = [180, 180, 180];\n      let alpha = 255;\n      let h = 0.5;\n      let rough = 0.85;\n      let em: [number, number, number] = [0, 0, 0];\n\n      // Subtle baked bevel & ambient occlusion near block boundaries\n      const edgeDist = Math.min(x, y, SIZE - 1 - x, SIZE - 1 - y);\n      const edgeDarken = edgeDist < 3 ? 0.9 + edgeDist * 0.032 : 1.0;\n\n      if (type === \"cherry_leaves\") {\n        const warpX = x + fbm(x * 0.1, y * 0.1, baseSeed + 3, 2) * 3.5;\n        const warpY = y + fbm(x * 0.1 + 9, y * 0.1 + 4, baseSeed + 7, 2) * 3.5;\n        const cluster = fbm(warpX * 0.14, warpY * 0.14, baseSeed, 4);\n        const cells = worley(warpX * 0.15, warpY * 0.15, 10, baseSeed + 23);\n        const micro = hash(x, y, baseSeed + 5);\n\n        // ~24% alpha cutout holes for crisp leaf canopy silhouette\n        if (cluster < 0.425 && !(y > SIZE - 5 && micro > 0.7)) {\n          alpha = 0;\n          rgb = cBlossom400;\n          h = 0.08;\n        } else {\n          // Layered leaf petal dome from cell distance + top-left bevel\n          const tlCluster = fbm((warpX - 2) * 0.14, (warpY - 2) * 0.14, baseSeed, 3);\n          const bevel = cluster - tlCluster;\n          const petalCenter = clamp01(1 - cells.f1 * 1.15);\n\n          if (bevel > 0.045 || cluster > 0.67 || petalCenter > 0.72) {\n            rgb = mixRgb(cBlossom100, cBlossomHi, 0.5 + petalCenter * 0.35);\n            h = 0.76 + petalCenter * 0.2;\n            rough = 0.68;\n          } else if (cluster > 0.52) {\n            rgb = mixRgb(cBlossom400, cBlossom200, (cluster - 0.52) * 5.2);\n            h = 0.58 + petalCenter * 0.15;\n            rough = 0.74;\n          } else if (cluster > 0.45) {\n            rgb = mixRgb(cBlossomDeep, cBlossom400, (cluster - 0.45) * 10);\n            h = 0.42;\n            rough = 0.82;\n          } else {\n            rgb = cBlossomShadow;\n            h = 0.28;\n            rough = 0.9;\n          }\n\n          if (micro > 0.91) {\n            rgb = mixRgb(rgb, cBlossomHi, 0.42);\n          } else if (micro < 0.08) {\n            rgb = mixRgb(rgb, cBlossomShadow, 0.28);\n          }\n        }\n      } else if (type === \"cherry_log\") {\n        if (face === \"top\" || face === \"bottom\") {\n          const dx = x - SIZE / 2 + 0.5;\n          const dy = y - SIZE / 2 + 0.5;\n          const angle = Math.atan2(dy, dx);\n          const warp = fbm(x * 0.13, y * 0.13, baseSeed, 3) * 3.2;\n          const radial = Math.hypot(dx, dy) + warp;\n          const ray = vnoise(Math.cos(angle) * 6 + 10, Math.sin(angle) * 6 + 10, baseSeed + 31);\n\n          if (radial > 27.5) {\n            const barkGroove = vnoise(x * 0.4, y * 0.4, baseSeed + 5);\n            rgb = mixRgb(cBarkDark, cBark, barkGroove);\n            h = 0.68 - barkGroove * 0.18;\n            rough = 0.92;\n          } else if (radial > 25) {\n            rgb = cBarkLight;\n            h = 0.62;\n            rough = 0.85;\n          } else {\n            const ring = Math.sin(radial * 1.28) * 0.5 + 0.5;\n            const heartBlend = clamp01(1 - radial / 15);\n            const sapColor = mixRgb(cRingMid, cRingLight, ring);\n            rgb = mixRgb(sapColor, cHeartwood, heartBlend * 0.55 * (1 - ring * 0.4));\n            if (ray < 0.24 && radial > 4) {\n              rgb = shadeRgb(rgb, 0.86);\n            }\n            h = 0.44 + ring * 0.22;\n            rough = 0.72 + (1 - ring) * 0.14;\n          }\n        } else {\n          // Cherry wood features horizontal lenticel bands over vertical bark furrows\n          const furrow = fbm(x * 0.42, y * 0.08, baseSeed, 4);\n          const crack = vnoise(x * 0.68, y * 0.11, baseSeed + 41);\n          const lenticelBand =\n            vnoise(x * 0.09, y * 0.52, baseSeed + 77) > 0.73 &&\n            vnoise(x * 0.35, y * 0.6, baseSeed + 89) > 0.48;\n\n          if (crack < 0.25) {\n            rgb = cBarkDark;\n            h = 0.18;\n            rough = 0.95;\n          } else if (lenticelBand) {\n            rgb = mixRgb(cBarkLight, cBarkStrip, 0.65);\n            h = 0.82;\n            rough = 0.74;\n          } else if (furrow > 0.62) {\n            rgb = cBarkLight;\n            h = 0.74;\n            rough = 0.84;\n          } else {\n            rgb = mixRgb(cBarkDark, cBark, furrow * 1.38);\n            h = 0.42 + furrow * 0.28;\n            rough = 0.88;\n          }\n        }\n      } else if (type === \"cherry_planks\") {\n        const boardIndex = Math.floor(y / 16);\n        const boardRow = y % 16;\n        const vertSeamX = (boardIndex * 29 + 17) % SIZE;\n        const isSeamY = boardRow === 0;\n        const isBevelTop = boardRow === 1;\n        const isBevelBottom = boardRow === 15;\n        const isSeamX = x === vertSeamX;\n        const isPeg =\n          (boardRow === 4 || boardRow === 12) &&\n          (Math.abs(x - ((vertSeamX + 3) % SIZE)) === 0 ||\n            Math.abs(x - ((vertSeamX - 3 + SIZE) % SIZE)) === 0);\n\n        if (isSeamY || isSeamX) {\n          rgb = cPlankSeam;\n          h = 0.16;\n          rough = 0.95;\n        } else if (isPeg) {\n          rgb = cPlankPeg;\n          h = 0.42;\n          rough = 0.65;\n        } else {\n          const warp = fbm(x * 0.06 + boardIndex * 7, y * 0.18, baseSeed + 9, 2) * 1.8;\n          const grain = fbm(x * 0.07 + boardIndex * 5, (y + warp) * 0.55, baseSeed, 3);\n          const toneBias = hash(boardIndex, 3, baseSeed + 15) * 0.35;\n          const baseColor = mixRgb(cPlank, cPlankWarm, toneBias);\n          rgb = mixRgb(baseColor, cPlankLight, grain);\n          if (isBevelTop) rgb = shadeRgb(rgb, 1.06);\n          if (isBevelBottom) rgb = shadeRgb(rgb, 0.9);\n          h = isBevelTop ? 0.68 : isBevelBottom ? 0.45 : 0.54 + grain * 0.2;\n          rough = 0.62 + grain * 0.18;\n        }\n      } else if (type === \"grass\") {\n        if (face === \"top\") {\n          const turf = fbm(x * 0.16, y * 0.16, baseSeed, 4);\n          const blades = vnoise(x * 0.65, y * 0.65, baseSeed + 31);\n          const petals = hash(x, y, baseSeed + 71);\n          if (turf > 0.62 || blades > 0.78) rgb = cMossLight;\n          else if (turf > 0.43) rgb = cMoss;\n          else if (turf > 0.27) rgb = cMossDark;\n          else rgb = cMossDeep;\n\n          if (petals > 0.982) {\n            rgb = petals > 0.992 ? cBlossom100 : cBlossom400;\n            h = 0.88;\n            rough = 0.7;\n          } else {\n            h = 0.42 + turf * 0.35 + blades * 0.16;\n            rough = 0.88;\n          }\n        } else if (face === \"bottom\") {\n          const dn = fbm(x * 0.22, y * 0.22, baseSeed + 5, 4);\n          const pebbles = worley(x * 0.16, y * 0.16, 10, baseSeed + 21);\n          rgb = pebbles.f1 < 0.22 ? cStoneDark : mixRgb(cDirtDark, cDirt, dn);\n          h = pebbles.f1 < 0.22 ? 0.68 : 0.32 + dn * 0.35;\n          rough = 0.94;\n        } else {\n          // Side: lush wavy moss overhang draping over loamy stratified dirt\n          const wave =\n            11 +\n            Math.round(\n              Math.sin(x * 0.34) * 2.5 +\n                fbm(x * 0.36, 1.5, baseSeed, 3) * 4.0,\n            );\n          if (y < wave) {\n            const gn = fbm(x * 0.22, y * 0.28, baseSeed, 3);\n            const tip = y >= wave - 2;\n            rgb = tip\n              ? cMossDark\n              : gn > 0.56\n                ? cMossLight\n                : gn > 0.34\n                  ? cMoss\n                  : cMossDark;\n            h = tip ? 0.68 : 0.78 + gn * 0.18;\n            rough = 0.86;\n          } else if (y === wave) {\n            rgb = cMossDeep;\n            h = 0.48;\n            rough = 0.92;\n          } else {\n            const dn = fbm(x * 0.2, y * 0.24, baseSeed + 9, 4);\n            const strata = Math.sin(y * 0.42 + dn * 2.4) * 0.5 + 0.5;\n            const pebbles = worley(x * 0.18, y * 0.18, 12, baseSeed + 31);\n            if (pebbles.f1 < 0.2 && pebbles.id > 0.62) {\n              rgb = mixRgb(cStoneDark, cStone, pebbles.id);\n              h = 0.68;\n              rough = 0.78;\n            } else {\n              rgb = mixRgb(cDirtDark, cDirtLight, dn * 0.75 + strata * 0.25);\n              h = 0.28 + dn * 0.32;\n              rough = 0.94;\n            }\n          }\n        }\n      } else if (type === \"dirt\") {\n        const dn = fbm(x * 0.2, y * 0.2, baseSeed, 4);\n        const clods = worley(x * 0.16, y * 0.16, 10, baseSeed + 22);\n        const isPebble = clods.f1 < 0.21 && clods.id > 0.65;\n        if (isPebble) {\n          rgb = mixRgb(cStoneDark, cStone, 1 - clods.f1 * 3);\n          h = 0.74;\n          rough = 0.76;\n        } else {\n          rgb = mixRgb(cDirtDark, cDirtLight, dn * 0.8 + (1 - clods.f1) * 0.2);\n          if (clods.edge < 0.055) rgb = shadeRgb(rgb, 0.86);\n          h = 0.3 + dn * 0.38;\n          rough = 0.94;\n        }\n      } else if (type === \"stone\") {\n        const strata = fbm(x * 0.1, y * 0.2, baseSeed, 4);\n        const cells = worley(x * 0.13 + strata * 0.4, y * 0.13, 8, baseSeed + 19);\n        const micro = vnoise(x * 0.6, y * 0.6, baseSeed + 41);\n\n        if (cells.edge < 0.055) {\n          rgb = cStoneCrevice;\n          h = 0.16;\n          rough = 0.95;\n        } else {\n          const facetShade = 0.84 + cells.id * 0.24 + (1 - cells.f1) * 0.1;\n          const base = mixRgb(cStoneDark, cStoneLight, strata * 0.65 + micro * 0.35);\n          rgb = shadeRgb(base, facetShade);\n          if (cells.edge < 0.11) {\n            rgb = mixRgb(rgb, cStoneLight, 0.25);\n          }\n          h = 0.38 + strata * 0.32 + (cells.edge < 0.12 ? 0.18 : 0.08 * cells.id);\n          rough = 0.66 + strata * 0.22;\n        }\n      } else if (type === \"deep_stone\") {\n        const strata = fbm(x * 0.16, y * 0.22, baseSeed, 4);\n        const cells = worley(x * 0.17 + strata * 0.3, y * 0.17, 11, baseSeed + 14);\n        if (cells.edge < 0.065) {\n          rgb = cDeepDark;\n          h = 0.14;\n          rough = 0.92;\n        } else {\n          rgb = mixRgb(cDeepDark, cDeepLight, strata * 0.6 + cells.id * 0.4);\n          h = 0.32 + strata * 0.35 + cells.id * 0.16;\n          rough = 0.62 + (1 - cells.id) * 0.2;\n        }\n      } else if (type === \"glow_ore\") {\n        const strata = fbm(x * 0.18, y * 0.22, baseSeed, 4);\n        const cells = worley(x * 0.17, y * 0.17, 11, baseSeed + 14);\n        rgb = mixRgb(cDeepDark, cDeepStone, strata * 0.7 + cells.id * 0.3);\n        h = 0.32 + strata * 0.34;\n        rough = 0.72;\n\n        // Sharp faceted crystal geode clusters with bright core & rim sparkle\n        const crystalField = fbm(x * 0.16 + 2, y * 0.16 + 4, baseSeed + 55, 3);\n        const crystalCells = worley(x * 0.25, y * 0.25, 16, baseSeed + 66);\n        if (crystalField > 0.6) {\n          const isGold = crystalCells.id > 0.5;\n          const crystalBase = isGold ? cLantern : cBlossom400;\n          const facetBright = clamp01(1 - crystalCells.f1 * 1.45);\n          rgb = mixRgb(crystalBase, isGold ? cLanternWarm : cBlossomHi, facetBright * 0.65);\n          em = mixRgb(crystalBase, isGold ? cLanternWarm : cBlossom100, facetBright * 0.45);\n          h = 0.82 + facetBright * 0.18;\n          rough = 0.22;\n        }\n      } else if (type === \"path\") {\n        const n = fbm(x * 0.18, y * 0.18, baseSeed, 4);\n        const cobble = worley(x * 0.18, y * 0.18, 11, baseSeed + 88);\n        if (cobble.f1 < 0.24 && cobble.id > 0.42) {\n          rgb = mixRgb(cStoneDark, cPathStone, cobble.id * 0.7 + n * 0.3);\n          h = 0.68 + (0.24 - cobble.f1) * 0.6;\n          rough = 0.74;\n        } else {\n          rgb = mixRgb(cPathDark, cPath, n);\n          h = 0.36 + n * 0.2;\n          rough = 0.92;\n        }\n      } else if (type === \"paper_lantern\") {\n        const isFrame =\n          x < 6 ||\n          x >= SIZE - 6 ||\n          y < 7 ||\n          y >= SIZE - 7 ||\n          y === 23 ||\n          y === 24 ||\n          y === 40 ||\n          y === 41 ||\n          x === 31 ||\n          x === 32;\n        if (isFrame) {\n          const woodGrain = vnoise(x * 0.45, y * 0.15, baseSeed + 12);\n          rgb = mixRgb(cBarkDark, cBark, woodGrain);\n          h = 0.76 + woodGrain * 0.1;\n          rough = 0.85;\n        } else {\n          const fiberX = vnoise(x * 0.8, y * 0.12, baseSeed + 3);\n          const fiberY = vnoise(x * 0.12, y * 0.8, baseSeed + 9);\n          const centerDist = Math.hypot((x - 31.5) / 26, (y - 31.5) / 24);\n          const innerGlow = clamp01(1 - centerDist * 0.72);\n          const paperTex = (fiberX + fiberY) * 0.5;\n          rgb = mixRgb(cPaper, cLanternWarm, 0.3 + innerGlow * 0.52 + paperTex * 0.12);\n          em = mixRgb(cLantern, cLanternWarm, innerGlow * 0.75);\n          h = 0.44 + paperTex * 0.08;\n          rough = 0.92;\n        }\n      } else if (type === \"moss_carpet\") {\n        const n = fbm(x * 0.22, y * 0.22, baseSeed, 4);\n        const tuft = worley(x * 0.25, y * 0.25, 16, baseSeed + 12);\n        const petal = hash(x, y, baseSeed + 91) > 0.986;\n        if (petal) {\n          rgb = cBlossom200;\n          h = 0.84;\n          rough = 0.74;\n        } else {\n          rgb = mixRgb(cMossDark, cMossLight, n * 0.7 + (1 - tuft.f1) * 0.3);\n          if (tuft.edge < 0.06) rgb = cMossDeep;\n          h = 0.4 + n * 0.4 + (1 - tuft.f1) * 0.12;\n          rough = 0.92;\n        }\n      } else if (type === \"water\") {\n        const caustic = worley(x * 0.12, y * 0.12, 8, baseSeed + 17);\n        const ripple = fbm(x * 0.15, y * 0.2, baseSeed, 3);\n        const shimmer = clamp01(caustic.edge < 0.08 ? 1 : ripple);\n        rgb =\n          caustic.edge < 0.075 && ripple > 0.45\n            ? cWaterFoam\n            : mixRgb(cWaterDeep, cWater, shimmer);\n        alpha = 216;\n        h = 0.42 + ripple * 0.2 + (caustic.edge < 0.08 ? 0.12 : 0);\n        rough = 0.14;\n      } else if (type === \"flower\") {\n        const dx = x - 32;\n        const dy = y - 32;\n        const r = Math.hypot(dx, dy);\n        const a = Math.atan2(dy, dx);\n        const petalLobe = Math.sin(a * 5);\n        if (r < 6) {\n          rgb = mixRgb(cLantern, cLanternWarm, 1 - r / 6);\n          h = 0.88;\n          rough = 0.55;\n        } else if (r < 22 && petalLobe > -0.22) {\n          const vein = clamp01(petalLobe * 0.5 + 0.5);\n          rgb = r < 13 ? mixRgb(cBlossom200, cBlossomHi, vein * 0.5) : mixRgb(cBlossom400, cBlossom200, vein * 0.4);\n          h = 0.76 + (1 - r / 24) * 0.12;\n          rough = 0.72;\n        } else if (y > 38 && Math.abs(dx) < 3) {\n          rgb = Math.abs(dx) < 1.5 ? cMossLight : cMossDark;\n          h = 0.6;\n          rough = 0.85;\n        } else {\n          alpha = 0;\n          rgb = cBlossom200;\n        }\n      } else if (type === \"sapling\") {\n        const dx = x - 32;\n        const isStem = Math.abs(dx) < 3 && y > 26;\n        const leafL = Math.hypot(x - 22, y - 24);\n        const leafR = Math.hypot(x - 42, y - 20);\n        const blossomTop = Math.hypot(x - 32, y - 15);\n        if (blossomTop < 9.5) {\n          const rim = blossomTop < 5.5;\n          rgb = rim || (x + y) % 3 === 0 ? cBlossom100 : cBlossom400;\n          h = 0.86;\n          rough = 0.7;\n        } else if (leafL < 11 || leafR < 11) {\n          const n = vnoise(x * 0.4, y * 0.4, baseSeed + 4);\n          rgb = n > 0.55 ? cMossLight : cMoss;\n          h = 0.75;\n          rough = 0.82;\n        } else if (isStem) {\n          rgb = dx < 0 ? cBarkLight : cBark;\n          h = 0.65;\n          rough = 0.88;\n        } else {\n          alpha = 0;\n          rgb = cMoss;\n        }\n      }\n\n      albedo[p4] = clampByte(rgb[0] * edgeDarken);\n      albedo[p4 + 1] = clampByte(rgb[1] * edgeDarken);\n      albedo[p4 + 2] = clampByte(rgb[2] * edgeDarken);\n      albedo[p4 + 3] = alpha;\n\n      emissive[p4] = em[0];\n      emissive[p4 + 1] = em[1];\n      emissive[p4 + 2] = em[2];\n      emissive[p4 + 3] = 255;\n\n      const roughByte = clampByte(rough * 255);\n      roughness[p4] = roughByte;\n      roughness[p4 + 1] = roughByte;\n      roughness[p4 + 2] = roughByte;\n      roughness[p4 + 3] = 255;\n\n      height[idx] = h;\n    }\n  }\n\n  // Derive seamless tangent-space normal map from height field using a 3x3 Sobel filter\n  const strength =\n    type === \"stone\" || type === \"deep_stone\" || type === \"glow_ore\"\n      ? 3.1\n      : type === \"cherry_log\" || type === \"cherry_planks\"\n        ? 2.8\n        : 2.4;\n\n  const sampleH = (sx: number, sy: number) =>\n    height[((sy + SIZE) % SIZE) * SIZE + ((sx + SIZE) % SIZE)];\n\n  for (let y = 0; y < SIZE; y++) {\n    for (let x = 0; x < SIZE; x++) {\n      const tl = sampleH(x - 1, y - 1);\n      const tc = sampleH(x, y - 1);\n      const tr = sampleH(x + 1, y - 1);\n      const ml = sampleH(x - 1, y);\n      const mr = sampleH(x + 1, y);\n      const bl = sampleH(x - 1, y + 1);\n      const bc = sampleH(x, y + 1);\n      const br = sampleH(x + 1, y + 1);\n\n      const sobelX = (tr + 2 * mr + br - (tl + 2 * ml + bl)) * 0.25 * strength;\n      const sobelY = (bl + 2 * bc + br - (tl + 2 * tc + tr)) * 0.25 * strength;\n\n      const nx = -sobelX;\n      const ny = -sobelY;\n      const nz = 1.0;\n      const invLen = 1 / Math.hypot(nx, ny, nz);\n      const p4 = (y * SIZE + x) * 4;\n      normal[p4] = clampByte((nx * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 1] = clampByte((ny * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 2] = clampByte((nz * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 3] = 255;\n    }\n  }\n\n  return { albedo, normal, emissive, roughness, height };\n}\n\nexport function paintBlockTexture(type: BlockType, face: BlockFace = \"side\"): Uint8Array {\n  return paintBlockBuffers(type, face).albedo;\n}\n\nexport function paintNormalMap(type: BlockType, face: BlockFace = \"side\"): Uint8Array {\n  return paintBlockBuffers(type, face).normal;\n}\n\nfunction makeDataTexture(data: Uint8Array, isColor: boolean): THREE.DataTexture {\n  const tex = new THREE.DataTexture(data, SIZE, SIZE, THREE.RGBAFormat);\n  tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n  tex.magFilter = THREE.NearestFilter;\n  tex.minFilter = THREE.LinearMipmapLinearFilter;\n  tex.generateMipmaps = true;\n  tex.wrapS = THREE.RepeatWrapping;\n  tex.wrapT = THREE.RepeatWrapping;\n  tex.needsUpdate = true;\n  return tex;\n}\n\nconst materialCache = new Map<string, THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[]>();\n\n/**\n * Shared uniform object updated per frame by IslandBlocks without triggering shader recompiles.\n */\nexport const islandShaderUniforms = {\n  uProgress: { value: 0 },\n  uTime: { value: 0 },\n  uCutaway: { value: 0 },\n  uDusk: { value: 0 },\n};\n\nfunction attachStoryShader(\n  mat: THREE.MeshStandardMaterial,\n  options: { sway?: boolean; cutawayEligible?: boolean; emissiveDuskBoost?: boolean },\n) {\n  mat.onBeforeCompile = (shader) => {\n    shader.uniforms.uProgress = islandShaderUniforms.uProgress;\n    shader.uniforms.uTime = islandShaderUniforms.uTime;\n    shader.uniforms.uCutaway = islandShaderUniforms.uCutaway;\n    shader.uniforms.uDusk = islandShaderUniforms.uDusk;\n\n    shader.vertexShader =\n      `\n      attribute float aAppearAt;\n      uniform float uProgress;\n      uniform float uTime;\n      uniform float uCutaway;\n      varying float vCutClip;\n      ` + shader.vertexShader;\n\n    shader.vertexShader = shader.vertexShader.replace(\n      \"#include <begin_vertex>\",\n      `\n      #include <begin_vertex>\n      float dropWindow = 0.02;\n      float reveal = aAppearAt <= 0.0001\n        ? 1.0\n        : clamp((uProgress - aAppearAt) / dropWindow, 0.0, 1.0);\n\n      // Tiny overshoot bounce\n      float bounce = reveal < 1.0\n        ? (reveal < 0.7 ? (reveal / 0.7) * 1.08 : 1.08 - ((reveal - 0.7) / 0.3) * 0.08)\n        : 1.0;\n\n      float sc = reveal <= 0.0 ? 0.0 : bounce;\n      transformed *= sc;\n      transformed.y += (1.0 - reveal) * 1.5;\n\n      ${\n        options.sway\n          ? `\n      vec4 instPos = instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\n      float phase = instPos.x * 0.7 + instPos.z * 0.9 + instPos.y * 0.4;\n      transformed.x += sin(uTime * 1.6 + phase) * 0.045 * reveal;\n      transformed.z += cos(uTime * 1.3 + phase * 1.2) * 0.035 * reveal;\n      `\n          : \"\"\n      }\n\n      vCutClip = 0.0;\n      ${\n        options.cutawayEligible\n          ? `\n      #ifdef USE_INSTANCING\n        vec3 centerPos = (instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;\n        if (uCutaway > 0.01 && centerPos.z > 0.6 && centerPos.y < -0.5) {\n          vCutClip = uCutaway;\n        }\n      #endif\n      `\n          : \"\"\n      }\n      `,\n    );\n\n    shader.fragmentShader =\n      `\n      varying float vCutClip;\n      uniform float uDusk;\n      ` + shader.fragmentShader;\n\n    shader.fragmentShader = shader.fragmentShader.replace(\n      \"#include <clipping_planes_fragment>\",\n      `\n      #include <clipping_planes_fragment>\n      if (vCutClip > 0.5) discard;\n      `,\n    );\n\n    if (options.emissiveDuskBoost) {\n      shader.fragmentShader = shader.fragmentShader.replace(\n        \"#include <emissivemap_fragment>\",\n        `\n        #include <emissivemap_fragment>\n        totalEmissiveRadiance *= (0.35 + uDusk * 2.2);\n        `,\n      );\n    }\n  };\n  mat.customProgramCacheKey = () =>\n    `petalnode-${options.sway ? 1 : 0}-${options.cutawayEligible ? 1 : 0}-${options.emissiveDuskBoost ? 1 : 0}`;\n}\n\nexport function getBlockMaterial(\n  type: BlockType,\n  tier: QualityTier,\n  attachStory = true,\n): THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[] {\n  const cacheKey = `${type}:${tier}:${attachStory ? \"story\" : \"plain\"}`;\n  const existing = materialCache.get(cacheKey);\n  if (existing) return existing;\n\n  const isLeafOrPlant = type === \"cherry_leaves\" || type === \"flower\" || type === \"sapling\";\n  const isCutawayEligible =\n    type === \"stone\" || type === \"deep_stone\" || type === \"dirt\" || type === \"glow_ore\";\n  const isLantern = type === \"paper_lantern\";\n  const isOre = type === \"glow_ore\";\n\n  const makeOne = (face: BlockFace) => {\n    const bufs = paintBlockBuffers(type, face);\n    const map = makeDataTexture(bufs.albedo, true);\n    const normalMap = makeDataTexture(bufs.normal, false);\n    const roughnessMap = makeDataTexture(bufs.roughness, false);\n    const hasEmissive = isOre || isLantern;\n    const emissiveMap = hasEmissive ? makeDataTexture(bufs.emissive, true) : undefined;\n\n    const matParams: THREE.MeshStandardMaterialParameters = {\n      color: 0xffffff,\n      map,\n      normalMap,\n      normalScale: new THREE.Vector2(0.85, 0.85),\n      roughnessMap,\n      roughness: 1.0,\n      metalness: isOre ? 0.14 : 0.0,\n      alphaTest: isLeafOrPlant ? 0.4 : 0,\n      transparent: type === \"water\",\n      opacity: type === \"water\" ? 0.82 : 1,\n      side: isLeafOrPlant ? THREE.DoubleSide : THREE.FrontSide,\n      emissive: hasEmissive ? new THREE.Color(0xffffff) : new THREE.Color(0x000000),\n      emissiveIntensity: isOre ? 1.85 : isLantern ? 1.6 : 0,\n    };\n    if (emissiveMap) {\n      matParams.emissiveMap = emissiveMap;\n    }\n    const mat = new THREE.MeshStandardMaterial(matParams);\n\n    if (attachStory) {\n      attachStoryShader(mat, {\n        sway: isLeafOrPlant,\n        cutawayEligible: isCutawayEligible,\n        emissiveDuskBoost: isLantern,\n      });\n    }\n    return mat;\n  };\n\n  let result: THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[];\n  if (type === \"grass\" || type === \"cherry_log\") {\n    const side = makeOne(\"side\");\n    const top = makeOne(\"top\");\n    const bottom = makeOne(\"bottom\");\n    // BoxGeometry face order: +x, -x, +y, -y, +z, -z\n    result = [side, side, top, bottom, side, side];\n  } else {\n    result = makeOne(\"side\");\n  }\n\n  materialCache.set(cacheKey, result);\n  return result;\n}\n"

            }
            lines {
              text: "        // ~25% alpha cutout holes"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (cluster < 0.37 && !(y > SIZE - 4 && micro > 0.72)) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (cluster < 0.42 && !(y > SIZE - 4 && micro > 0.72)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

      thinking_signature: "\022\237\025\n\234\025\001i\024}\023\265\002e\245\247\316B\270k\361\327\025j\001\206I5\006&~\021~\267;\372\276<\v\a\337R\307q\273\312,\241\267\017d\031\230f\356\264Va\312N\200\210\347]\301p\037\326\351\026\245\253\335 M\225x\376\304\361\304hmkP\337\300fLe\345\365\331\f\032\262\006x\351s\322\261\343\360\341\357\b\020\274\223{#\024J\357\203>R8E*\201H\345\213L\356*\003E\377\275<\210(\213\330\005Vm\f\004\372\306\217J\020.y\314\361\t\004)r\025\235J\035\2123\246i\tG5A\354rh\353\264\222\206\310I\347\366\2168y\330\263m\035\030%7/sb\203\340\331\026\207\026@%\273\001^\253\231+\223\367\307\311\315\020\344s\371\r\024\333j\363\243\035\363\272dR\313Z\036\264\353M\316\232\256:e\324\205\372R\265\264\3638P\333\344\021\261n\324\350\253\f\200\304w\257=+L\2244\334m\322A\\\301\360\345\262\263+\3624\020\245\261!e\214\220\032 -\266e\245\v\017\237+X\311\367\b{\0311\233\036^\365\200\264*\210\223\004\245j\250)\226\206a-NEC\371\247_\324\337{\273*\352\'k\353\"m%\330Al\325\220t\0227b\361\236}\333\200\320{\033\336\253\367\033\303\334\334\221\022\240\314\256\312fzw\315S\2177\230Z\342\232S8S\372+{\267\301\016\f\321\377(\n\307\373p\331vvG\201\235\236Y\332\036\\\311\337s\224Sc\021 \251\301\275lQ\274\320a\332m$\306\f\310\355f\223Wq9\034\214m\236\\\026|\'\004L2q\262\bE%\'\374a\376@\035\350\303\311\331_\026\274\214a\bq\"\340\033\2109\027{X7\351wg\226\036\313\203\272\326\320\377\370rt\320P\373\362\367\025\310/\017\037-\357(f\031I\023\206%\337S\221P\276\346\026\333<\370\310\375\331\213K%\320\362\246\305\b\003/\231\214> \216\354o\304\031\204\177\006|t]\204\t\254\316\006\232\027\3449\305J\223/\t\037\177\376\234\362\302\020#F\213\264-+\374\376\362O0\336\241]\333\n\'\343\037\301\035\vt\021el\207C\233\214bq$+\354\375r\343\204\232\0255D\345\237\244\311\366\233>qi\020\207?!\236d\367\n\314\314y\373\004w\253v\201@r\251q\001\306\363\320\317\210\327f\213Vu\340:(b@\252\020\377:\016Jo^\307\300\365\225k\035\f\256l:\t\377\3528\351\f\260\350[\334\231\v\227\370\247\350\026/\004\251\024\204le\36
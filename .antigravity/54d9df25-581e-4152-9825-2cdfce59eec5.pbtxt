      arguments_json: "{\"Description\":\"Expand content tests to validate 5 botanical Bot Hosting drafts, hostingCategories, serviceComparison, and 12 doc categories\", \"Instruction\":\"Import hostingCategories and serviceComparison and add unit tests for Bot Hosting drafts, Miami-only infrastructure, and 12 docs categories\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":28, \"ReplacementContent\":\"  footerConfig,\\n  freeRewards,\\n  highlightPlanIds,\\n  hostingCategories,\\n  legalDocs,\\n  links,\\n  listTodos,\\n  locationsPage,\\n  modpacksPage,\\n  nav,\\n  planIncludes,\\n  plans,\\n  plansSection,\\n  serviceComparison,\\n  story,\\n  trust,\\n  vpsPlans,\\n  vpsSection,\\n} from \\\"./index\\\";\", \"StartLine\":11, \"TargetContent\":\"  footerConfig,\\n  freeRewards,\\n  highlightPlanIds,\\n  legalDocs,\\n  links,\\n  listTodos,\\n  locationsPage,\\n  modpacksPage,\\n  nav,\\n  planIncludes,\\n  plans,\\n  plansSection,\\n  story,\\n  trust,\\n  vpsPlans,\\n  vpsSection,\\n} from \\\"./index\\\";\"}, {\"AllowMultiple\":false, \"EndLine\":124, \"ReplacementContent\":\"  assert.ok(paths.has(\\\"links.socials[0].href\\\"));\\n  assert.ok(paths.has(\\\"botHosting.supportedRuntimesTodo\\\"));\\n  assert.ok(paths.has(\\\"botHosting.miamiLatencyTodo\\\"));\\n  assert.ok(paths.has(\\\"legalDocs.terms.lastUpdated\\\"));\\n});\\n\\ntest(\\\"botHosting has 5 botanical draft plans on Miami-only infrastructure with no unlimited CPU or 2ms ping claim\\\", () => {\\n  assert.deepEqual(\\n    botHosting.plans.map((p) => p.id),\\n    [\\\"pollen\\\", \\\"dewdrop\\\", \\\"nectar\\\", \\\"petal\\\", \\\"blossom\\\"],\\n  );\\n  assert.deepEqual(\\n    botHosting.plans.map((p) => p.priceMonthly),\\n    [\\\"\342\202\27139\\\", \\\"\342\202\27169\\\", \\\"\342\202\271119\\\", \\\"\342\202\271199\\\", \\\"\342\202\271279\\\"],\\n  );\\n  assert.ok(botHosting.plans.every((p) => p.isDraft));\\n  assert.match(botHosting.infrastructureLocation, /Miami/i);\\n  const botText = JSON.stringify(botHosting);\\n  assert.ok(!/unlimited\\\\s+cpu/i.test(botText));\\n  assert.ok(!/singapore|india/i.test(botHosting.infrastructureLocation));\\n  assert.equal(hostingCategories.length, 3);\\n  assert.equal(serviceComparison.rows.length, 5);\\n  assert.equal(docsPage.categories.length, 12);\\n  assert.ok(docsPage.categories.some((c) => c.id === \\\"vps-getting-started\\\"));\\n  assert.ok(docsPage.categories.some((c) => c.id === \\\"bot-hosting-getting-started\\\"));\\n});\", \"StartLine\":120, \"TargetContent\":\"  assert.ok(paths.has(\\\"links.socials[0].href\\\"));\\n  assert.ok(paths.has(\\\"botHosting.supportedRuntimesTodo\\\"));\\n  assert.ok(paths.has(\\\"legalDocs.terms.lastUpdated\\\"));\\n});\"}, {\"AllowMultiple\":false, \"EndLine\":151, \"ReplacementContent\":\"  const serialized = JSON.stringify({\\n    brand,\\n    hostingCategories,\\n    serviceComparison,\\n    planIncludes,\\n    plans,\\n    vpsPlans,\\n    vpsSection,\\n    freeRewards,\\n    boostRewards,\\n    botHosting,\\n    nav,\\n    story,\\n    plansSection,\\n    trust,\\n    faq,\\n    footerColumns: footerConfig.columns,\\n    locationsPage,\\n    docsPage,\\n    modpacksPage,\\n    aboutPage,\\n    contactPage,\\n    legalDocs,\\n  });\\n  assert.equal(forbidden.test(serialized), false);\\n});\", \"StartLine\":128, \"TargetContent\":\"  const serialized = JSON.stringify({\\n    brand,\\n    planIncludes,\\n    plans,\\n    vpsPlans,\\n    vpsSection,\\n    freeRewards,\\n    boostRewards,\\n    botHosting,\\n    nav,\\n    story,\\n    plansSection,\\n    trust,\\n    faq,\\n    footerColumns: footerConfig.columns,\\n    locationsPage,\\n    docsPage,\\n    modpacksPage,\\n    aboutPage,\\n    contactPage,\\n    legalDocs,\\n  });\\n  assert.equal(forbidden.test(serialized), false);\\n});\"}], \"TargetFile\":\"/src/content/content.test.ts\", \"toolAction\":\"Updating content unit tests\", \"toolSummary\":\"Update content.test.ts\"}"

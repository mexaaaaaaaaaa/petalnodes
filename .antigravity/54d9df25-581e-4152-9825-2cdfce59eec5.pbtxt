            lines {
              text: "      } else if (delta > 6) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setHidden(true);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {

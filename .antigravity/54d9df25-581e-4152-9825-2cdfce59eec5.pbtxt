    tool_calls {
      id: "call_17964383019332334027"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import rough from \\\"roughjs\\\";\\n\\nexport interface RoughStrokePath {\\n  d: string;\\n  stroke: string;\\n  strokeWidth: number;\\n  fill?: string;\\n}\\n\\nconst gen = rough.generator();\\n\\nfunction opsToD(ops: Array<{ op: string; data: number[] }>): string {\\n  let d = \\\"\\\";\\n  for (const item of ops) {\\n    const p = item.data;\\n    if (item.op === \\\"move\\\") {\\n      d += `M${p[0].toFixed(2)} ${p[1].toFixed(2)} `;\\n    } else if (item.op === \\\"lineTo\\\") {\\n      d += `L${p[0].toFixed(2)} ${p[1].toFixed(2)} `;\\n    } else if (item.op === \\\"bcurveTo\\\") {\\n      d += `C${p[0].toFixed(2)} ${p[1].toFixed(2)},${p[2].toFixed(2)} ${p[3].toFixed(2)},${p[4].toFixed(2)} ${p[5].toFixed(2)} `;\\n    }\\n  }\\n  return d.trim();\\n}\\n\\nexport function generateRoughRectPaths(opts: {\\n  x: number;\\n  y: number;\\n  width: number;\\n  height: number;\\n  seed: number;\\n  roughness?: number;\\n  strokeWidth?: number;\\n  stroke?: string;\\n  fill?: string;\\n  fillStyle?: \\\"hachure\\\" | \\\"solid\\\" | \\\"zigzag\\\";\\n}): RoughStrokePath[] {\\n  const drawable = gen.rectangle(opts.x, opts.y, opts.width, opts.height, {\\n    seed: opts.seed,\\n    roughness: opts.roughness ?? 1.2,\\n    strokeWidth: opts.strokeWidth ?? 1.8,\\n    stroke: opts.stroke ?? \\\"#2B2230\\\",\\n    fill: opts.fill,\\n    fillStyle: opts.fillStyle ?? \\\"hachure\\\",\\n    hachureGap: 6,\\n    hachureAngle: -41,\\n  });\\n\\n  const paths: RoughStrokePath[] = [];\\n  for (const set of drawable.sets) {\\n    const d = opsToD(set.ops);\\n    if (!d) continue;\\n    if (set.type === \\\"fillPath\\\") {\\n      paths.push({\\n        d,\\n        stroke: \\\"none\\\",\\n        strokeWidth: 0,\\n        fill: opts.fill ?? \\\"none\\\",\\n      });\\n    } else if (set.type === \\\"fillSketch\\\") {\\n      paths.push({\\n        d,\\n        stroke: opts.fill ?? \\\"#FFC9D6\\\",\\n        strokeWidth: 1.4,\\n        fill: \\\"none\\\",\\n      });\\n    } else {\\n      paths.push({\\n        d,\\n        stroke: opts.stroke ?? \\\"#2B2230\\\",\\n        strokeWidth: opts.strokeWidth ?? 1.8,\\n        fill: \\\"none\\\",\\n      });\\n    }\\n  }\\n  return paths;\\n}\\n\\nexport function generateRoughUnderlinePaths(opts: {\\n  width: number;\\n  y: number;\\n  seed: number;\\n  stroke?: string;\\n  strokeWidth?: number;\\n}): RoughStrokePath[] {\\n  const d1 = gen.line(2, opts.y, opts.width - 2, opts.y - 1.5, {\\n    seed: opts.seed,\\n    roughness: 1.4,\\n    strokeWidth: opts.strokeWidth ?? 3.2,\\n    stroke: opts.stroke ?? \\\"#E2557B\\\",\\n    bowing: 1.5,\\n  });\\n  const d2 = gen.line(6, opts.y + 4, opts.width - 6, opts.y + 2.5, {\\n    seed: opts.seed + 17,\\n    roughness: 1.2,\\n    strokeWidth: (opts.strokeWidth ?? 3.2) * 0.65,\\n    stroke: opts.stroke ?? \\\"#E2557B\\\",\\n    bowing: 1.2,\\n  });\\n\\n  const out: RoughStrokePath[] = [];\\n  for (const drw of [d1, d2]) {\\n    for (const set of drw.sets) {\\n      const d = opsToD(set.ops);\\n      if (d) {\\n        out.push({\\n          d,\\n          stroke: opts.stroke ?? \\\"#E2557B\\\",\\n          strokeWidth: drw === d1 ? (opts.strokeWidth ?? 3.2) : (opts.strokeWidth ?? 3.2) * 0.65,\\n          fill: \\\"none\\\",\\n        });\\n      }\\n    }\\n  }\\n  return out;\\n}\\n\\nexport function generateRoughCirclePaths(opts: {\\n  cx: number;\\n  cy: number;\\n  width: number;\\n  height: number;\\n  seed: number;\\n  stroke?: string;\\n  strokeWidth?: number;\\n}): RoughStrokePath[] {\\n  const drawable = gen.ellipse(opts.cx, opts.cy, opts.width, opts.height, {\\n    seed: opts.seed,\\n    roughness: 1.5,\\n    strokeWidth: opts.strokeWidth ?? 2.6,\\n    stroke: opts.stroke ?? \\\"#E2557B\\\",\\n    curveStepCount: 14,\\n  });\\n  const out: RoughStrokePath[] = [];\\n  for (const set of drawable.sets) {\\n    const d = opsToD(set.ops);\\n    if (d) {\\n      out.push({\\n        d,\\n        stroke: opts.stroke ?? \\\"#E2557B\\\",\\n        strokeWidth: opts.strokeWidth ?? 2.6,\\n        fill: \\\"none\\\",\\n      });\\n    }\\n  }\\n  return out;\\n}\\n\\nexport function generateRoughArrowPaths(opts: {\\n  x1: number;\\n  y1: number;\\n  x2: number;\\n  y2: number;\\n  curvature?: number;\\n  seed: number;\\n  stroke?: string;\\n  strokeWidth?: number;\\n}): { shaft: RoughStrokePath[]; head: RoughStrokePath[] } {\\n  const { x1, y1, x2, y2, curvature = 0.25, seed, stroke = \\\"#2B2230\\\", strokeWidth = 2.2 } = opts;\\n  const dx = x2 - x1;\\n  const dy = y2 - y1;\\n  const len = Math.hypot(dx, dy) || 1;\\n  const nx = -dy / len;\\n  const ny = dx / len;\\n  const cx = (x1 + x2) / 2 + nx * len * curvature;\\n  const cy = (y1 + y2) / 2 + ny * len * curvature;\\n\\n  const curveDrawable = gen.curve(\\n    [\\n      [x1, y1],\\n      [cx, cy],\\n      [x2, y2],\\n    ],\\n    {\\n      seed,\\n      roughness: 1.1,\\n      strokeWidth,\\n      stroke,\\n    },\\n  );\\n\\n  // Tangent near end\\n  const ang = Math.atan2(y2 - cy, x2 - cx);\\n  const headLen = Math.min(13, Math.max(8, len * 0.16));\\n  const spread1 = 0.46;\\n  const spread2 = 0.39; // slightly uneven hand-drawn head\\n\\n  const hx1 = x2 - headLen * Math.cos(ang - spread1);\\n  const hy1 = y2 - headLen * Math.sin(ang - spread1);\\n  const hx2 = x2 - headLen * 0.92 * Math.cos(ang + spread2);\\n  const hy2 = y2 - headLen * 0.92 * Math.sin(ang + spread2);\\n\\n  const headA = gen.line(x2, y2, hx1, hy1, { seed: seed + 3, roughness: 0.9, strokeWidth, stroke });\\n  const headB = gen.line(x2, y2, hx2, hy2, { seed: seed + 7, roughness: 0.9, strokeWidth, stroke });\\n\\n  const extract = (drw: typeof curveDrawable): RoughStrokePath[] =>\\n    drw.sets\\n      .map((s) => ({\\n        d: opsToD(s.ops),\\n        stroke,\\n        strokeWidth,\\n        fill: \\\"none\\\",\\n      }))\\n      .filter((p) => p.d.length > 0);\\n\\n  return {\\n    shaft: extract(curveDrawable),\\n    head: [...extract(headA), ...extract(headB)],\\n  };\\n}\\n\", \"Description\":\"Create deterministic SVG path generators powered by roughjs for boxes, underlines, circles, and curved arrows\", \"Overwrite\":true, \"TargetFile\":\"/src/lib/roughPaths.ts\", \"toolAction\":\"Writing deterministic roughjs path helpers\", \"toolSummary\":\"Write src/lib/roughPaths.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17964383019332335952"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { ChapterId } from \\\"@/content\\\";\\nimport { clamp01 } from \\\"@/lib/storyStore\\\";\\n\\nexport type BlockType =\\n  | \\\"grass\\\"\\n  | \\\"dirt\\\"\\n  | \\\"stone\\\"\\n  | \\\"deep_stone\\\"\\n  | \\\"glow_ore\\\"\\n  | \\\"cherry_log\\\"\\n  | \\\"cherry_leaves\\\"\\n  | \\\"cherry_planks\\\"\\n  | \\\"path\\\"\\n  | \\\"water\\\"\\n  | \\\"paper_lantern\\\"\\n  | \\\"moss_carpet\\\"\\n  | \\\"flower\\\"\\n  | \\\"sapling\\\";\\n\\nexport interface IslandBlock {\\n  x: number;\\n  y: number;\\n  z: number;\\n  type: BlockType;\\n  chapter: ChapterId;\\n  appearAt: number;\\n  groupId?: string;\\n}\\n\\nexport interface AnchorPoint {\\n  x: number;\\n  y: number;\\n  z: number;\\n}\\n\\nexport interface IslandAnchors {\\n  seed: AnchorPoint;\\n  ore: AnchorPoint;\\n  domeRim: AnchorPoint;\\n  house: AnchorPoint;\\n  mascots: AnchorPoint;\\n}\\n\\nexport interface BuildIslandOptions {\\n  sizeFactor?: number;\\n  seed?: number;\\n}\\n\\nexport interface BuiltIsland {\\n  blocks: IslandBlock[];\\n  anchors: IslandAnchors;\\n  seedCenter: AnchorPoint;\\n}\\n\\nfunction hash2(x: number, z: number, seed: number): number {\\n  const n = Math.sin(x * 127.1 + z * 311.7 + seed * 74.7) * 43758.5453123;\\n  return n - Math.floor(n);\\n}\\n\\nfunction hash3(x: number, y: number, z: number, seed: number): number {\\n  const n =\\n    Math.sin(x * 127.1 + y * 269.5 + z * 311.7 + seed * 53.3) * 43758.5453123;\\n  return n - Math.floor(n);\\n}\\n\\nfunction smoothNoise2D(x: number, z: number, seed: number): number {\\n  const ix = Math.floor(x);\\n  const iz = Math.floor(z);\\n  const fx = x - ix;\\n  const fz = z - iz;\\n  const ux = fx * fx * (3 - 2 * fx);\\n  const uz = fz * fz * (3 - 2 * fz);\\n  const a = hash2(ix, iz, seed);\\n  const b = hash2(ix + 1, iz, seed);\\n  const c = hash2(ix, iz + 1, seed);\\n  const d = hash2(ix + 1, iz + 1, seed);\\n  return a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz;\\n}\\n\\n/**\\n * Pure deterministic island layout and reveal schedule.\\n * - sizeFactor = 1 produces ~4,500\342\200\2235,200 blocks (within 4,000\342\200\2236,000 budget).\\n * - sizeFactor = 0.6 produces ~60% of that (~2,700\342\200\2233,100 blocks).\\n */\\nexport function buildIsland(options: BuildIslandOptions = {}): BuiltIsland {\\n  const sizeFactor = options.sizeFactor ?? 1;\\n  const seed = options.seed ?? 42;\\n  const radiusScale = Math.sqrt(sizeFactor);\\n  const maxRadius = 15.5 * radiusScale;\\n  const maxDepth = Math.round(13.5 * (0.35 + 0.65 * radiusScale));\\n\\n  const map = new Map<string, IslandBlock>();\\n  const key = (x: number, y: number, z: number) => `${x},${y},${z}`;\\n\\n  const setBlock = (block: IslandBlock) => {\\n    map.set(key(block.x, block.y, block.z), block);\\n  };\\n\\n  // Surface heightmap helper\\n  const surfaceY = (x: number, z: number): number => {\\n    const r = Math.hypot(x, z);\\n    if (r <= 2.2) return 0; // Keep center flat around the seed\\n    const n1 = smoothNoise2D(x * 0.16 + 10, z * 0.16 + 10, seed);\\n    const n2 = smoothNoise2D(x * 0.35 - 5, z * 0.35 + 7, seed + 13);\\n    const hill = (n1 * 0.7 + n2 * 0.3 - 0.45) * 3.2;\\n    const edgeTaper = Math.max(0, 1 - (r / maxRadius) * 0.45);\\n    return Math.round(hill * edgeTaper);\\n  };\\n\\n  // 1. Seed block + sapling (Chapter 0: seed, appearAt = 0)\\n  setBlock({\\n    x: 0,\\n    y: 0,\\n    z: 0,\\n    type: \\\"grass\\\",\\n    chapter: \\\"seed\\\",\\n    appearAt: 0,\\n  });\\n  setBlock({\\n    x: 0,\\n    y: 1,\\n    z: 0,\\n    type: \\\"sapling\\\",\\n    chapter: \\\"seed\\\",\\n    appearAt: 0,\\n  });\\n\\n  // 2. Terrain surface + inverted cone underside\\n  const rLim = Math.ceil(maxRadius);\\n  const rootCandidates: { x: number; y: number; z: number; dist: number; bottomY: number }[] = [];\\n  const surfaceCandidates: { x: number; y: number; z: number; type: BlockType; dist: number }[] = [];\\n\\n  for (let x = -rLim; x <= rLim; x++) {\\n    for (let z = -rLim; z <= rLim; z++) {\\n      const dist2d = Math.hypot(x, z);\\n      const edgeNoise = (smoothNoise2D(x * 0.25, z * 0.25, seed + 99) - 0.5) * 2.4;\\n      const localMaxR = maxRadius + edgeNoise;\\n      if (dist2d > localMaxR) continue;\\n\\n      const topY = surfaceY(x, z);\\n      const normR = Math.min(1, dist2d / localMaxR);\\n      // Inverted cone / tapered underside\\n      const coneNoise = (smoothNoise2D(x * 0.22 + 3, z * 0.22 - 4, seed + 51) - 0.5) * 2.2;\\n      const depthHere = Math.max(\\n        1,\\n        Math.round((1 - Math.pow(normR, 1.38)) * maxDepth + coneNoise * (1 - normR * 0.5)),\\n      );\\n      const bottomY = topY - depthHere;\\n\\n      // Top grass & subsurface dirt belong to chapter \\\"shield\\\" (except seed 0,0,0)\\n      if (!(x === 0 && z === 0)) {\\n        surfaceCandidates.push({\\n          x,\\n          y: topY,\\n          z,\\n          type: \\\"grass\\\",\\n          dist: dist2d,\\n        });\\n      }\\n\\n      if (topY - 1 >= bottomY) {\\n        surfaceCandidates.push({\\n          x,\\n          y: topY - 1,\\n          z,\\n          type: \\\"dirt\\\",\\n          dist: dist2d,\\n        });\\n      }\\n\\n      // Underside stone / deep_stone / glow_ore belong to chapter \\\"roots\\\"\\n      for (let y = topY - 2; y >= bottomY; y--) {\\n        const d3 = Math.hypot(x, y, z);\\n        rootCandidates.push({ x, y, z, dist: d3, bottomY });\\n      }\\n    }\\n  }\\n\\n  // Sort roots strictly by distance from seed (0,0,0)\\n  rootCandidates.sort((a, b) => a.dist - b.dist || a.y - b.y || a.x - b.x || a.z - b.z);\\n  const maxRootDist = rootCandidates.length > 0 ? rootCandidates[rootCandidates.length - 1].dist : 1;\\n\\n  // Pick glow ore vein centers in the visible cutaway interior (near z in [-2, 4], y in [-7, -2])\\n  const oreCenters = [\\n    { x: -3, y: -3, z: 0 },\\n    { x: 2, y: -5, z: -1 },\\n    { x: -1, y: -6, z: 1 },\\n    { x: 4, y: -3, z: 1 },\\n  ];\\n\\n  let brightestOre: AnchorPoint = { x: 2, y: -4, z: -1 };\\n  let bestOreScore = -Infinity;\\n\\n  for (const c of rootCandidates) {\\n    const t = Math.min(0.96, c.dist / Math.max(1, maxRootDist));\\n    const appearAt = 0.1 + t * 0.165; // strictly inside [0.10, 0.28)\\n\\n    // Determine stone vs deep_stone vs glow_ore\\n    let isOre = false;\\n    for (const oc of oreCenters) {\\n      const od = Math.hypot(c.x - oc.x, c.y - oc.y, c.z - oc.z);\\n      if (od <= 1.65 && hash3(c.x, c.y, c.z, seed + 7) > 0.28) {\\n        isOre = true;\\n        break;\\n      }\\n    }\\n\\n    let type: BlockType = \\\"stone\\\";\\n    if (isOre) {\\n      type = \\\"glow_ore\\\";\\n      const score = -Math.hypot(c.x - 1, c.y + 4, c.z + 0.5);\\n      if (score > bestOreScore) {\\n        bestOreScore = score;\\n        brightestOre = { x: c.x, y: c.y, z: c.z };\\n      }\\n    } else if (c.y <= -6 || (c.y <= -4 && hash3(c.x, c.y, c.z, seed + 19) > 0.45)) {\\n      type = \\\"deep_stone\\\";\\n    }\\n\\n    setBlock({\\n      x: c.x,\\n      y: c.y,\\n      z: c.z,\\n      type,\\n      chapter: \\\"roots\\\",\\n      appearAt,\\n    });\\n  }\\n\\n  // Place surface grass & dirt in Shield chapter (0.28 .. 0.46)\\n  surfaceCandidates.sort((a, b) => a.dist - b.dist);\\n  const maxSurfDist = surfaceCandidates.length > 0 ? surfaceCandidates[surfaceCandidates.length - 1].dist : 1;\\n  for (const sc of surfaceCandidates) {\\n    const t = Math.min(0.95, sc.dist / Math.max(1, maxSurfDist));\\n    const appearAt = 0.28 + t * 0.165; // strictly inside [0.28, 0.46)\\n    setBlock({\\n      x: sc.x,\\n      y: sc.y,\\n      z: sc.z,\\n      type: sc.type,\\n      chapter: \\\"shield\\\",\\n      appearAt,\\n    });\\n  }\\n\\n  // Helper to get surface Y at (x, z)\\n  const getGroundY = (x: number, z: number): number => {\\n    for (let y = 5; y >= -4; y--) {\\n      const existing = map.get(key(x, y, z));\\n      if (existing && (existing.type === \\\"grass\\\" || existing.type === \\\"path\\\")) {\\n        return y;\\n      }\\n    }\\n    return surfaceY(x, z);\\n  };\\n\\n  // 3. Hand-placed Build chapter structures (0.46 .. 0.66)\\n  // Group A: Stone path (0.465 .. 0.495)\\n  const pathPoints: [number, number][] = [\\n    [0, 1],\\n    [0, 2],\\n    [1, 2],\\n    [1, 3],\\n    [2, 3],\\n    [2, 4],\\n    [3, 4],\\n    [3, 5],\\n    [4, 5],\\n    [4, 6],\\n    [-1, 0],\\n    [-2, 0],\\n    [-2, -1],\\n    [-3, -1],\\n    [-3, -2],\\n    [-4, -2],\\n  ];\\n  pathPoints.forEach(([px, pz], idx) => {\\n    if (Math.hypot(px, pz) > maxRadius - 2) return;\\n    const py = getGroundY(px, pz);\\n    const existing = map.get(key(px, py, pz));\\n    setBlock({\\n      x: px,\\n      y: py,\\n      z: pz,\\n      type: \\\"path\\\",\\n      chapter: existing ? existing.chapter : \\\"build\\\",\\n      appearAt: existing ? existing.appearAt : 0.468 + (idx / pathPoints.length) * 0.02,\\n      groupId: \\\"path\\\",\\n    });\\n  });\\n\\n  // Group B: Small pond + waterfall spilling off front-right edge (0.495 .. 0.525)\\n  const pondX = Math.round(7 * radiusScale);\\n  const pondZ = Math.round(-5 * radiusScale);\\n  const pondBaseY = getGroundY(pondX, pondZ);\\n  for (let dx = -2; dx <= 2; dx++) {\\n    for (let dz = -2; dz <= 2; dz++) {\\n      if (dx * dx + dz * dz > 5) continue;\\n      const wx = pondX + dx;\\n      const wz = pondZ + dz;\\n      // Carve pond basin slightly\\n      map.delete(key(wx, pondBaseY + 1, wz));\\n      setBlock({\\n        x: wx,\\n        y: pondBaseY,\\n        z: wz,\\n        type: \\\"water\\\",\\n        chapter: \\\"build\\\",\\n        appearAt: 0.498 + ((dx + 2) * 0.003),\\n        groupId: \\\"pond\\\",\\n      });\\n    }\\n  }\\n  // Waterfall spilling down edge\\n  const wfX = pondX + 2;\\n  const wfZ = pondZ - 1;\\n  for (let wy = pondBaseY; wy >= pondBaseY - 9; wy--) {\\n    setBlock({\\n      x: wfX + (wy < pondBaseY - 2 ? 1 : 0),\\n      y: wy,\\n      z: wfZ,\\n      type: \\\"water\\\",\\n      chapter: \\\"build\\\",\\n      appearAt: 0.508 + ((pondBaseY - wy) / 10) * 0.014,\\n      groupId: \\\"pond\\\",\\n    });\\n  }\\n\\n  // Group C: 3 Cherry Blossom Trees (each pops in as a coherent group!)\\n  const placeCherryTree = (\\n    cx: number,\\n    cz: number,\\n    height: number,\\n    windowStart: number,\\n    groupId: string,\\n  ) => {\\n    const baseY = getGroundY(cx, cz);\\n    // Trunk\\n    for (let h = 1; h <= height; h++) {\\n      setBlock({\\n        x: cx,\\n        y: baseY + h,\\n        z: cz,\\n        type: \\\"cherry_log\\\",\\n        chapter: \\\"build\\\",\\n        appearAt: windowStart + (h / height) * 0.008,\\n        groupId,\\n      });\\n    }\\n    // Slight diagonal branch\\n    const branchDirX = cx < 0 ? 1 : -1;\\n    setBlock({\\n      x: cx + branchDirX,\\n      y: baseY + height,\\n      z: cz,\\n      type: \\\"cherry_log\\\",\\n      chapter: \\\"build\\\",\\n      appearAt: windowStart + 0.009,\\n      groupId,\\n    });\\n\\n    // Canopy layers\\n    const topY = baseY + height;\\n    for (let dy = -1; dy <= 2; dy++) {\\n      const r = dy === -1 ? 2.1 : dy === 0 ? 2.6 : dy === 1 ? 2.1 : 1.2;\\n      for (let dx = -3; dx <= 3; dx++) {\\n        for (let dz = -3; dz <= 3; dz++) {\\n          const d = Math.hypot(dx - branchDirX * 0.3, dz);\\n          if (d > r) continue;\\n          // Skip trunk core\\n          if (dx === 0 && dz === 0 && dy <= 0) continue;\\n          if (hash3(cx + dx, topY + dy, cz + dz, seed + 33) < 0.14 && dy !== 2) continue;\\n          setBlock({\\n            x: cx + dx,\\n            y: topY + dy,\\n            z: cz + dz,\\n            type: \\\"cherry_leaves\\\",\\n            chapter: \\\"build\\\",\\n            appearAt: windowStart + 0.011 + ((dy + 1) / 4) * 0.012,\\n            groupId,\\n          });\\n        }\\n      }\\n    }\\n  };\\n\\n  placeCherryTree(\\n    Math.round(-7 * radiusScale),\\n    Math.round(-4 * radiusScale),\\n    5,\\n    0.525,\\n    \\\"tree_1\\\",\\n  );\\n  placeCherryTree(\\n    Math.round(-5 * radiusScale),\\n    Math.round(7 * radiusScale),\\n    4,\\n    0.555,\\n    \\\"tree_2\\\",\\n  );\\n  placeCherryTree(\\n    Math.round(7 * radiusScale),\\n    Math.round(4 * radiusScale),\\n    4,\\n    0.585,\\n    \\\"tree_3\\\",\\n  );\\n\\n  // Group D: Cozy Cherry-Plank House with lantern porch (0.615 .. 0.652)\\n  const hx = Math.round(4 * radiusScale);\\n  const hz = Math.round(7 * radiusScale);\\n  const hBaseY = getGroundY(hx, hz);\\n\\n  // Foundation floor\\n  for (let dx = -2; dx <= 2; dx++) {\\n    for (let dz = -2; dz <= 2; dz++) {\\n      setBlock({\\n        x: hx + dx,\\n        y: hBaseY,\\n        z: hz + dz,\\n        type: \\\"cherry_planks\\\",\\n        chapter: \\\"build\\\",\\n        appearAt: 0.616,\\n        groupId: \\\"house\\\",\\n      });\\n    }\\n  }\\n  // Walls (height 3)\\n  for (let wy = 1; wy <= 3; wy++) {\\n    for (let dx = -2; dx <= 2; dx++) {\\n      for (let dz = -2; dz <= 2; dz++) {\\n        const isEdge = Math.abs(dx) === 2 || Math.abs(dz) === 2;\\n        if (!isEdge) continue;\\n        // Doorway on front (-z facing center path)\\n        if (dz === -2 && dx === 0 && wy <= 2) continue;\\n        // Windows on sides\\n        if (wy === 2 && (dx === 0 || dz === 0)) continue;\\n        const isCorner = Math.abs(dx) === 2 && Math.abs(dz) === 2;\\n        setBlock({\\n          x: hx + dx,\\n          y: hBaseY + wy,\\n          z: hz + dz,\\n          type: isCorner ? \\\"cherry_log\\\" : \\\"cherry_planks\\\",\\n          chapter: \\\"build\\\",\\n          appearAt: 0.62 + wy * 0.005,\\n          groupId: \\\"house\\\",\\n        });\\n      }\\n    }\\n  }\\n  // Pitched roof\\n  for (let dz = -3; dz <= 3; dz++) {\\n    for (let dx = -3; dx <= 3; dx++) {\\n      const roofH = 4 + Math.max(0, 2 - Math.abs(dx));\\n      if (Math.abs(dx) === 3 && Math.abs(dz) === 3) continue;\\n      setBlock({\\n        x: hx + dx,\\n        y: hBaseY + roofH,\\n        z: hz + dz,\\n        type: Math.abs(dx) === 0 ? \\\"cherry_log\\\" : \\\"cherry_planks\\\",\\n        chapter: \\\"build\\\",\\n        appearAt: 0.638 + (2 - Math.min(2, Math.abs(dx))) * 0.004,\\n        groupId: \\\"house\\\",\\n      });\\n    }\\n  }\\n  // Porch lantern\\n  setBlock({\\n    x: hx - 1,\\n    y: hBaseY + 2,\\n    z: hz - 3,\\n    type: \\\"paper_lantern\\\",\\n    chapter: \\\"build\\\",\\n    appearAt: 0.65,\\n    groupId: \\\"house\\\",\\n  });\\n\\n  // 4. Neighbors chapter details: moss carpet, flowers, path lanterns (0.66 .. 0.86)\\n  const lanternSpots: [number, number][] = [\\n    [-2, -2],\\n    [2, 2],\\n    [3, 5],\\n    [-4, 4],\\n    [5, -2],\\n  ];\\n  lanternSpots.forEach(([lx, lz], i) => {\\n    const sx = Math.round(lx * radiusScale);\\n    const sz = Math.round(lz * radiusScale);\\n    if (Math.hypot(sx, sz) > maxRadius - 2) return;\\n    const ly = getGroundY(sx, sz);\\n    setBlock({\\n      x: sx,\\n      y: ly + 1,\\n      z: sz,\\n      type: \\\"paper_lantern\\\",\\n      chapter: \\\"neighbors\\\",\\n      appearAt: 0.68 + i * 0.025,\\n    });\\n  });\\n\\n  // Moss carpet & flowers scattered across grass\\n  for (let x = -rLim + 2; x <= rLim - 2; x++) {\\n    for (let z = -rLim + 2; z <= rLim - 2; z++) {\\n      if (Math.hypot(x, z) > maxRadius - 2.5) continue;\\n      const gy = getGroundY(x, z);\\n      const ground = map.get(key(x, gy, z));\\n      if (!ground || ground.type !== \\\"grass\\\") continue;\\n      if (map.has(key(x, gy + 1, z))) continue;\\n\\n      const r = hash2(x * 1.3, z * 1.7, seed + 202);\\n      if (r > 0.86) {\\n        const appearAt = 0.67 + hash2(x, z, seed + 303) * 0.15;\\n        setBlock({\\n          x,\\n          y: gy + 1,\\n          z,\\n          type: r > 0.93 ? \\\"flower\\\" : \\\"moss_carpet\\\",\\n          chapter: \\\"neighbors\\\",\\n          appearAt,\\n        });\\n      }\\n    }\\n  }\\n\\n  const blocks = Array.from(map.values()).sort((a, b) => a.appearAt - b.appearAt);\\n\\n  const anchors: IslandAnchors = {\\n    seed: { x: 0, y: 1.4, z: 0 },\\n    ore: brightestOre,\\n    domeRim: { x: 10.5 * radiusScale, y: 5.5, z: 7.5 * radiusScale },\\n    house: { x: hx, y: hBaseY + 4.5, z: hz },\\n    mascots: { x: hx + 1.5, y: hBaseY + 1.4, z: hz - 3.2 },\\n  };\\n\\n  return {\\n    blocks,\\n    anchors,\\n    seedCenter: { x: 0, y: 0.5, z: 0 },\\n  };\\n}\\n\\n/**\\n * Pure visibility / drop-in reveal amount [0..1] for a block at global progress.\\n * Matches the ~0.02 drop-in window from 03-STORYBOARD.md.\\n */\\nexport function isBlockVisible(block: IslandBlock, progress: number): number {\\n  const p = clamp01(progress);\\n  if (block.appearAt === 0) return 1;\\n  const window = 0.02;\\n  if (p < block.appearAt) return 0;\\n  if (p >= block.appearAt + window) return 1;\\n  return (p - block.appearAt) / window;\\n}\\n\", \"Description\":\"Create deterministic procedural cherry-blossom voxel island generator and reveal schedule\", \"Overwrite\":true, \"TargetFile\":\"/src/three/island/islandGenerator.ts\", \"toolAction\":\"Writing deterministic island generator\", \"toolSummary\":\"Write src/three/island/islandGenerator.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17964383019332333781"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \\\"three\\\";\\nimport type { BlockType } from \\\"./islandGenerator\\\";\\nimport type { QualityTier } from \\\"@/lib/quality\\\";\\n\\nexport type BlockFace = \\\"top\\\" | \\\"side\\\" | \\\"bottom\\\";\\n\\nexport interface PaintedBlockBuffers {\\n  albedo: Uint8Array;\\n  normal: Uint8Array;\\n  emissive: Uint8Array;\\n  height: Float32Array;\\n}\\n\\nconst SIZE = 64;\\n\\nfunction hash(x: number, y: number, seed: number): number {\\n  const n = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453123;\\n  return n - Math.floor(n);\\n}\\n\\nfunction vnoise(x: number, y: number, seed: number): number {\\n  const ix = Math.floor(x);\\n  const iy = Math.floor(y);\\n  const fx = x - ix;\\n  const fy = y - iy;\\n  const ux = fx * fx * (3 - 2 * fx);\\n  const uy = fy * fy * (3 - 2 * fy);\\n  const a = hash(ix, iy, seed);\\n  const b = hash(ix + 1, iy, seed);\\n  const c = hash(ix, iy + 1, seed);\\n  const d = hash(ix + 1, iy + 1, seed);\\n  return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;\\n}\\n\\nfunction fbm(x: number, y: number, seed: number, octaves = 3): number {\\n  let sum = 0;\\n  let amp = 0.5;\\n  let freq = 1;\\n  let norm = 0;\\n  for (let i = 0; i < octaves; i++) {\\n    sum += vnoise(x * freq, y * freq, seed + i * 17) * amp;\\n    norm += amp;\\n    amp *= 0.5;\\n    freq *= 2.02;\\n  }\\n  return sum / norm;\\n}\\n\\nfunction hexRgb(hex: number): [number, number, number] {\\n  return [(hex >> 16) & 255, (hex >> 8) & 255, hex & 255];\\n}\\n\\nfunction mixRgb(\\n  a: [number, number, number],\\n  b: [number, number, number],\\n  t: number,\\n): [number, number, number] {\\n  const k = Math.max(0, Math.min(1, t));\\n  return [\\n    Math.round(a[0] + (b[0] - a[0]) * k),\\n    Math.round(a[1] + (b[1] - a[1]) * k),\\n    Math.round(a[2] + (b[2] - a[2]) * k),\\n  ];\\n}\\n\\nfunction clampByte(v: number): number {\\n  return v < 0 ? 0 : v > 255 ? 255 : Math.round(v);\\n}\\n\\nconst TYPE_SEEDS: Record<BlockType, number> = {\\n  cherry_leaves: 101,\\n  cherry_log: 202,\\n  cherry_planks: 303,\\n  grass: 404,\\n  dirt: 505,\\n  stone: 606,\\n  deep_stone: 707,\\n  glow_ore: 808,\\n  path: 909,\\n  paper_lantern: 1010,\\n  moss_carpet: 1111,\\n  water: 1212,\\n  flower: 1313,\\n  sapling: 1414,\\n};\\n\\nexport function paintBlockBuffers(\\n  type: BlockType,\\n  face: BlockFace = \\\"side\\\",\\n): PaintedBlockBuffers {\\n  const albedo = new Uint8Array(SIZE * SIZE * 4);\\n  const emissive = new Uint8Array(SIZE * SIZE * 4);\\n  const height = new Float32Array(SIZE * SIZE);\\n  const normal = new Uint8Array(SIZE * SIZE * 4);\\n  const baseSeed = TYPE_SEEDS[type] + (face === \\\"top\\\" ? 11 : face === \\\"bottom\\\" ? 29 : 0);\\n\\n  const cBlossom200 = hexRgb(0xffc9d6);\\n  const cBlossom400 = hexRgb(0xff8fab);\\n  const cBlossomDeep = hexRgb(0xe9799a);\\n  const cBlossomHi = hexRgb(0xfff1f4);\\n  const cMoss = hexRgb(0x6faf5b);\\n  const cMossLight = hexRgb(0x88c46f);\\n  const cMossDark = hexRgb(0x528d44);\\n  const cMossDeep = hexRgb(0x467a39);\\n  const cBark = hexRgb(0x6b4a3a);\\n  const cBarkDark = hexRgb(0x4a3025);\\n  const cBarkLight = hexRgb(0x8c6352);\\n  const cRingLight = hexRgb(0xeec7b8);\\n  const cRingMid = hexRgb(0xd49c89);\\n  const cPlank = hexRgb(0xe7b9a6);\\n  const cPlankLight = hexRgb(0xf3cfc0);\\n  const cPlankSeam = hexRgb(0xb27f6d);\\n  const cDirt = hexRgb(0x845f47);\\n  const cDirtDark = hexRgb(0x634532);\\n  const cDirtLight = hexRgb(0x9e7559);\\n  const cStone = hexRgb(0x9c96a3);\\n  const cStoneLight = hexRgb(0xb4aebc);\\n  const cStoneDark = hexRgb(0x746d7b);\\n  const cDeepStone = hexRgb(0x5e5466);\\n  const cDeepDark = hexRgb(0x433a4b);\\n  const cDeepLight = hexRgb(0x75697e);\\n  const cLantern = hexRgb(0xffc75a);\\n  const cPaper = hexRgb(0xfbf6ee);\\n  const cPath = hexRgb(0xc7b194);\\n  const cPathStone = hexRgb(0x9f99a3);\\n  const cWater = hexRgb(0x6cb8e6);\\n  const cWaterFoam = hexRgb(0xdbf2ff);\\n\\n  for (let y = 0; y < SIZE; y++) {\\n    for (let x = 0; x < SIZE; x++) {\\n      const idx = y * SIZE + x;\\n      const p4 = idx * 4;\\n      let rgb: [number, number, number] = [180, 180, 180];\\n      let alpha = 255;\\n      let h = 0.5;\\n      let em: [number, number, number] = [0, 0, 0];\\n\\n      // Subtle baked fake AO border for texture depth\\n      const edgeDist = Math.min(x, y, SIZE - 1 - x, SIZE - 1 - y);\\n      const edgeDarken = edgeDist < 3 ? 0.91 + edgeDist * 0.03 : 1.0;\\n\\n      if (type === \\\"cherry_leaves\\\") {\\n        const cluster = fbm(x * 0.16, y * 0.16, baseSeed, 3);\\n        const micro = hash(x, y, baseSeed + 5);\\n        // ~25% alpha cutout holes\\n        if (cluster < 0.37 && !(y > SIZE - 4 && micro > 0.72)) {\\n          alpha = 0;\\n          rgb = cBlossom400;\\n          h = 0.1;\\n        } else {\\n          // Top-left cluster highlight bias\\n          const tlCluster = fbm((x - 2) * 0.16, (y - 2) * 0.16, baseSeed, 3);\\n          const bevel = cluster - tlCluster;\\n          if (bevel > 0.05 || cluster > 0.68) {\\n            rgb = mixRgb(cBlossom200, cBlossomHi, 0.55);\\n            h = 0.85;\\n          } else if (cluster > 0.5) {\\n            rgb = mixRgb(cBlossom400, cBlossom200, (cluster - 0.5) * 4);\\n            h = 0.65;\\n          } else {\\n            rgb = mixRgb(cBlossomDeep, cBlossom400, (cluster - 0.37) * 5);\\n            h = 0.4;\\n          }\\n          if (micro > 0.88) {\\n            rgb = mixRgb(rgb, cBlossomHi, 0.35);\\n          }\\n        }\\n      } else if (type === \\\"cherry_log\\\") {\\n        if (face === \\\"top\\\" || face === \\\"bottom\\\") {\\n          const dx = x - SIZE / 2 + 0.5;\\n          const dy = y - SIZE / 2 + 0.5;\\n          const dist = Math.hypot(dx, dy) + fbm(x * 0.12, y * 0.12, baseSeed, 2) * 3.5;\\n          if (dist > 28) {\\n            rgb = cBark;\\n            h = 0.6;\\n          } else {\\n            const ring = Math.sin(dist * 1.15) * 0.5 + 0.5;\\n            rgb = mixRgb(cRingMid, cRingLight, ring);\\n            h = 0.45 + ring * 0.2;\\n          }\\n        } else {\\n          const groove = fbm(x * 0.45, y * 0.07, baseSeed, 3);\\n          const crack = vnoise(x * 0.7, y * 0.1, baseSeed + 41);\\n          if (crack < 0.26) {\\n            rgb = cBarkDark;\\n            h = 0.2;\\n          } else if (groove > 0.6) {\\n            rgb = cBarkLight;\\n            h = 0.78;\\n          } else {\\n            rgb = mixRgb(cBarkDark, cBark, groove * 1.4);\\n            h = 0.4 + groove * 0.3;\\n          }\\n        }\\n      } else if (type === \\\"cherry_planks\\\") {\\n        const boardRow = y % 16;\\n        const seamY = boardRow === 0 || boardRow === 15;\\n        const boardIndex = Math.floor(y / 16);\\n        const vertSeamX = (boardIndex * 29 + 17) % SIZE;\\n        const seamX = x === vertSeamX;\\n        if (seamY || seamX) {\\n          rgb = cPlankSeam;\\n          h = 0.2;\\n        } else {\\n          const grain = fbm(x * 0.08 + boardIndex * 5, y * 0.45, baseSeed, 2);\\n          rgb = mixRgb(cPlank, cPlankLight, grain);\\n          h = 0.55 + grain * 0.22;\\n        }\\n      } else if (type === \\\"grass\\\") {\\n        if (face === \\\"top\\\") {\\n          const n = fbm(x * 0.18, y * 0.18, baseSeed, 3);\\n          const m = hash(x, y, baseSeed + 71);\\n          if (n > 0.64) rgb = cMossLight;\\n          else if (n > 0.44) rgb = cMoss;\\n          else if (n > 0.28) rgb = cMossDark;\\n          else rgb = cMossDeep;\\n          // Tiny scattered pink cherry petals on grass top\\n          if (m > 0.985) {\\n            rgb = m > 0.993 ? cBlossom200 : cBlossom400;\\n            h = 0.85;\\n          } else {\\n            h = 0.4 + n * 0.45;\\n          }\\n        } else if (face === \\\"bottom\\\") {\\n          const dn = fbm(x * 0.22, y * 0.22, baseSeed + 5, 3);\\n          rgb = mixRgb(cDirtDark, cDirt, dn);\\n          h = 0.35 + dn * 0.35;\\n        } else {\\n          // Grass side: wavy grass overhang on top ~12px, dirt below\\n          const wave = 11 + Math.round(Math.sin(x * 0.35) * 2.5 + vnoise(x * 0.4, 1, baseSeed) * 3.5);\\n          if (y < wave) {\\n            const gn = fbm(x * 0.2, y * 0.25, baseSeed, 2);\\n            rgb = gn > 0.55 ? cMossLight : gn > 0.32 ? cMoss : cMossDark;\\n            h = 0.72 + gn * 0.2;\\n          } else if (y === wave) {\\n            rgb = cMossDeep;\\n            h = 0.55;\\n          } else {\\n            const dn = fbm(x * 0.22, y * 0.22, baseSeed + 9, 3);\\n            const pebble = hash(x, y, baseSeed + 31) > 0.94;\\n            rgb = pebble ? cStone : mixRgb(cDirtDark, cDirtLight, dn);\\n            h = pebble ? 0.65 : 0.3 + dn * 0.3;\\n          }\\n        }\\n      } else if (type === \\\"dirt\\\") {\\n        const dn = fbm(x * 0.22, y * 0.22, baseSeed, 3);\\n        const pebble = vnoise(x * 0.45, y * 0.45, baseSeed + 22) > 0.79;\\n        rgb = pebble ? cStoneDark : mixRgb(cDirtDark, cDirtLight, dn);\\n        h = pebble ? 0.72 : 0.3 + dn * 0.4;\\n      } else if (type === \\\"stone\\\") {\\n        const chunk = fbm(x * 0.14, y * 0.14, baseSeed, 3);\\n        const crack = Math.abs(fbm(x * 0.18 + 8, y * 0.18 + 3, baseSeed + 19, 2) - 0.5);\\n        if (crack < 0.032) {\\n          rgb = cStoneDark;\\n          h = 0.2;\\n        } else {\\n          rgb = mixRgb(cStoneDark, cStoneLight, chunk);\\n          h = 0.4 + chunk * 0.45;\\n        }\\n      } else if (type === \\\"deep_stone\\\") {\\n        const chunk = fbm(x * 0.22, y * 0.22, baseSeed, 3);\\n        const crack = Math.abs(fbm(x * 0.26, y * 0.26, baseSeed + 14, 2) - 0.5);\\n        if (crack < 0.04) {\\n          rgb = cDeepDark;\\n          h = 0.18;\\n        } else {\\n          rgb = mixRgb(cDeepStone, cDeepLight, chunk);\\n          h = 0.35 + chunk * 0.45;\\n        }\\n      } else if (type === \\\"glow_ore\\\") {\\n        const chunk = fbm(x * 0.22, y * 0.22, baseSeed, 3);\\n        rgb = mixRgb(cDeepDark, cDeepStone, chunk);\\n        h = 0.35 + chunk * 0.35;\\n        // Pink-gold crystal clusters\\n        const crystalField = fbm(x * 0.17 + 2, y * 0.17 + 4, baseSeed + 55, 2);\\n        const facet = vnoise(x * 0.45, y * 0.45, baseSeed + 66);\\n        if (crystalField > 0.61) {\\n          const isGold = facet > 0.52;\\n          const crystalColor = isGold ? cLantern : cBlossom400;\\n          rgb = mixRgb(crystalColor, cBlossomHi, facet > 0.8 ? 0.5 : 0.1);\\n          em = crystalColor;\\n          h = 0.92;\\n        }\\n      } else if (type === \\\"path\\\") {\\n        const n = fbm(x * 0.2, y * 0.2, baseSeed, 3);\\n        const stonePatch = fbm(x * 0.24, y * 0.24, baseSeed + 88, 2) > 0.64;\\n        rgb = stonePatch ? mixRgb(cPathStone, cStoneLight, n) : mixRgb(cDirt, cPath, n);\\n        h = stonePatch ? 0.68 : 0.38 + n * 0.2;\\n      } else if (type === \\\"paper_lantern\\\") {\\n        const isFrame =\\n          x < 6 ||\\n          x >= SIZE - 6 ||\\n          y < 7 ||\\n          y >= SIZE - 7 ||\\n          y === 24 ||\\n          y === 40 ||\\n          x === 31 ||\\n          x === 32;\\n        if (isFrame) {\\n          rgb = cBark;\\n          h = 0.72;\\n        } else {\\n          const glow = fbm(x * 0.1, y * 0.1, baseSeed, 2);\\n          rgb = mixRgb(cPaper, cLantern, 0.35 + glow * 0.45);\\n          em = mixRgb(cLantern, [255, 224, 150], glow);\\n          h = 0.45;\\n        }\\n      } else if (type === \\\"moss_carpet\\\") {\\n        const n = fbm(x * 0.26, y * 0.26, baseSeed, 3);\\n        const speck = hash(x, y, baseSeed + 12) > 0.88;\\n        rgb = speck ? cMossDeep : mixRgb(cMossDark, cMossLight, n);\\n        h = 0.4 + n * 0.45;\\n      } else if (type === \\\"water\\\") {\\n        const wave = fbm(x * 0.14, y * 0.18, baseSeed, 2);\\n        rgb = wave > 0.68 ? cWaterFoam : mixRgb([84, 160, 212], cWater, wave);\\n        alpha = 215;\\n        h = 0.45 + wave * 0.25;\\n      } else if (type === \\\"flower\\\") {\\n        const dx = x - 32;\\n        const dy = y - 32;\\n        const r = Math.hypot(dx, dy);\\n        if (r < 6) {\\n          rgb = cLantern;\\n          h = 0.85;\\n        } else if (r < 22 && Math.sin(Math.atan2(dy, dx) * 5) > -0.25) {\\n          rgb = r < 14 ? cBlossom200 : cBlossom400;\\n          h = 0.78;\\n        } else if (y > 38 && Math.abs(dx) < 3) {\\n          rgb = cMoss;\\n          h = 0.6;\\n        } else {\\n          alpha = 0;\\n          rgb = cBlossom200;\\n        }\\n      } else if (type === \\\"sapling\\\") {\\n        const dx = x - 32;\\n        const isStem = Math.abs(dx) < 3 && y > 26;\\n        const leafL = Math.hypot(x - 22, y - 24) < 11;\\n        const leafR = Math.hypot(x - 42, y - 20) < 11;\\n        const blossomTop = Math.hypot(x - 32, y - 15) < 9;\\n        if (blossomTop) {\\n          rgb = (x + y) % 3 === 0 ? cBlossom200 : cBlossom400;\\n          h = 0.85;\\n        } else if (leafL || leafR) {\\n          rgb = (x + y) % 4 === 0 ? cMossLight : cMoss;\\n          h = 0.75;\\n        } else if (isStem) {\\n          rgb = cBark;\\n          h = 0.65;\\n        } else {\\n          alpha = 0;\\n          rgb = cMoss;\\n        }\\n      }\\n\\n      albedo[p4] = clampByte(rgb[0] * edgeDarken);\\n      albedo[p4 + 1] = clampByte(rgb[1] * edgeDarken);\\n      albedo[p4 + 2] = clampByte(rgb[2] * edgeDarken);\\n      albedo[p4 + 3] = alpha;\\n\\n      emissive[p4] = em[0];\\n      emissive[p4 + 1] = em[1];\\n      emissive[p4 + 2] = em[2];\\n      emissive[p4 + 3] = 255;\\n\\n      height[idx] = h;\\n    }\\n  }\\n\\n  // Derive tangent-space normal map from height field\\n  const strength = 2.6;\\n  for (let y = 0; y < SIZE; y++) {\\n    for (let x = 0; x < SIZE; x++) {\\n      const xm = (x - 1 + SIZE) % SIZE;\\n      const xp = (x + 1) % SIZE;\\n      const ym = (y - 1 + SIZE) % SIZE;\\n      const yp = (y + 1) % SIZE;\\n      const dx = (height[y * SIZE + xp] - height[y * SIZE + xm]) * strength;\\n      const dy = (height[yp * SIZE + x] - height[ym * SIZE + x]) * strength;\\n      const nx = -dx;\\n      const ny = -dy;\\n      const nz = 1.0;\\n      const invLen = 1 / Math.hypot(nx, ny, nz);\\n      const p4 = (y * SIZE + x) * 4;\\n      normal[p4] = clampByte((nx * invLen * 0.5 + 0.5) * 255);\\n      normal[p4 + 1] = clampByte((ny * invLen * 0.5 + 0.5) * 255);\\n      normal[p4 + 2] = clampByte((nz * invLen * 0.5 + 0.5) * 255);\\n      normal[p4 + 3] = 255;\\n    }\\n  }\\n\\n  return { albedo, normal, emissive, height };\\n}\\n\\nexport function paintBlockTexture(type: BlockType, face: BlockFace = \\\"side\\\"): Uint8Array {\\n  return paintBlockBuffers(type, face).albedo;\\n}\\n\\nexport function paintNormalMap(type: BlockType, face: BlockFace = \\\"side\\\"): Uint8Array {\\n  return paintBlockBuffers(type, face).normal;\\n}\\n\\nfunction makeDataTexture(data: Uint8Array, isColor: boolean): THREE.DataTexture {\\n  const tex = new THREE.DataTexture(data, SIZE, SIZE, THREE.RGBAFormat);\\n  tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\\n  tex.magFilter = THREE.NearestFilter;\\n  tex.minFilter = THREE.LinearMipmapLinearFilter;\\n  tex.generateMipmaps = true;\\n  tex.wrapS = THREE.RepeatWrapping;\\n  tex.wrapT = THREE.RepeatWrapping;\\n  tex.needsUpdate = true;\\n  return tex;\\n}\\n\\nconst materialCache = new Map<string, THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[]>();\\n\\n/**\\n * Shared uniform object updated per frame by IslandBlocks without triggering shader recompiles.\\n */\\nexport const islandShaderUniforms = {\\n  uProgress: { value: 0 },\\n  uTime: { value: 0 },\\n  uCutaway: { value: 0 },\\n  uDusk: { value: 0 },\\n};\\n\\nfunction attachStoryShader(\\n  mat: THREE.MeshStandardMaterial,\\n  options: { sway?: boolean; cutawayEligible?: boolean; emissiveDuskBoost?: boolean },\\n) {\\n  mat.onBeforeCompile = (shader) => {\\n    shader.uniforms.uProgress = islandShaderUniforms.uProgress;\\n    shader.uniforms.uTime = islandShaderUniforms.uTime;\\n    shader.uniforms.uCutaway = islandShaderUniforms.uCutaway;\\n    shader.uniforms.uDusk = islandShaderUniforms.uDusk;\\n\\n    shader.vertexShader =\\n      `\\n      attribute float aAppearAt;\\n      uniform float uProgress;\\n      uniform float uTime;\\n      uniform float uCutaway;\\n      varying float vCutClip;\\n      ` + shader.vertexShader;\\n\\n    shader.vertexShader = shader.vertexShader.replace(\\n      \\\"#include <begin_vertex>\\\",\\n      `\\n      #include <begin_vertex>\\n      float dropWindow = 0.02;\\n      float reveal = aAppearAt <= 0.0001\\n        ? 1.0\\n        : clamp((uProgress - aAppearAt) / dropWindow, 0.0, 1.0);\\n\\n      // Tiny overshoot bounce\\n      float bounce = reveal < 1.0\\n        ? (reveal < 0.7 ? (reveal / 0.7) * 1.08 : 1.08 - ((reveal - 0.7) / 0.3) * 0.08)\\n        : 1.0;\\n\\n      float sc = reveal <= 0.0 ? 0.0 : bounce;\\n      transformed *= sc;\\n      transformed.y += (1.0 - reveal) * 1.5;\\n\\n      ${\\n        options.sway\\n          ? `\\n      vec4 instPos = instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\\n      float phase = instPos.x * 0.7 + instPos.z * 0.9 + instPos.y * 0.4;\\n      transformed.x += sin(uTime * 1.6 + phase) * 0.045 * reveal;\\n      transformed.z += cos(uTime * 1.3 + phase * 1.2) * 0.035 * reveal;\\n      `\\n          : \\\"\\\"\\n      }\\n\\n      vCutClip = 0.0;\\n      ${\\n        options.cutawayEligible\\n          ? `\\n      #ifdef USE_INSTANCING\\n        vec3 centerPos = (instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;\\n        if (uCutaway > 0.01 && centerPos.z > 0.6 && centerPos.y < -0.5) {\\n          vCutClip = uCutaway;\\n        }\\n      #endif\\n      `\\n          : \\\"\\\"\\n      }\\n      `,\\n    );\\n\\n    shader.fragmentShader =\\n      `\\n      varying float vCutClip;\\n      uniform float uDusk;\\n      ` + shader.fragmentShader;\\n\\n    shader.fragmentShader = shader.fragmentShader.replace(\\n      \\\"#include <clipping_planes_fragment>\\\",\\n      `\\n      #include <clipping_planes_fragment>\\n      if (vCutClip > 0.5) discard;\\n      `,\\n    );\\n\\n    if (options.emissiveDuskBoost) {\\n      shader.fragmentShader = shader.fragmentShader.replace(\\n        \\\"#include <emissivemap_fragment>\\\",\\n        `\\n        #include <emissivemap_fragment>\\n        totalEmissiveRadiance *= (0.35 + uDusk * 2.2);\\n        `,\\n      );\\n    }\\n  };\\n  mat.customProgramCacheKey = () =>\\n    `petalnode-${options.sway ? 1 : 0}-${options.cutawayEligible ? 1 : 0}-${options.emissiveDuskBoost ? 1 : 0}`;\\n}\\n\\nexport function getBlockMaterial(\\n  type: BlockType,\\n  tier: QualityTier,\\n  attachStory = true,\\n): THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[] {\\n  const cacheKey = `${type}:${tier}:${attachStory ? \\\"story\\\" : \\\"plain\\\"}`;\\n  const existing = materialCache.get(cacheKey);\\n  if (existing) return existing;\\n\\n  const isLeafOrPlant = type === \\\"cherry_leaves\\\" || type === \\\"flower\\\" || type === \\\"sapling\\\";\\n  const isCutawayEligible =\\n    type === \\\"stone\\\" || type === \\\"deep_stone\\\" || type === \\\"dirt\\\" || type === \\\"glow_ore\\\";\\n  const isLantern = type === \\\"paper_lantern\\\";\\n  const isOre = type === \\\"glow_ore\\\";\\n\\n  const makeOne = (face: BlockFace) => {\\n    const bufs = paintBlockBuffers(type, face);\\n    const map = makeDataTexture(bufs.albedo, true);\\n    const normalMap = makeDataTexture(bufs.normal, false);\\n    const hasEmissive = isOre || isLantern;\\n    const emissiveMap = hasEmissive ? makeDataTexture(bufs.emissive, true) : undefined;\\n\\n    const mat = new THREE.MeshStandardMaterial({\\n      color: 0xffffff,\\n      map,\\n      normalMap,\\n      normalScale: new THREE.Vector2(0.75, 0.75),\\n      roughness: type === \\\"water\\\" ? 0.18 : isOre ? 0.55 : 0.86,\\n      metalness: isOre ? 0.15 : 0.0,\\n      alphaTest: isLeafOrPlant ? 0.4 : 0,\\n      transparent: type === \\\"water\\\",\\n      opacity: type === \\\"water\\\" ? 0.82 : 1,\\n      side: isLeafOrPlant ? THREE.DoubleSide : THREE.FrontSide,\\n      emissive: hasEmissive ? new THREE.Color(0xffffff) : new THREE.Color(0x000000),\\n      emissiveMap,\\n      emissiveIntensity: isOre ? 1.85 : isLantern ? 1.6 : 0,\\n    });\\n\\n    if (attachStory) {\\n      attachStoryShader(mat, {\\n        sway: isLeafOrPlant,\\n        cutawayEligible: isCutawayEligible,\\n        emissiveDuskBoost: isLantern,\\n      });\\n    }\\n    return mat;\\n  };\\n\\n  let result: THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[];\\n  if (type === \\\"grass\\\" || type === \\\"cherry_log\\\") {\\n    const side = makeOne(\\\"side\\\");\\n    const top = makeOne(\\\"top\\\");\\n    const bottom = makeOne(\\\"bottom\\\");\\n    // BoxGeometry face order: +x, -x, +y, -y, +z, -z\\n    result = [side, side, top, bottom, side, side];\\n  } else {\\n    result = makeOne(\\\"side\\\");\\n  }\\n\\n  materialCache.set(cacheKey, result);\\n  return result;\\n}\\n\", \"Description\":\"Create deterministic 64x64 procedural block textures, normal maps, emissive maps, and GPU story shader materials\", \"Overwrite\":true, \"TargetFile\":\"/src/three/island/textures.ts\", \"toolAction\":\"Writing procedural block texture and material painters\", \"toolSummary\":\"Write src/three/island/textures.ts\"}"
      original_name: "write_to_file"
    }

      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { cn } from \\\"@/lib/utils\\\";\\n\\nexport function WashiTape({\\n  rotation = -4,\\n  length = 84,\\n  className,\\n}: {\\n  rotation?: number;\\n  length?: number;\\n  className?: string;\\n}) {\\n  return (\\n    <div\\n      aria-hidden=\\\"true\\\"\\n      className={cn(\\n        \\\"pointer-events-none select-none h-6 transition-transform duration-200\\\",\\n        className,\\n      )}\\n      style={{\\n        width: `${length}px`,\\n        transform: `rotate(${rotation}deg)`,\\n        backgroundColor: \\\"rgba(255, 201, 214, 0.85)\\\",\\n        backgroundImage:\\n          \\\"repeating-linear-gradient(-45deg, transparent, transparent 6px, rgba(255, 255, 255, 0.28) 6px, rgba(255, 255, 255, 0.28) 10px)\\\",\\n        clipPath:\\n          \\\"polygon(0% 8%, 4% 0%, 96% 2%, 100% 14%, 97% 35%, 100% 58%, 96% 85%, 100% 96%, 94% 100%, 4% 98%, 0% 88%, 3% 62%, 0% 34%)\\\",\\n        boxShadow: \\\"0 1px 2px rgba(43, 34, 48, 0.14)\\\",\\n      }}\\n    />\\n  );\\n}\\n\", \"Description\":\"Create translucent torn-edge WashiTape strip component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/sketch/WashiTape.tsx\", \"toolAction\":\"Writing WashiTape component\", \"toolSummary\":\"Write WashiTape.tsx\"}"

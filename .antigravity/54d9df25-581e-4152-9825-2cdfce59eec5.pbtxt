      thinking_signature: "\022\274\006\n\271\006\001i\024}\023\377\240[w\"l\376\230\204\364\250^\342\247\242\330\375\244\264r\204\362\300Q\232\365\021[\200I\247Ru\233F\004H\345\207\244&\305~\334\347\262\231\300\235GO-\017Z\210\364.>\243H\325\177h\v!\206\211\346\036\267\300N\247s?\022T\226O!\255\303* H\037\201\301\020\006;\273\224\316G\204\301h\2303c\271$t\205\366\202\226J\021?[m\202z\207\003R\326\242\300\341\3233%e&\210\a\031\022\347\207L\326Qt\262M;n\201\364,\"D\'\341\3717\365)\337B\001\242\212x\344\266\374\231\311\373S\030\267\237\310d\b\364\0046#WS\215\'Q\njR\323us\n{i\241\032\363\342\037g^\v;d\212\037\243j{aa5\251\330\t=\f\347\323m\217B?\021\225\311\257\251\315\001\372O\355]C%\376\211\207\025g3\353\302\234\200\371b\303HT\023H\262\340\200zN\227\024\316\204\t\256BN\374\276\361\200\241cc\f&\325\264\277\333Q:\021g\327\311\275\357\"~`\222\361\354\024\t\330\021c\f\354\314\276\247;\3059\2077\372Z\307\034\264k\'LC\034=\nr\274R3\361;\273\252@\353\307\360!\256B\226\005?f\267\334?.\337QZ\313G\332\227\2460\266%U>\204g\251E\256\3561\221\222,\374\347`,\334@A\300\343\216\360\033\357\364\017+\177n\003\301\362\r\'\034\005\016p\023\360\233&\316;\b\364\210w+iN\315nHx\n\314\313C\360o\302\021y\a\022\265\275k\016\376e\355\257j\361\023\245\r*\262\023W6>\212\227K\302\n\a\337\320Xx[\r\001\226\253\261\261\257\260\262\200\326\204\357\177\254w\226\314\037\231\320\353c\315\t\272\aF:\233G\177\301M\252U\033\372wrh\026\360\3203\026\000H\267e\316}\226h\303\202B\264\350\355a\0055J\227\340\203\203!O\353\344\002$\200\243\360\330`;pV\375d~o\fk\244\315*\322\227\202\023s\353\271\213\220\203\207\312jl\t\315\"\312\211\2710\025\330]4\006Vt@\212\304\001)\334k\306\333\031\324\277\244\301\375\306Z\225\211\177\242\225\266\227\367\210*\374\370W\330\250\266+y\342@\231\030T\310.\244\311\000iG\362\257\276DD\030\000N\036+\307\211\253\316s\237B\3137\276G\371\245\311\254\277\355\023\261\346\aln\005C8\367M\r\324D\'\003\314\313\230\216|\023s\243\220\033\234+\2451=\257\342\216}\300\310\364*s.\026\203\225;\323\234C.\331\363\033\306\367\026\272\246\b\246\a\217Oq\241g\240\301b\207w\002\332\017\337=\245J\036^\306=\215\n:\347\t\214\201\004\361^\331\330y\263\367\227F\273\201\216\303\031A +\256\254\001D\347+]\206\224\232\300\230\343zFb\254\005b8\312\213b\204s\265\264/\267\341?\026\242\177\243\3778\226/\307V\317\217\267\t\215\263\334b\235\222\213\376\200\241\033\303\314\002f\261\330\207\237\245\270G<\'\t\342\357T\360\256"

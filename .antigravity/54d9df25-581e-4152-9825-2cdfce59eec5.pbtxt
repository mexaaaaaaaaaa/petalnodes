            }
            lines {
              text: "test(\"normal maps point outward in tangent space (+Z > 128) and have surface relief variation\", () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const stoneNormals = paintNormalMap(\"stone\", \"side\");"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let zSum = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let xMin = 255;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let xMax = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  for (let i = 0; i < 64 * 64; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const p = i * 4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (stoneNormals[p] < xMin) xMin = stoneNormals[p];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (stoneNormals[p] > xMax) xMax = stoneNormals[p];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    zSum += stoneNormals[p + 2];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const avgZ = zSum / (64 * 64);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  assert.ok(avgZ > 160, `Expected outward tangent normal avgZ > 160, got ${avgZ}`);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  assert.ok(xMax - xMin > 40, \"Expected meaningful Sobel normal relief across stone\");"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // With flipY=true, row y=0 is top edge (+v). At plank bevel row y=1 (height drops from row 1 to row 0),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // top bevel normal must point upward (+v, G > 128)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const plankNormals = paintNormalMap(\"cherry_planks\", \"side\");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const topBevelGreen = plankNormals[(1 * 64 + 10) * 4 + 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  assert.ok("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    topBevelGreen > 128,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    `Expected plank top bevel normal Y > 128 (+v upward), got ${topBevelGreen}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "});"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
          }
        }
        absolute_uri: "file:///src/three/island/textures.test.ts"
      }
    }
    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "  const avgZ = zSum / (64 * 64);\n  assert.ok(avgZ > 160, `Expected outward tangent normal avgZ > 160, got ${avgZ}`);\n  assert.ok(xMax - xMin > 40, \"Expected meaningful Sobel normal relief across stone\");\n});"
        replacement_content: "  const avgZ = zSum / (64 * 64);\n  assert.ok(avgZ > 160, `Expected outward tangent normal avgZ > 160, got ${avgZ}`);\n  assert.ok(xMax - xMin > 40, \"Expected meaningful Sobel normal relief across stone\");\n\n  // With flipY=true, row y=0 is top edge (+v). At plank bevel row y=1 (height drops from row 1 to row 0),\n  // top bevel normal must point upward (+v, G > 128).\n  const plankNormals = paintNormalMap(\"cherry_planks\", \"side\");\n  const topBevelGreen = plankNormals[(1 * 64 + 10) * 4 + 1];\n  assert.ok(\n    topBevelGreen > 128,\n    `Expected plank top bevel normal Y > 128 (+v upward), got ${topBevelGreen}`,\n  );\n});"
        start_line: 88

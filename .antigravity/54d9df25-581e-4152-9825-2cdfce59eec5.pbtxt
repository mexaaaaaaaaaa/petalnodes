    tool_calls {
      id: "call_17829290717915273269"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Unescape SSR apostrophe entities in StoryStatic test and assert Bruno/Juno default crew names in DoodleCrewFooter test\", \"EndLine\":160, \"Instruction\":\"Update StoryStatic and DoodleCrewFooter assertions in src/sections/sections.test.tsx\", \"ReplacementContent\":\"  it(\\\"StoryStatic renders every chapter heading and body from content\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <StoryStatic />\\n      </MemoryRouter>,\\n    ).replace(/&#x27;/g, \\\"\'\\\");\\n    for (const ch of story.chapters) {\\n      assert.ok(html.includes(ch.body), `Missing body for chapter ${ch.id}`);\\n    }\\n    assert.ok(html.includes(\\\"Strong roots, zero lag.\\\"));\\n    assert.ok(html.includes(\\\"Your world, in full bloom.\\\"));\\n  });\\n\\n  it(\\\"Nav renders all links, external target=_blank noopener, and CTA href equals links.store\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <Nav />\\n      </MemoryRouter>,\\n    );\\n    assert.ok(html.includes(nav.howItWorksLabel));\\n    assert.ok(html.includes(nav.plansLabel));\\n    assert.ok(html.includes(`href=\\\"${links.store}\\\"`));\\n    for (const ext of nav.externalItems) {\\n      assert.ok(html.includes(ext.label));\\n      assert.ok(html.includes(`href=\\\"${ext.href}\\\"`));\\n    }\\n    assert.ok(html.includes(\'target=\\\"_blank\\\"\'));\\n    assert.ok(html.includes(\'rel=\\\"noopener noreferrer\\\"\'));\\n  });\\n\\n  it(\\\"NotFound renders heading and link home\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <NotFound />\\n      </MemoryRouter>,\\n    ).replace(/&#x27;/g, \\\"\'\\\");\\n    assert.ok(html.includes(\\\"This page didn\'t sprout.\\\"));\\n    assert.ok(html.includes(\'href=\\\"/\\\"\'));\\n    assert.ok(html.includes(notFound.ctaLabel));\\n  });\\n\\n  it(\\\"Footer renders PETALNODE sr heading, Mojang disclaimer, and preserves defaults when crew/logo omitted\\\", () => {\\n    const petalHtml = renderToStaticMarkup(\\n      <DoodleCrewFooter\\n        wordmark={footerConfig.wordmark}\\n        brand={footerConfig.brand}\\n        blurb={footerConfig.blurb}\\n        tagline={footerConfig.tagline}\\n        palette={footerConfig.palette}\\n        columns={footerConfig.columns}\\n        actions={footerConfig.actions}\\n        copyright={footerConfig.copyright}\\n        legal={footerConfig.legal}\\n        socials={footerConfig.socials}\\n        doodles={footerConfig.doodles}\\n        doodleCount={footerConfig.doodleCount}\\n        crew={footerConfig.crew}\\n        logo={<span>CUSTOM_LOGO</span>}\\n      />,\\n    );\\n    assert.ok(petalHtml.includes(brand.wordmark));\\n    assert.ok(petalHtml.includes(brand.disclaimer));\\n    assert.ok(petalHtml.includes(\\\"CUSTOM_LOGO\\\"));\\n\\n    const defaultHtml = renderToStaticMarkup(<DoodleCrewFooter />);\\n    assert.ok(defaultHtml.includes(\\\"Bruno\\\"));\\n    assert.ok(defaultHtml.includes(\\\"Juno\\\"));\\n    assert.ok(!defaultHtml.includes(\\\"CUSTOM_LOGO\\\"));\\n  });\\n});\", \"StartLine\":90, \"TargetContent\":\"  it(\\\"StoryStatic renders every chapter heading and body from content\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <StoryStatic />\\n      </MemoryRouter>,\\n    );\\n    for (const ch of story.chapters) {\\n      assert.ok(html.includes(ch.body), `Missing body for chapter ${ch.id}`);\\n    }\\n    assert.ok(html.includes(\\\"Strong roots, zero lag.\\\"));\\n    assert.ok(html.includes(\\\"Your world, in full bloom.\\\"));\\n  });\\n\\n  it(\\\"Nav renders all links, external target=_blank noopener, and CTA href equals links.store\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <Nav />\\n      </MemoryRouter>,\\n    );\\n    assert.ok(html.includes(nav.howItWorksLabel));\\n    assert.ok(html.includes(nav.plansLabel));\\n    assert.ok(html.includes(`href=\\\"${links.store}\\\"`));\\n    for (const ext of nav.externalItems) {\\n      assert.ok(html.includes(ext.label));\\n      assert.ok(html.includes(`href=\\\"${ext.href}\\\"`));\\n    }\\n    assert.ok(html.includes(\'target=\\\"_blank\\\"\'));\\n    assert.ok(html.includes(\'rel=\\\"noopener noreferrer\\\"\'));\\n  });\\n\\n  it(\\\"NotFound renders heading and link home\\\", () => {\\n    const html = renderToStaticMarkup(\\n      <MemoryRouter>\\n        <NotFound />\\n      </MemoryRouter>,\\n    );\\n    assert.ok(html.includes(\\\"This page didn&#x27;t sprout.\\\") || html.includes(\\\"This page didn\'t sprout.\\\"));\\n    assert.ok(html.includes(\'href=\\\"/\\\"\'));\\n    assert.ok(html.includes(notFound.ctaLabel));\\n  });\\n\\n  it(\\\"Footer renders PETALNODE sr heading, Mojang disclaimer, and preserves defaults when crew/logo omitted\\\", () => {\\n    const petalHtml = renderToStaticMarkup(\\n      <DoodleCrewFooter\\n        wordmark={footerConfig.wordmark}\\n        brand={footerConfig.brand}\\n        blurb={footerConfig.blurb}\\n        tagline={footerConfig.tagline}\\n        palette={footerConfig.palette}\\n        columns={footerConfig.columns}\\n        actions={footerConfig.actions}\\n        copyright={footerConfig.copyright}\\n        legal={footerConfig.legal}\\n        socials={footerConfig.socials}\\n        doodles={footerConfig.doodles}\\n        doodleCount={footerConfig.doodleCount}\\n        crew={footerConfig.crew}\\n        logo={<span>CUSTOM_LOGO</span>}\\n      />,\\n    );\\n    assert.ok(petalHtml.includes(brand.wordmark));\\n    assert.ok(petalHtml.includes(brand.disclaimer));\\n    assert.ok(petalHtml.includes(\\\"CUSTOM_LOGO\\\"));\\n\\n    const defaultHtml = renderToStaticMarkup(<DoodleCrewFooter />);\\n    assert.ok(defaultHtml.includes(\\\"Mochi\\\"));\\n    assert.ok(defaultHtml.includes(\\\"Pebble\\\"));\\n    assert.ok(!defaultHtml.includes(\\\"CUSTOM_LOGO\\\"));\\n  });\\n});\", \"TargetFile\":\"/src/sections/sections.test.tsx\", \"toolAction\":\"Fixing SSR assertions in sections.test.tsx\", \"toolSummary\":\"Component test assertions fix\"}"

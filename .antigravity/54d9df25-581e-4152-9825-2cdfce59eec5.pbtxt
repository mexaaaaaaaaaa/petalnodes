              text: " * - Hero (0..0.10): 0 (fully sketch)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - End of Roots (0.28): ~8 blocks"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - End of Shield (0.46): ~16 blocks"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - End of Build (0.66): ~26 blocks"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Bloom (1.00): ~60 blocks (also reveals the sky)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function revealRadiusFor(progress: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p = clamp01(progress);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (p <= 0.08) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (p <= 0.28) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = (p - 0.08) / 0.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return 8 * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (p <= 0.46) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = (p - 0.28) / 0.18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return 8 + 8 * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (p <= 0.66) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = (p - 0.46) / 0.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return 16 + 10 * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (p <= 0.86) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const t = (p - 0.66) / 0.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return 26 + 8 * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const t = (p - 0.86) / 0.14;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return 34 + 26 * t;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///src/lib/storyStore.ts"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create mutable story progress store, chapter helpers, and world-space revealRadiusFor function"
    diff_stats {

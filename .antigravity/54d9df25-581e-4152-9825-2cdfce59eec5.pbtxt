      create_file {
        instruction: "import test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { pickInitialTier, stepDownTier } from \"./quality\";\n\ntest(\"pickInitialTier returns static when WebGL unavailable or reduced motion is on\", () => {\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: false,\n      reducedMotion: false,\n      coarsePointer: false,\n      shortestScreenSide: 1080,\n    }),\n    \"static\",\n  );\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: true,\n      coarsePointer: false,\n      shortestScreenSide: 1080,\n    }),\n    \"static\",\n  );\n});\n\ntest(\"pickInitialTier picks low on phones/small tablets and medium on larger tablets\", () => {\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: false,\n      coarsePointer: true,\n      shortestScreenSide: 390,\n    }),\n    \"low\",\n  );\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: false,\n      coarsePointer: true,\n      shortestScreenSide: 820,\n    }),\n    \"medium\",\n  );\n});\n\ntest(\"pickInitialTier picks medium for low memory or weak renderer, else high on desktop\", () => {\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: false,\n      deviceMemory: 4,\n      cpuCores: 8,\n      coarsePointer: false,\n      shortestScreenSide: 1080,\n    }),\n    \"medium\",\n  );\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: false,\n      deviceMemory: 16,\n      cpuCores: 8,\n      coarsePointer: false,\n      shortestScreenSide: 1080,\n      rendererString: \"Google SwiftShader\",\n    }),\n    \"medium\",\n  );\n  assert.equal(\n    pickInitialTier({\n      webglAvailable: true,\n      reducedMotion: false,\n      deviceMemory: 16,\n      cpuCores: 8,\n      coarsePointer: false,\n      shortestScreenSide: 1080,\n      rendererString: \"ANGLE (Apple, Apple M2 Pro, OpenGL)\",\n    }),\n    \"high\",\n  );\n});\n\ntest(\"stepDownTier goes high -> medium -> low and stops at low\", () => {\n  assert.equal(stepDownTier(\"high\"), \"medium\");\n  assert.equal(stepDownTier(\"medium\"), \"low\");\n  assert.equal(stepDownTier(\"low\"), \"low\");\n  assert.equal(stepDownTier(\"static\"), \"static\");\n});\n"
        path {
          absolute_uri: "file:///src/lib/quality.test.ts"
        }
        overwrite: true
      }
    }

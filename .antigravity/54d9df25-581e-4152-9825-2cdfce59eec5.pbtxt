      thinking_signature: "\022\236\n\n\233\n\001i\024}\023\214\353\024=\363b\371\223\334\246#[\336\356j\311\324\303\035m\034\360\001R\003\017N{1iQyq\304\016\357E <=\001\f\005d@\263R\307\027\0168\224QS-N|\037\355\251\r\020\030\351\3128\2028\235o*#\241\253\326$S\233\255\273\312\300\335\232\237\352V\225\377d\351|fs\016\224\372;\362e\265\363\300HO/\005\351*\341\023\336/\241r\002{\373\361\365)\211z\353H\326\316.\246\344\261ZN\220:+h\304\331\314*\361Z,3\341\357\001\272g\260\r\300\216g\341\226\324b\f3H\254\366\276Wi\247\241\221@\336\256\246 \333\027\375\277\336Eb\356\204\017\"\222+D\321c}\227\267\033\230\376\275\221\177\'\373\'r\312I\024\250VFK\364o\223&\a\362B\321\241\311\211\2672b\274\307O\214\355U\340\362\333gp3\370\f\247M\2260\210\220d\022\f\n\211\237\211\034\317\321\016\232\264-\035\f\177\233\305\377\245!uv\224\357|\276_2\204NT6$\342\215=\244\2777\333\325\224\314\374\300\273qR\255\030;\215\276\315\321\020\027 /\227\377k\240\2263\311\246!\370\212\204\350\230H\035\203\335\234s\346\214\230\302(\337\213\'\027M\321\236\256\225\375#\267~\317+\252\224\335\327,\270\317E{\356\277s\346\301{\226\261A\0017\017\347w\344\024\035\037b\277\255\333y\262\255@\270\307\223:\202\273@K\341\363W\b\b\222wY\304\r1M\334\006\\\251\205\"\307!O\256\304\213|\207\3407\214\260\201p@Q[\223\033}7W\234\312m\323\260\377\257\353\2731\030Q\312\025\203;\347\026\320Z\303\035|\234\332L5x\314\312\257\027Wn\240a\020|{L\262\374\242\265\213\b\031\317o\335Qr\237\331\033\203\243\236\247\036\37067]\2519\244\326\302\242\360\177\226/\273\335_\267\266\260\260(}X0\n\211O$\300\263*\234Y\263\016\033\'\247\313\n\"\321\2663\332\336S\005(\322\235\033\355\345\301t\205\330\026nd`%\343_!\322\302y2\362\266\303*d\224\024 \327\356WI}\024\036\325\312\rP\302\372\375\017\340\366w}\t/\205\235\327eoU\312\031/\235E<{\240\337\365\r\022$\303-U\226?\275,:\230\365\233\204}j\317\254\271\307wy\300\361\231Q\265s\222\032s\366T\nxB\352\b\377\t!\032L\034\203+Z\302\273\377\025k\264\003a\265\005\201\201\364\204\323<,^\027\353\270\377\235v\276\020q\337\206\336\347\304\210\2101\306f\237\237;\341\237O\362\177\005\336\034\267\317N\224B\242\237FJ\256!\311\000w(\016\343\002\245\016?\357\305\322C\201\326\267\241t\031\203\327\262\274\233\202\343..\214\357\306\356\373j\256\333x\016\357w\341H$u\265\031\335 ,\267\272\205\262Ip\274\230\207\"l\312q\341S\223\v\302U,\v\344\304\374o]\200b\336\336I\200\266?lp\3750\326$\t\364\235\a\035~\313\354\202\237\200A-\352\245C\346\253\314H\274\b\220 \177\260\033-#\305\377 \236\vE\250\256\304\315\323\366\330\316\326\242\306L\340IU\204\032&\370\250W\360\036\036\037\"\326&-^\221Y\2007\305L\264\352\272\315Z3\332\037\272\346P\316\255\335\261uK3\034a\215\030^rC9\211B\2538\353\324\252\260E\301\334\234\n6]6\365\023\327\321\363H\234\022\312\016\026\210\370\270\366\320\273U\334\030\024\206\330uF\236|\322\275\243(X\275pE\0012\251\204\313\240\'\032^rQ\347\001\240\236\373\3675\277\235\364zC}\032l\305\022U\376\000\270 p\000zme\222\017\016\214\034\302\225o5\303\312\305u\357}\203KO\260\r:\362\262n\211\257*\267\205\024\270\221\236\223\352#\206g\37631\203\376\213g?\300\214\327h\'\312\005\373\314#e\201\333\322\256\021\233,\273\027d:g\a([8\253\024\223`\217\343\375\304\022qJJ\025\334\202\256\272\330w\214\204Dy\201\226\322\304Xe\306\203\246\262J\207XE\nks\277$\3626\002\004\331/\251\275L1\b\030\ap\016j\"\b\305\3008\232\304{\b\030A\'\347\217=\333\177v~\374Fk\312K~\003\326\005\330\000\376(h\271W\034\3469\327\377\316B\321\2130\367\224P\305\206I\337J9\350h\036\334\303\257c\212=\221b\365\0271wt\351\343y\\M\322\213\023\023\021O\203f\236\020\244Ah\304D\032\257\200\322\245^\234,\360\303>X_\t\006\264\246]\025\343u\\\031\356&\bjs/\346<\033\201g\353}\344\243eW\3577h.\216\320\3250\273\262\274\257\001\241\327$\341%\202\230}\303}E\261z%L9\a\244\346 \3506?\3228yE\bM(\202\361\344\367|\350ecw\377"

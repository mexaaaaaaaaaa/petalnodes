            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            rgb = mixRgb(cBlossomDeep, cBlossom400, (cluster - 0.37) * 5);"

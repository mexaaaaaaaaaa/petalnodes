              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        body: \"Customers agree to use Petalnodes servers lawfully and in accordance with applicable Minecraft EULA guidelines (Not an official Minecraft product; not approved by or associated with Mojang or Microsoft). Abusive traffic generation, unauthorized scanning, or service disruption is prohibited.\","

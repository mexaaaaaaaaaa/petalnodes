            }
            lines {
              text: "  const n ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    Math.sin(x * 127.1 + y * 269.5 + z * 311.7 + seed * 53.3) * 43758.5453123;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return n - Math.floor(n);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {

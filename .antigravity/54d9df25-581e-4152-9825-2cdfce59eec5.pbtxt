            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // 1. Seed block + sapling (Chapter 0: seed, appearAt = 0)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  setBlock({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

    content: "import type { ChapterId } from \"@/content\";\nimport { clamp01 } from \"@/lib/storyStore\";\n\nexport type BlockType =\n  | \"grass\"\n  | \"dirt\"\n  | \"stone\"\n  | \"deep_stone\"\n  | \"glow_ore\"\n  | \"cherry_log\"\n  | \"cherry_leaves\"\n  | \"cherry_planks\"\n  | \"path\"\n  | \"water\"\n  | \"paper_lantern\"\n  | \"moss_carpet\"\n  | \"flower\"\n  | \"sapling\";\n\nexport interface IslandBlock {\n  x: number;\n  y: number;\n  z: number;\n  type: BlockType;\n  chapter: ChapterId;\n  appearAt: number;\n  groupId?: string;\n}\n\nexport interface AnchorPoint {\n  x: number;\n  y: number;\n  z: number;\n}\n\nexport interface IslandAnchors {\n  seed: AnchorPoint;\n  ore: AnchorPoint;\n  domeRim: AnchorPoint;\n  house: AnchorPoint;"

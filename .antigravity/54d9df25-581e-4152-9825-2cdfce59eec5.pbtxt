            lines {
              text: "      for (const [k, v] of Object.entries(node)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const nextPath = currentPath ? `${currentPath}.${k}` : k;"

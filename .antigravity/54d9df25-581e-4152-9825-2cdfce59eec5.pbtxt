      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Sync index.html title and meta tags with updated Minecraft, VPS, and Bot Hosting metadata\", \"EndLine\":25, \"Instruction\":\"Update index.html title, description, og tags, and twitter tags to match brand.metaTitle and brand.metaDescription\", \"ReplacementContent\":\"    <title>Petalnodes \342\200\224 Cherry Blossom Minecraft, VPS &amp; Bot Hosting</title>\\n    <meta\\n      name=\\\"description\\\"\\n      content=\\\"Minecraft, KVM Linux VPS, and upcoming Miami Bot hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe, and daily backups.\\\"\\n    />\\n    <link rel=\\\"canonical\\\" href=\\\"https://petalnodes.cloud/\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta property=\\\"og:site_name\\\" content=\\\"Petalnodes\\\" />\\n    <meta property=\\\"og:url\\\" content=\\\"https://petalnodes.cloud/\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Petalnodes \342\200\224 Cherry Blossom Minecraft, VPS &amp; Bot Hosting\\\" />\\n    <meta\\n      property=\\\"og:description\\\"\\n      content=\\\"Minecraft, KVM Linux VPS, and upcoming Miami Bot hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe, and daily backups.\\\"\\n    />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <meta name=\\\"twitter:title\\\" content=\\\"Petalnodes \342\200\224 Cherry Blossom Minecraft, VPS &amp; Bot Hosting\\\" />\\n    <meta\\n      name=\\\"twitter:description\\\"\\n      content=\\\"Minecraft, KVM Linux VPS, and upcoming Miami Bot hosting across Singapore, Miami, and India on AMD Ryzen &amp; Intel Xeon Gold hardware with DDR5, NVMe, and daily backups.\\\"\\n    />\", \"StartLine\":6, \"TargetContent\":\"    <title>Petalnodes \342\200\224 Cherry Blossom Minecraft &amp; VPS Hosting</title>\\n    <meta\\n      name=\\\"description\\\"\\n     
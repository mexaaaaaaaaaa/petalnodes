            lines {
              text: "function hash2(x: number, z: number, seed: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const n = Math.sin(x * 127.1 + z * 311.7 + seed * 74.7) * 43758.5453123;"

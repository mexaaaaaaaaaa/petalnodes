  planner_response {
    thinking: "**Verifying Petalnodes URLs**\n\nI\'ve just finished verifying Petalnodes\' brand information and URLs within `/src/content/index.ts`. I made sure to confirm all the key URLs, including those for the main site, billing portal, control panel, and Discord server. I\'ve ensured all links are accurate and current to maintain data integrity.\n\n\n**Confirming Site Navigation**\n\nI\'m now satisfied with the site\'s main navigation routes, confirming `/plans`, `/vps`, etc., are correct. I\'ve noted the missing TikTok profile URL. The plans are now detailed, including RAM, CPU, storage, and pricing. I\'ve also verified the plan inclusions (Java/Bedrock, allocations, NVMe, DDoS).\n\n\n**Detailing VPS Plans, Rewards**\n\nI\'ve outlined details for VPS plans, including Evergrove and other offerings with specs and pricing. Free Minecraft server and Discord boost rewards are now documented. I have created a bot hosting category, but it\'s marked as draft, awaiting further specifications.\n\n\n"
    message_id: "GoQAa4CEFJ_pz7IPor_CiQ0"
    tool_calls {
      id: "call_1997776850660862"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { CrewMember, DoodleKind, FooterAction, FooterColumn, FooterLink } from \\\"@/components/ui/doodle-crew-footer\\\";\\nimport {\\n  aboutPage,\\n  contactPage,\\n  docsPage,\\n  legalDocs,\\n  locationsPage,\\n  modpacksPage,\\n} from \\\"./pages\\\";\\n\\nexport * from \\\"./pages\\\";\\n\\nexport type PlanId =\\n  | \\\"seed\\\"\\n  | \\\"sprout\\\"\\n  | \\\"sapling\\\"\\n  | \\\"blossom\\\"\\n  | \\\"grove\\\"\\n  | \\\"orchard\\\"\\n  | \\\"sakura\\\";\\n\\nexport interface Plan {\\n  id: PlanId;\\n  name: string;\\n  ramGb: number;\\n  cpu: string;\\n  storage: string;\\n  goodFor: string;\\n  priceMonthly: string;\\n  paymenterUrl: string;\\n  cardLine: string;\\n  ourPick?: boolean;\\n}\\n\\nexport type VpsPlanId = \\\"root\\\" | \\\"branch\\\" | \\\"trunk\\\" | \\\"canopy\\\" | \\\"evergrove\\\";\\n\\nexport interface VpsPlan {\\n  id: VpsPlanId;\\n  name: string;\\n  ramGb: number;\\n  vcpu: string;\\n  storage: string;\\n  priceMonthly: string;\\n  paymenterUrl: string;\\n  cardLine: string;\\n}\\n\\nexport interface FreeRewardTier {\\n  id: string;\\n  name: string;\\n  invitesRequired: number;\\n  ramGb: number;\\n}\\n\\nexport interface BoostRewardTier {\\n  id: string;\\n  name: string;\\n  boostsRequired: number;\\n  ramGb: number;\\n}\\n\\nexport interface BotPlanDraft {\\n  id: string;\\n  proposedName: string;\\n  ram: string;\\n  cpu: string;\\n  storage: string;\\n  priceMonthly: string;\\n  paymenterUrl: string;\\n}\\n\\nexport type ChapterId = \\\"seed\\\" | \\\"roots\\\" | \\\"shield\\\" | \\\"build\\\" | \\\"neighbors\\\" | \\\"bloom\\\";\\n\\nexport interface StoryChapterContent {\\n  id: ChapterId;\\n  vineLabel: string;\\n  kicker?: string;\\n  eyebrow?: string;\\n  heading: string;\\n  highlightWord?: string;\\n  body: string;\\n  todoNote?: string;\\n  specs?: { label: string; value: string }[];\\n  annotation: string;\\n  anchorName: \\\"seed\\\" | \\\"ore\\\" | \\\"domeRim\\\" | \\\"house\\\" | \\\"mascots\\\";\\n  panelLoaders?: string[];\\n  panelName?: string;\\n  polaroidCaption?: string;\\n  ctaLabel?: string;\\n}\\n\\nexport interface FaqItem {\\n  id: number;\\n  question: string;\\n  answer: string;\\n}\\n\\nexport interface ReviewItem {\\n  author: string;\\n  role: string;\\n  quote: string;\\n}\\n\\nexport const brand = {\\n  name: \\\"Petalnodes\\\",\\n  wordmark: \\\"PETALNODES\\\",\\n  logoText: \\\"petalnodes\\\",\\n  tagline: \\\"Plant a seed. Grow a world.\\\",\\n  oneLiner: \\\"Minecraft & VPS hosting, grown with care.\\\",\\n  metaTitle: \\\"Petalnodes \342\200\224 Cherry Blossom Minecraft & VPS Hosting\\\",\\n  metaDescription:\\n    \\\"Minecraft and VPS hosting across Singapore, Miami, and India on AMD Ryzen & Intel Xeon Gold hardware with DDR5, NVMe storage, DDoS protection, and daily backups.\\\",\\n  disclaimer:\\n    \\\"Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\\\",\\n  copyright:\\n    \\\"\302\251 2026 Petalnodes. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\\\",\\n};\\n\\nexport const links = {\\n  siteUrl: \\\"https://petalnodes.cloud\\\",\\n  store: \\\"https://billing.petalnodes.cloud\\\",\\n  clientArea: \\\"https://billing.petalnodes.cloud\\\",\\n  gamePanel: \\\"https://panel.petalnodes.cloud\\\",\\n  discord: \\\"https://discord.gg/GS3wuc4HGk\\\",\\n  status: \\\"https://status.petalnodes.cloud\\\",\\n  docs: \\\"/docs\\\",\\n  terms: \\\"/terms\\\",\\n  privacy: \\\"/privacy\\\",\\n  sla: \\\"/sla\\\",\\n  locations: \\\"/locations\\\",\\n  modpacks: \\\"/modpacks\\\",\\n  about: \\\"/about\\\",\\n  contact: \\\"/contact\\\",\\n  plans: \\\"/plans\\\",\\n  vps: \\\"/vps\\\",\\n  bots: \\\"/bots\\\",\\n  socials: [\\n    { label: \\\"YouTube\\\", href: \\\"TODO: verified YouTube URL (Petalnodes)\\\" },\\n    { label: \\\"X\\\", href: \\\"TODO: verified X URL (@petalnodes)\\\" },\\n    { label: \\\"Instagram\\\", href: \\\"TODO: verified Instagram URL (@petalnodes)\\\" },\\n  ] as FooterLink[],\\n};\\n\\nexport const planIncludes: string[] = [\\n  \\\"Java & Bedrock Support\\\",\\n  \\\"Paper, Purpur & Fabric\\\",\\n  \\\"2 Allocations\\\",\\n  \\\"2 Database Access Slots\\\",\\n  \\\"NVMe Storage\\\",\\n  \\\"DDoS Protection\\\",\\n  \\\"Daily Backups Included\\\",\\n];\\n\\nexport const plans: Plan[] = [\\n  {\\n    id: \\\"seed\\\",\\n    name: \\\"Seed\\\",\\n    ramGb: 2,\\n    cpu: \\\"100%\\\",\\n    storage: \\\"10GB NVMe\\\",\\n    goodFor: \\\"2\342\200\2235 friends, vanilla\\\",\\n    priceMonthly: \\\"\342\202\27159\\\",\\n    paymenterUrl: \\\"TODO: Seed Paymenter URL\\\",\\n    cardLine: \\\"Just you and a couple of friends.\\\",\\n  },\\n  {\\n    id: \\\"sprout\\\",\\n    name: \\\"Sprout\\\",\\n    ramGb: 4,\\n    cpu: \\\"150%\\\",\\n    storage: \\\"15GB NVMe\\\",\\n    goodFor: \\\"5\342\200\22310 players, light plugins\\\",\\n    priceMonthly: \\\"\342\202\27199\\\",\\n    paymenterUrl: \\\"TODO: Sprout Paymenter URL\\\",\\n    cardLine: \\\"A cozy survival world that\'s starting to grow.\\\",\\n  },\\n  {\\n    id: \\\"sapling\\\",\\n    name: \\\"Sapling\\\",\\n    ramGb: 8,\\n    cpu: \\\"250%\\\",\\n    storage: \\\"25GB NVMe\\\",\\n    goodFor: \\\"10\342\200\22320 players, plugin servers\\\",\\n    priceMonthly: \\\"\342\202\271169\\\",\\n    paymenterUrl: \\\"TODO: Sapling Paymenter URL\\\",\\n    cardLine: \\\"The sweet spot. Room for plugins and friends.\\\",\\n    ourPick: true,\\n  },\\n  {\\n    id: \\\"blossom\\\",\\n    name: \\\"Blossom\\\",\\n    ramGb: 12,\\n    cpu: \\\"350%\\\",\\n    storage: \\\"35GB NVMe\\\",\\n    goodFor: \\\"Active SMPs & Fabric mods\\\",\\n    priceMonthly: \\\"\342\202\271239\\\",\\n    paymenterUrl: \\\"TODO: Blossom Paymenter URL\\\",\\n    cardLine: \\\"Modded adventures, in full bloom.\\\",\\n  },\\n  {\\n    id: \\\"grove\\\",\\n    name: \\\"Grove\\\",\\n    ramGb: 16,\\n    cpu: \\\"400%\\\",\\n    storage: \\\"45GB NVMe\\\",\\n    goodFor: \\\"Heavy Paper/Fabric worlds\\\",\\n    priceMonthly: \\\"\342\202\271299\\\",\\n    paymenterUrl: \\\"TODO: Grove Paymenter URL\\\",\\n    cardLine: \\\"Room to spare for bustling towns.\\\",\\n  },\\n  {\\n    id: \\\"orchard\\\",\\n    name: \\\"Orchard\\\",\\n    ramGb: 20,\\n    cpu: \\\"500%\\\",\\n    storage: \\\"55GB NVMe\\\",\\n    goodFor: \\\"Large communities & heavy plugins\\\",\\n    priceMonthly: \\\"\342\202\271369\\\",\\n    paymenterUrl: \\\"TODO: Orchard Paymenter URL\\\",\\n    cardLine: \\\"A whole orchard of thriving worlds.\\\",\\n  },\\n  {\\n    id: \\\"sakura\\\",\\n    name: \\\"Sakura\\\",\\n    ramGb: 24,\\n    cpu: \\\"600%\\\",\\n    storage: \\\"65GB NVMe\\\",\\n    goodFor: \\\"Peak community worlds & networks\\\",\\n    priceMonthly: \\\"\342\202\271449\\\",\\n    paymenterUrl: \\\"TODO: Sakura Paymenter URL\\\",\\n    cardLine: \\\"Our flagship cherry blossom tier.\\\",\\n  },\\n];\\n\\nexport const highlightPlanIds: PlanId[] = [\\\"sprout\\\", \\\"sapling\\\", \\\"blossom\\\"];\\n\\nexport const vpsPlans: VpsPlan[] = [\\n  {\\n    id: \\\"root\\\",\\n    name: \\\"Root\\\",\\n    ramGb: 4,\\n    vcpu: \\\"2 vCPU\\\",\\n    storage: \\\"20GB NVMe\\\",\\n    priceMonthly: \\\"\342\202\271300\\\",\\n    paymenterUrl: \\\"TODO: Root VPS Paymenter URL\\\",\\n    cardLine: \\\"Compact KVM Linux node for bots, proxies, or lightweight services.\\\",\\n  },\\n  {\\n    id: \\\"branch\\\",\\n    name: \\\"Branch\\\",\\n    ramGb: 6,\\n    vcpu: \\\"2 vCPU\\\",\\n    storage: \\\"30GB NVMe\\\",\\n    priceMonthly: \\\"\342\202\271500\\\",\\n    paymenterUrl: \\\"TODO: Branch VPS Paymenter URL\\\",\\n    cardLine: \\\"Balanced memory for web apps, panels, and multi-service stacks.\\\",\\n  },\\n  {\\n    id: \\\"trunk\\\",\\n    name: \\\"Trunk\\\",\\n    ramGb: 8,\\n    vcpu: \\\"3 vCPU\\\",\\n    storage: \\\"40GB NVMe\\\",\\n    priceMonthly: \\\"\342\202\271800\\\",\\n    paymenterUrl: \\\"TODO: Trunk VPS Paymenter URL\\\",\\n    cardLine: \\\"Three dedicated vCPU threads with ample DDR5 memory.\\\",\\n  },\\n  {\\n    id: \\\"canopy\\\",\\n    name: \\\"Canopy\\\",\\n    ramGb: 12,\\n    vcpu: \\\"4 vCPU\\\",\\n    storage: \\\"60GB NVMe\\\",\\n    priceMonthly: \\\"\342\202\2711,200\\\",\\n    paymenterUrl: \\\"TODO: Canopy VPS Paymenter URL\\\",\\n    cardLine: \\\"Serious capacity for networks, databases, and custom workloads.\\\",\\n  },\\n  {\\n    id: \\\"evergrove\\\",\\n    name: \\\"Evergrove\\\",\\n    ramGb: 16,\\n    vcpu: \\\"4 vCPU\\\",\\n    storage: \\\"80GB NVMe\\\",\\n    priceMonthly: \\\"\342\202\2711,600\\\",\\n    paymenterUrl: \\\"TODO: Evergrove VPS Paymenter URL\\\",\\n    cardLine: \\\"Flagship 16GB KVM root server built for heavy projects.\\\",\\n  },\\n];\\n\\nexport const vpsSection = {\\n  eyebrow: \\\"vps hosting\\\",\\n  heading: \\\"Root access, Cherry Blossom roots.\\\",\\n  highlightWord: \\\"Root\\\",\\n  sub: \\\"Full root KVM Linux servers powered by AMD Ryzen and Intel Xeon Gold infrastructure with DDR5 memory, NVMe storage, and DDoS protection.\\\",\\n  cardCta: \\\"Deploy VPS \342\206\222\\\",\\n  includes: [\\n    \\\"KVM Virtualization\\\",\\n    \\\"Full Root Access\\\",\\n    \\\"Linux OS\\\",\\n    \\\"IPv4 Subject to Availability\\\",\\n    \\\"Network Protection\\\",\\n    \\\"Discord Support\\\",\\n    \\\"NVMe Storage\\\",\\n    \\\"Daily Backups Included\\\",\\n  ],\\n  infrastructureHeading: \\\"Platform Infrastructure\\\",\\n  infrastructureNote:\\n    \\\"Hardware varies across our Singapore, Miami, and India locations. Not every VPS node uses the same processor model or location-specific configuration.\\\",\\n  infrastructureItems: [\\n    \\\"AMD Ryzen processors\\\",\\n    \\\"Intel Xeon Gold processors\\\",\\n    \\\"DDR5 memory\\\",\\n    \\\"NVMe storage\\\",\\n    \\\"Cloudflare protection\\\",\\n    \\\"DDoS protection\\\",\\n  ],\\n};\\n\\nexport const freeRewards = {\\n  heading: \\\"Free Minecraft Server Rewards\\\",\\n  sub: \\\"Grow the Petalnodes community on Discord and claim a free server tier through a Discord Support Ticket.\\\",\\n  claimCta: \\\"Claim via Discord Ticket\\\",\\n  tiers: [\\n    { id: \\\"petal-1\\\", name: \\\"Petal I\\\", invitesRequired: 6, ramGb: 2 },\\n    { id: \\\"petal-2\\\", name: \\\"Petal II\\\", invitesRequired: 8, ramGb: 5 },\\n    { id: \\\"petal-3\\\", name: \\\"Petal III\\\", invitesRequired: 12, ramGb: 7 },\\n    { id: \\\"petal-4\\\", name: \\\"Petal IV\\\", invitesRequired: 16, ramGb: 9 },\\n    { id: \\\"petal-5\\\", name: \\\"Petal V\\\", invitesRequired: 20, ramGb: 13 },\\n    { id: \\\"petal-6\\\", name: \\\"Petal VI\\\", invitesRequired: 30, ramGb: 17 },\\n  ] as FreeRewardTier[],\\n  rules: [\\n    { label: \\\"Member Leave\\\", penalty: \\\"\342\210\2222\\\" },\\n    { label: \\\"Rejoin\\\", penalty: \\\"\342\210\2221\\\" },\\n    { label: \\\"Fake / Alt Account\\\", penalty: \\\"\342\210\2222\\\" },\\n    { label: \\\"Mass Ping\\\", penalty: \\\"Invite Reset\\\" },\\n  ],\\n};\\n\\nexport const boostRewards = {\\n  heading: \\\"Discord Boost Rewards\\\",\\n  sub: \\\"Boost the Petalnodes Discord server and unlock a Java & Bedrock NVMe server.\\\",\\n  requirementBanner:\\n    \\\"Active boosts are required to maintain rewards. Claim through a Discord Support Ticket.\\\",\\n  claimCta: \\\"Boost & Claim on Discord\\\",\\n  tiers: [\\n    { id: \\\"bloom-1\\\", name: \\\"Bloom I\\\", boostsRequired: 1, ramGb: 3 },\\n    { id: \\\"bloom-2\\\", name: \\\"Bloom II\\\", boostsRequired: 2, ramGb: 6 },\\n    { id: \\\"bloom-3\\\", name: \\\"Bloom III\\\", boostsRequired: 3, ramGb: 9 },\\n    { id: \\\"bloom-4\\\", name: \\\"Bloom IV\\\", boostsRequired: 4, ramGb: 12 },\\n  ] as BoostRewardTier[],\\n  specs: [\\n    \\\"Java & Bedrock\\\",\\n    \\\"NVMe Storage\\\",\\n    \\\"Claim through a Discord Support Ticket\\\",\\n    \\\"Active boosts are required to maintain rewards\\\",\\n  ],\\n};\\n\\nexport const botHosting = {\\n  eyebrow: \\\"bot hosting \302\267 awaiting confirmation\\\",\\n  heading: \\\"Keep your community bots blooming.\\\",\\n  highlightWord: \\\"blooming\\\",\\n  sub: \\\"Dedicated Discord and community bot hosting backed by NVMe storage, DDoS protection, and panel management.\\\",\\n  draftNotice:\\n    \\\"Bot Hosting plan names, pricing, CPU/RAM/storage allocations, and supported language runtimes are awaiting final confirmation from the Petalnodes team.\\\",\\n  proposedNamingNote:\\n    \\\"Proposed Cherry Blossom names below are drafts for owner approval before launch.\\\",\\n  supportedRuntimesTodo: \\\"TODO: confirm supported bot languages and runtimes (e.g. Node.js, Python, Java)\\\",\\n  features: [\\n    {\\n      title: \\\"Managed via Game Panel\\\",\\n      detail: \\\"Control console logs, environment files, and restarts at panel.petalnodes.cloud.\\\",\\n    },\\n    {\\n      title: \\\"NVMe & DDoS Protection\\\",\\n      detail: \\\"Backed by our NVMe storage and always-on network DDoS protection.\\\",\\n    },\\n    {\\n      title: \\\"Human Support on Discord\\\",\\n      detail: \\\"Need custom runtime guidance? Ask in our Discord community anytime.\\\",\\n    },\\n  ],\\n  plans: [\\n    {\\n      id: \\\"pollen\\\",\\n      proposedName: \\\"Pollen (Draft)\\\",\\n      ram: \\\"TODO\\\",\\n      cpu: \\\"TODO\\\",\\n      storage: \\\"TODO\\\",\\n      priceMonthly: \\\"TODO\\\",\\n      paymenterUrl: \\\"TODO: Bot Hosting Tier 1 URL\\\",\\n    },\\n    {\\n      id: \\\"dewdrop\\\",\\n      proposedName: \\\"Dewdrop (Draft)\\\",\\n      ram: \\\"TODO\\\",\\n      cpu: \\\"TODO\\\",\\n      storage: \\\"TODO\\\",\\n      priceMonthly: \\\"TODO\\\",\\n      paymenterUrl: \\\"TODO: Bot Hosting Tier 2 URL\\\",\\n    },\\n    {\\n      id: \\\"nectar\\\",\\n      proposedName: \\\"Nectar (Draft)\\\",\\n      ram: \\\"TODO\\\",\\n      cpu: \\\"TODO\\\",\\n      storage: \\\"TODO\\\",\\n      priceMonthly: \\\"TODO\\\",\\n      paymenterUrl: \\\"TODO: Bot Hosting Tier 3 URL\\\",\\n    },\\n  ] as BotPlanDraft[],\\n};\\n\\nexport interface NavRouteItem {\\n  label: string;\\n  to: string;\\n}\\n\\nexport const nav = {\\n  howItWorksLabel: \\\"How it works\\\",\\n  plansLabel: \\\"Minecraft Hosting\\\",\\n  routeItems: [\\n    { label: \\\"Home\\\", to: \\\"/\\\" },\\n    { label: \\\"Minecraft Hosting\\\", to: \\\"/plans\\\" },\\n    { label: \\\"VPS Hosting\\\", to: \\\"/vps\\\" },\\n    { label: \\\"Bot Hosting\\\", to: \\\"/bots\\\" },\\n    { label: \\\"Server Locations\\\", to: \\\"/locations\\\" },\\n    { label: \\\"Documentation\\\", to: \\\"/docs\\\" },\\n  ] as NavRouteItem[],\\n  externalItems: [\\n    { label: \\\"Discord\\\", href: links.discord },\\n  ],\\n  ctaLabel: \\\"Client Area\\\",\\n  ctaHref: links.clientArea,\\n};\\n\\nexport const story: {\\n  chapters: StoryChapterContent[];\\n  heroPrimaryCta: string;\\n  heroSecondaryCta: string;\\n} = {\\n  heroPrimaryCta: \\\"Get a server\\\",\\n  heroSecondaryCta: \\\"Minecraft plans\\\",\\n  chapters: [\\n    {\\n      id: \\\"seed\\\",\\n      vineLabel: \\\"Seed\\\",\\n      eyebrow: \\\"minecraft & vps hosting, grown with care\\\",\\n      heading: \\\"Plant a seed. Grow a world.\\\",\\n      highlightWord: \\\"world\\\",\\n      body: \\\"Fast servers across Singapore, Miami, and India with Paper, Purpur, and Fabric support, daily backups included, and real humans on Discord. Every world starts as a little sapling.\\\",\\n      annotation: \\\"this is your server \342\206\223 scroll to watch it grow\\\",\\n      anchorName: \\\"seed\\\",\\n    },\\n    {\\n      id: \\\"roots\\\",\\n      vineLabel: \\\"Roots\\\",\\n      kicker: \\\"01 \302\267 roots\\\",\\n      heading: \\\"Strong roots, zero guesswork.\\\",\\n      body: \\\"Our infrastructure pairs AMD Ryzen and Intel Xeon Gold processors with DDR5 memory and fast NVMe storage across Singapore, Miami, and India.\\\",\\n      specs: [\\n        { label: \\\"Processors\\\", value: \\\"Ryzen & Xeon Gold\\\" },\\n        { label: \\\"Storage\\\", value: \\\"NVMe Storage\\\" },\\n        { label: \\\"Memory\\\", value: \\\"DDR5 Memory\\\" },\\n        { label: \\\"Locations\\\", value: \\\"SG \302\267 Miami \302\267 IN\\\" },\\n      ],\\n      annotation: \\\"this glowy stuff = your hardware\\\",\\n      anchorName: \\\"ore\\\",\\n    },\\n    {\\n      id: \\\"shield\\\",\\n      vineLabel: \\\"Shield\\\",\\n      kicker: \\\"02 \302\267 shield\\\",\\n      heading: \\\"A shield that never sleeps.\\\",\\n      body: \\\"DDoS protection and Cloudflare protection help keep unwanted traffic away from your community so you can stay focused on building.\\\",\\n      specs: [\\n        { label: \\\"Mitigation\\\", value: \\\"DDoS & Cloudflare\\\" },\\n        { label: \\\"Included on\\\", value: \\\"every plan\\\" },\\n      ],\\n      annotation: \\\"boing. not today.\\\",\\n      anchorName: \\\"domeRim\\\",\\n    },\\n    {\\n      id: \\\"build\\\",\\n      vineLabel: \\\"Build\\\",\\n      kicker: \\\"03 \302\267 instant build\\\",\\n      heading: \\\"Pick your software. Start building.\\\",\\n      body: \\\"Choose Paper, Purpur, or Fabric with Java & Bedrock support, 2 allocations, 2 database slots, and daily backups included inside panel.petalnodes.cloud.\\\",\\n      panelLoaders: [\\\"Paper\\\", \\\"Purpur\\\", \\\"Fabric\\\"],\\n      panelName: \\\"panel.petalnodes.cloud\\\",\\n      annotation: \\\"managed cleanly in one panel\\\",\\n      anchorName: \\\"house\\\",\\n    },\\n    {\\n      id: \\\"neighbors\\\",\\n      vineLabel: \\\"Neighbors\\\",\\n      kicker: \\\"04 \302\267 neighbors\\\",\\n      heading: \\\"Good neighbors, fair prices.\\\",\\n      body: \\\"Need a hand? Join real humans in our Discord community or open a ticket in billing.petalnodes.cloud. Paid Minecraft tiers start at \342\202\27159/mo \342\200\224 or earn a Petal server with invites.\\\",\\n      specs: [\\n        { label: \\\"From\\\", value: \\\"\342\202\27159 / month\\\" },\\n        { label: \\\"Free tiers\\\", value: \\\"Petal I \342\200\223 VI\\\" },\\n        { label: \\\"Locations\\\", value: \\\"SG \302\267 Miami \302\267 IN\\\" },\\n      ],\\n      annotation: \\\"that\'s us. hi!\\\",\\n      anchorName: \\\"mascots\\\",\\n    },\\n    {\\n      id: \\\"bloom\\\",\\n      vineLabel: \\\"Bloom\\\",\\n      heading: \\\"Your world, in full bloom.\\\",\\n      body: \\\"That\'s the whole idea. You bring the seed, we keep it growing.\\\",\\n      polaroidCaption: \\\"your world, day 1 of forever\\\",\\n      ctaLabel: \\\"Pick your plan \342\206\223\\\",\\n      annotation: \\\"your world, ready to play\\\",\\n      anchorName: \\\"house\\\",\\n    },\\n  ],\\n};\\n\\nexport const plansSection = {\\n  homeHeading: \\\"Pick your seed.\\\",\\n  homeSub:\\n    \\\"Every Minecraft plan includes Java & Bedrock support, Paper/Purpur/Fabric, 2 allocations, 2 database slots, NVMe storage, DDoS protection, and daily backups.\\\",\\n  cardCta: \\\"Plant this server \342\206\222\\\",\\n  ourPickLabel: \\\"OUR PICK\\\",\\n  seeAllLabel: \\\"See all seven plans \342\206\222\\\",\\n  pageHeading: \\\"Plans that grow with you.\\\",\\n  pageHighlightWord: \\\"grow\\\",\\n  pageSub:\\n    \\\"Seven Cherry Blossom Minecraft tiers from 2GB Seed (\342\202\27159/mo) to 24GB Sakura (\342\202\271449/mo) \342\200\224 plus Petal free invite tiers and Bloom boost rewards.\\\",\\n  compareHeading: \\\"Compare every Minecraft tier\\\",\\n};\\n\\nexport const trust = {\\n  heading: \\\"Built on confirmed hardware.\\\",\\n  items: [\\n    { id: \\\"cpu\\\", label: \\\"Processors\\\", value: \\\"AMD Ryzen & Xeon Gold\\\", icon: \\\"clock\\\" as const },\\n    { id: \\\"locations\\\", label: \\\"Locations\\\", value: \\\"Singapore \302\267 Miami \302\267 India\\\", icon: \\\"globe\\\" as const },\\n    { id: \\\"protection\\\", label: \\\"Security\\\", value: \\\"DDoS & Cloudflare\\\", icon: \\\"coin\\\" as const },\\n    { id: \\\"backups\\\", label: \\\"Storage & Backups\\\", value: \\\"NVMe \302\267 Daily Backups\\\", icon: \\\"shield\\\" as const },\\n  ],\\n  reviews: [] as ReviewItem[],\\n  reviewsTodoNotice: \\\"TODO: add real reviews (no invented ones)\\\",\\n};\\n\\nexport const faq: {\\n  heading: string;\\n  items: FaqItem[];\\n  plansPageIds: number[];\\n} = {\\n  heading: \\\"Questions you probably have\\\",\\n  plansPageIds: [2, 3, 4, 5, 6, 8],\\n  items: [\\n    {\\n      id: 1,\\n      question: \\\"What is Petalnodes?\\\",\\n      answer:\\n        \\\"Petalnodes provides Cherry Blossom Minecraft hosting, KVM Linux VPS servers, Discord rewards, and upcoming bot hosting with real Discord support.\\\",\\n    },\\n    {\\n      id: 2,\\n      question: \\\"How fast is my server ready?\\\",\\n      answer:\\n        \\\"TODO: confirm exact provisioning time after checkout at billing.petalnodes.cloud.\\\",\\n    },\\n    {\\n      id: 3,\\n      question: \\\"Which server software is supported?\\\",\\n      answer:\\n        \\\"Minecraft plans support Paper, Purpur, and Fabric with Java & Bedrock support, 2 allocations, and 2 database access slots.\\\",\\n    },\\n    {\\n      id: 4,\\n      question: \\\"Java or Bedrock?\\\",\\n      answer:\\n        \\\"Both! Java & Bedrock support is included across our paid Minecraft plans and Bloom Discord Boost reward tiers.\\\",\\n    },\\n    {\\n      id: 5,\\n      question: \\\"Can I upgrade later?\\\",\\n      answer:\\n        \\\"Yes \342\200\224 manage plans and upgrades from billing.petalnodes.cloud. TODO: confirm automated upgrade/proration policy.\\\",\\n    },\\n    {\\n      id: 6,\\n      question: \\\"Is DDoS protection included?\\\",\\n      answer:\\n        \\\"Yes. DDoS protection and Cloudflare protection are included across our infrastructure.\\\",\\n    },\\n    {\\n      id: 7,\\n      question: \\\"Where are your servers?\\\",\\n      answer:\\n        \\\"We have infrastructure in Singapore (SG), Miami (USA), and India (IN).\\\",\\n    },\\n    {\\n      id: 8,\\n      question: \\\"Do you offer refunds?\\\",\\n      answer: \\\"TODO: refund policy (pending owner confirmation)\\\",\\n    },\\n    {\\n      id: 9,\\n      question: \\\"How do I get help?\\\",\\n      answer:\\n        \\\"Join our Discord at https://discord.gg/GS3wuc4HGk or open a ticket from your Client Area at https://billing.petalnodes.cloud.\\\",\\n    },\\n  ],\\n};\\n\\nexport const finalCta = {\\n  heading: \\\"Ready to plant yours?\\\",\\n  primaryLabel: \\\"Get a server\\\",\\n  primaryHref: links.store,\\n  secondaryLabel: \\\"Join the Discord\\\",\\n  secondaryHref: links.discord,\\n};\\n\\nexport const notFound = {\\n  heading: \\\"This page didn\'t sprout.\\\",\\n  body: \\\"Looks like that link wandered off the path.\\\",\\n  ctaLabel: \\\"Back home\\\",\\n};\\n\\nexport const footerConfig = {\\n  wordmark: brand.wordmark,\\n  brand: brand.logoText,\\n  blurb:\\n    \\\"Minecraft & VPS hosting grown with care. Singapore, Miami, and India regions with NVMe storage, daily backups, and real humans on Discord.\\\",\\n  tagline: brand.tagline,\\n  palette: {\\n    background: \\\"#FBF6EE\\\",\\n    ink: \\\"#2B2230\\\",\\n    accent: \\\"#E2557B\\\",\\n  },\\n  columns: [\\n    {\\n      title: \\\"Hosting\\\",\\n      links: [\\n        { label: \\\"Minecraft Hosting\\\", href: links.plans },\\n        { label: \\\"VPS Hosting\\\", href: links.vps },\\n        { label: \\\"Bot Hosting\\\", href: links.bots },\\n        { label: \\\"Modpacks\\\", href: links.modpacks },\\n        { label: \\\"Locations\\\", href: links.locations },\\n      ],\\n    },\\n    {\\n      title: \\\"Resources\\\",\\n      links: [\\n        { label: \\\"Documentation\\\", href: links.docs },\\n        { label: \\\"Status\\\", href: links.status },\\n        { label: \\\"Discord\\\", href: links.discord },\\n        { label: \\\"Contact\\\", href: links.contact },\\n      ],\\n    },\\n    {\\n      title: \\\"Company\\\",\\n      links: [\\n        { label: \\\"About\\\", href: links.about },\\n        { label: \\\"Terms of Service\\\", href: links.terms },\\n        { label: \\\"Privacy Policy\\\", href: links.privacy },\\n        { label: \\\"SLA\\\", href: links.sla },\\n      ],\\n    },\\n    {\\n      title: \\\"Account\\\",\\n      links: [\\n        { label: \\\"Billing\\\", href: links.store },\\n        { label: \\\"Client Area\\\", href: links.clientArea },\\n        { label: \\\"Game Panel\\\", href: links.gamePanel },\\n      ],\\n    },\\n  ] as FooterColumn[],\\n  actions: [\\n    {\\n      label: \\\"Join the Discord\\\",\\n      href: links.discord,\\n      icon: \\\"petal\\\",\\n      variant: \\\"outline\\\",\\n    },\\n    {\\n      label: \\\"Get a server\\\",\\n      href: links.store,\\n      icon: \\\"bolt\\\",\\n      variant: \\\"solid\\\",\\n    },\\n  ] as FooterAction[],\\n  copyright: brand.copyright,\\n  legal: [\\n    { label: \\\"Terms of Service\\\", href: links.terms },\\n    { label: \\\"Privacy Policy\\\", href: links.privacy },\\n    { label: \\\"SLA\\\", href: links.sla },\\n  ] as FooterLink[],\\n  get socials(): FooterLink[] {\\n    return links.socials.filter((s) => s.href && !isTodo(s.href));\\n  },\\n  doodles: [\\n    \\\"petal\\\",\\n    \\\"petal\\\",\\n    \\\"heart\\\",\\n    \\\"star\\\",\\n    \\\"petal\\\",\\n    \\\"sparkle\\\",\\n    \\\"cube\\\",\\n    \\\"petal\\\",\\n  ] as DoodleKind[],\\n  doodleCount: 12,\\n  crew: [\\n    {\\n      kind: \\\"nodey\\\",\\n      letter: 0,\\n      seat: \\\"front\\\",\\n      offset: -0.32,\\n      name: \\\"Nodey\\\",\\n      says: \\\"Your world\'s safe with me.\\\",\\n    },\\n    {\\n      kind: \\\"bird\\\",\\n      letter: 2,\\n      seat: \\\"top\\\",\\n      offset: 0.02,\\n      name: \\\"Pip\\\",\\n      says: \\\"SG, Miami, or India \342\200\224 take your pick.\\\",\\n    },\\n    {\\n      kind: \\\"mushroom\\\",\\n      letter: 3,\\n      seat: \\\"front\\\",\\n      offset: 0.12,\\n      scale: 0.95,\\n      name: \\\"Morel\\\",\\n      says: \\\"Paper, Purpur, and Fabric ready.\\\",\\n    },\\n    {\\n      kind: \\\"sapling\\\",\\n      letter: 5,\\n      seat: \\\"top\\\",\\n      offset: 0,\\n      name: \\\"Sprout\\\",\\n      says: \\\"Plant me! I grow into islands.\\\",\\n    },\\n    {\\n      kind: \\\"ghost\\\",\\n      letter: 6,\\n      seat: \\\"behind\\\",\\n      offset: 0,\\n      name: \\\"Boo\\\",\\n      says: \\\"Daily backups included on every world.\\\",\\n    },\\n    {\\n      kind: \\\"cat\\\",\\n      letter: 9,\\n      seat: \\\"front\\\",\\n      offset: 0.42,\\n      flip: true,\\n      name: \\\"Patch\\\",\\n      says: \\\"Psst. Sapling\'s the sweet spot.\\\",\\n    },\\n  ] as CrewMember[],\\n};\\n\\nexport interface TodoEntry {\\n  path: string;\\n  value: string;\\n  isUrl: boolean;\\n}\\n\\nexport function isTodo(value: unknown): boolean {\\n  if (typeof value !== \\\"string\\\") return false;\\n  return /\\\\bTODO\\\\b/.test(value);\\n}\\n\\nconst URL_KEY_HINT = /(url|href|siteUrl|store|clientArea|gamePanel|discord|status|docs|terms|privacy|sla)$/i;\\n\\nexport function listTodos(): TodoEntry[] {\\n  const results: TodoEntry[] = [];\\n  const root = {\\n    links,\\n    planIncludes,\\n    plans,\\n    vpsPlans,\\n    botHosting,\\n    story,\\n    trust,\\n    faq,\\n    footerColumns: footerConfig.columns,\\n    locationsPage,\\n    docsPage,\\n    modpacksPage,\\n    aboutPage,\\n    contactPage,\\n    legalDocs,\\n  };\\n\\n  function walk(node: unknown, currentPath: string, keyName: string) {\\n    if (typeof node === \\\"string\\\") {\\n      if (isTodo(node)) {\\n        const isUrl =\\n          URL_KEY_HINT.test(keyName) ||\\n          /\\\\b(URL|domain|link)\\\\b/i.test(node) ||\\n          currentPath.startsWith(\\\"links.\\\");\\n        results.push({ path: currentPath, value: node, isUrl });\\n      }\\n      return;\\n    }\\n    if (Array.isArray(node)) {\\n      node.forEach((item, idx) => walk(item, `${currentPath}[${idx}]`, keyName));\\n      return;\\n    }\\n    if (node && typeof node === \\\"object\\\") {\\n      for (const [k, v] of Object.entries(node)) {\\n        const nextPath = currentPath ? `${currentPath}.${k}` : k;\\n        walk(v, nextPath, k);\\n      }\\n    }\\n  }\\n\\n  walk(root, \\\"\\\", \\\"\\\");\\n  return results;\\n}\\n\", \"Description\":\"Update centralized content module with Petalnodes brand info, confirmed URLs, Cherry Blossom 7 Minecraft tiers, 5 VPS tiers, Petal Free Rewards, Bloom Boost Rewards, Bot Hosting draft, confirmed hardware/security/location details, navigation, footer, and comprehensive TODO scanning.\", \"Overwrite\":true, \"TargetFile\":\"/src/content/index.ts\", \"toolAction\":\"Updating centralized content module\", \"toolSummary\":\"Update central content module\"}"

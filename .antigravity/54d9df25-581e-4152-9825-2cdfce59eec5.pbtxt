            lines {
              text: " * Converts a normalized [0,1] height field into a crevice-only AO map:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * midtones and ridges (h >= 0.56) stay at full 1.0 brightness while"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * cracks, pits, and bark furrows (h < 0.56) smoothly occlude down to ~0.22."

            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Subtle static paper grain"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  float grain = (sketchHash(floor(px * 0.75)) - 0.5) * 0.045;"

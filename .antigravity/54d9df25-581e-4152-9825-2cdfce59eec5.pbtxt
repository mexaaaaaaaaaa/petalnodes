            }
            lines {
              text: "function vnoise(x: number, y: number, seed: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const ix = Math.floor(x);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const iy = Math.floor(y);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const fx = x - ix;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const fy = y - iy;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const ux = fx * fx * (3 - 2 * fx);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const uy = fy * fy * (3 - 2 * fy);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const a = hash(ix, iy, seed);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const b = hash(ix + 1, iy, seed);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {

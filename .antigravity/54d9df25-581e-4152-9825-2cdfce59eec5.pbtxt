              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dy = ay - clampedLy - (preferAbove ? 28 : 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

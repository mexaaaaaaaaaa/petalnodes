    end_line: 583
    content: "import * as THREE from \"three\";\nimport type { BlockType } from \"./islandGenerator\";\nimport type { QualityTier } from \"@/lib/quality\";\n\nexport type BlockFace = \"top\" | \"side\" | \"bottom\";\n\nexport interface PaintedBlockBuffers {\n  albedo: Uint8Array;\n  normal: Uint8Array;\n  emissive: Uint8Array;\n  height: Float32Array;\n}\n\nconst SIZE = 64;\n\nfunction hash(x: number, y: number, seed: number): number {\n  const n = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453123;\n  return n - Math.floor(n);\n}\n\nfunction vnoise(x: number, y: number, seed: number): number {\n  const ix = Math.floor(x);\n  const iy = Math.floor(y);\n  const fx = x - ix;\n  const fy = y - iy;\n  const ux = fx * fx * (3 - 2 * fx);\n  const uy = fy * fy * (3 - 2 * fy);\n  const a = hash(ix, iy, seed);\n  const b = hash(ix + 1, iy, seed);\n  const c = hash(ix, iy + 1, seed);\n  const d = hash(ix + 1, iy + 1, seed);\n  return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;\n}\n\nfunction fbm(x: number, y: number, seed: number, octaves = 3): number {\n  let sum = 0;\n  let amp = 0.5;\n  let freq = 1;\n  let norm = 0;\n  for (let i = 0; i < octaves; i++) {\n    sum += vnoise(x * freq, y * freq, seed + i * 17) * amp;\n    norm += amp;\n    amp *= 0.5;\n    freq *= 2.02;\n  }\n  return sum / norm;\n}\n\nfunction hexRgb(hex: number): [number, number, number] {\n  return [(hex >> 16) & 255, (hex >> 8) & 255, hex & 255];\n}\n\nfunction mixRgb(\n  a: [number, number, number],\n  b: [number, number, number],\n  t: number,\n): [number, number, number] {\n  const k = Math.max(0, Math.min(1, t));\n  return [\n    Math.round(a[0] + (b[0] - a[0]) * k),\n    Math.round(a[1] + (b[1] - a[1]) * k),\n    Math.round(a[2] + (b[2] - a[2]) * k),\n  ];\n}\n\nfunction clampByte(v: number): number {\n  return v < 0 ? 0 : v > 255 ? 255 : Math.round(v);\n}\n\nconst TYPE_SEEDS: Record<BlockType, number> = {\n  cherry_leaves: 101,\n  cherry_log: 202,\n  cherry_planks: 303,\n  grass: 404,\n  dirt: 505,\n  stone: 606,\n  deep_stone: 707,\n  glow_ore: 808,\n  path: 909,\n  paper_lantern: 1010,\n  moss_carpet: 1111,\n  water: 1212,\n  flower: 1313,\n  sapling: 1414,\n};\n\nexport function paintBlockBuffers(\n  type: BlockType,\n  face: BlockFace = \"side\",\n): PaintedBlockBuffers {\n  const albedo = new Uint8Array(SIZE * SIZE * 4);\n  const emissive = new Uint8Array(SIZE * SIZE * 4);\n  const height = new Float32Array(SIZE * SIZE);\n  const normal = new Uint8Array(SIZE * SIZE * 4);\n  const baseSeed = TYPE_SEEDS[type] + (face === \"top\" ? 11 : face === \"bottom\" ? 29 : 0);\n\n  const cBlossom200 = hexRgb(0xffc9d6);\n  const cBlossom400 = hexRgb(0xff8fab);\n  const cBlossomDeep = hexRgb(0xe9799a);\n  const cBlossomHi = hexRgb(0xfff1f4);\n  const cMoss = hexRgb(0x6faf5b);\n  const cMossLight = hexRgb(0x88c46f);\n  const cMossDark = hexRgb(0x528d44);\n  const cMossDeep = hexRgb(0x467a39);\n  const cBark = hexRgb(0x6b4a3a);\n  const cBarkDark = hexRgb(0x4a3025);\n  const cBarkLight = hexRgb(0x8c6352);\n  const cRingLight = hexRgb(0xeec7b8);\n  const cRingMid = hexRgb(0xd49c89);\n  const cPlank = hexRgb(0xe7b9a6);\n  const cPlankLight = hexRgb(0xf3cfc0);\n  const cPlankSeam = hexRgb(0xb27f6d);\n  const cDirt = hexRgb(0x845f47);\n  const cDirtDark = hexRgb(0x634532);\n  const cDirtLight = hexRgb(0x9e7559);\n  const cStone = hexRgb(0x9c96a3);\n  const cStoneLight = hexRgb(0xb4aebc);\n  const cStoneDark = hexRgb(0x746d7b);\n  const cDeepStone = hexRgb(0x5e5466);\n  const cDeepDark = hexRgb(0x433a4b);\n  const cDeepLight = hexRgb(0x75697e);\n  const cLantern = hexRgb(0xffc75a);\n  const cPaper = hexRgb(0xfbf6ee);\n  const cPath = hexRgb(0xc7b194);\n  const cPathStone = hexRgb(0x9f99a3);\n  const cWater = hexRgb(0x6cb8e6);\n  const cWaterFoam = hexRgb(0xdbf2ff);\n\n  for (let y = 0; y < SIZE; y++) {\n    for (let x = 0; x < SIZE; x++) {\n      const idx = y * SIZE + x;\n      const p4 = idx * 4;\n      let rgb: [number, number, number] = [180, 180, 180];\n      let alpha = 255;\n      let h = 0.5;\n      let em: [number, number, number] = [0, 0, 0];\n\n      // Subtle baked fake AO border for texture depth\n      const edgeDist = Math.min(x, y, SIZE - 1 - x, SIZE - 1 - y);\n      const edgeDarken = edgeDist < 3 ? 0.91 + edgeDist * 0.03 : 1.0;\n\n      if (type === \"cherry_leaves\") {\n        const cluster = fbm(x * 0.16, y * 0.16, baseSeed, 3);\n        const micro = hash(x, y, baseSeed + 5);\n        // ~25% alpha cutout holes\n        if (cluster < 0.42 && !(y > SIZE - 4 && micro > 0.72)) {\n          alpha = 0;\n          rgb = cBlossom400;\n          h = 0.1;\n        } else {\n          // Top-left cluster highlight bias\n          const tlCluster = fbm((x - 2) * 0.16, (y - 2) * 0.16, baseSeed, 3);\n          const bevel = cluster - tlCluster;\n          if (bevel > 0.05 || cluster > 0.68) {\n            rgb = mixRgb(cBlossom200, cBlossomHi, 0.55);\n            h = 0.85;\n          } else if (cluster > 0.5) {\n            rgb = mixRgb(cBlossom400, cBlossom200, (cluster - 0.5) * 4);\n            h = 0.65;\n          } else {\n            rgb = mixRgb(cBlossomDeep, cBlossom400, (cluster - 0.37) * 5);\n            h = 0.4;\n          }\n          if (micro > 0.88) {\n            rgb = mixRgb(rgb, cBlossomHi, 0.35);\n          }\n        }\n      } else if (type === \"cherry_log\") {\n        if (face === \"top\" || face === \"bottom\") {\n          const dx = x - SIZE / 2 + 0.5;\n          const dy = y - SIZE / 2 + 0.5;\n          const dist = Math.hypot(dx, dy) + fbm(x * 0.12, y * 0.12, baseSeed, 2) * 3.5;\n          if (dist > 28) {\n            rgb = cBark;\n            h = 0.6;\n          } else {\n            const ring = Math.sin(dist * 1.15) * 0.5 + 0.5;\n            rgb = mixRgb(cRingMid, cRingLight, ring);\n            h = 0.45 + ring * 0.2;\n          }\n        } else {\n          const groove = fbm(x * 0.45, y * 0.07, baseSeed, 3);\n          const crack = vnoise(x * 0.7, y * 0.1, baseSeed + 41);\n          if (crack < 0.26) {\n            rgb = cBarkDark;\n            h = 0.2;\n          } else if (groove > 0.6) {\n            rgb = cBarkLight;\n            h = 0.78;\n          } else {\n            rgb = mixRgb(cBarkDark, cBark, groove * 1.4);\n            h = 0.4 + groove * 0.3;\n          }\n        }\n      } else if (type === \"cherry_planks\") {\n        const boardRow = y % 16;\n        const seamY = boardRow === 0 || boardRow === 15;\n        const boardIndex = Math.floor(y / 16);\n        const vertSeamX = (boardIndex * 29 + 17) % SIZE;\n        const seamX = x === vertSeamX;\n        if (seamY || seamX) {\n          rgb = cPlankSeam;\n          h = 0.2;\n        } else {\n          const grain = fbm(x * 0.08 + boardIndex * 5, y * 0.45, baseSeed, 2);\n          rgb = mixRgb(cPlank, cPlankLight, grain);\n          h = 0.55 + grain * 0.22;\n        }\n      } else if (type === \"grass\") {\n        if (face === \"top\") {\n          const n = fbm(x * 0.18, y * 0.18, baseSeed, 3);\n          const m = hash(x, y, baseSeed + 71);\n          if (n > 0.64) rgb = cMossLight;\n          else if (n > 0.44) rgb = cMoss;\n          else if (n > 0.28) rgb = cMossDark;\n          else rgb = cMossDeep;\n          // Tiny scattered pink cherry petals on grass top\n          if (m > 0.985) {\n            rgb = m > 0.993 ? cBlossom200 : cBlossom400;\n            h = 0.85;\n          } else {\n            h = 0.4 + n * 0.45;\n          }\n        } else if (face === \"bottom\") {\n          const dn = fbm(x * 0.22, y * 0.22, baseSeed + 5, 3);\n          rgb = mixRgb(cDirtDark, cDirt, dn);\n          h = 0.35 + dn * 0.35;\n        } else {\n          // Grass side: wavy grass overhang on top ~12px, dirt below\n          const wave = 11 + Math.round(Math.sin(x * 0.35) * 2.5 + vnoise(x * 0.4, 1, baseSeed) * 3.5);\n          if (y < wave) {\n            const gn = fbm(x * 0.2, y * 0.25, baseSeed, 2);\n            rgb = gn > 0.55 ? cMossLight : gn > 0.32 ? cMoss : cMossDark;\n            h = 0.72 + gn * 0.2;\n          } else if (y === wave) {\n            rgb = cMossDeep;\n            h = 0.55;\n          } else {\n            const dn = fbm(x * 0.22, y * 0.22, baseSeed + 9, 3);\n            const pebble = hash(x, y, baseSeed + 31) > 0.94;\n            rgb = pebble ? cStone : mixRgb(cDirtDark, cDirtLight, dn);\n            h = pebble ? 0.65 : 0.3 + dn * 0.3;\n          }\n        }\n      } else if (type === \"dirt\") {\n        const dn = fbm(x * 0.22, y * 0.22, baseSeed, 3);\n        const pebble = vnoise(x * 0.45, y * 0.45, baseSeed + 22) > 0.79;\n        rgb = pebble ? cStoneDark : mixRgb(cDirtDark, cDirtLight, dn);\n        h = pebble ? 0.72 : 0.3 + dn * 0.4;\n      } else if (type === \"stone\") {\n        const chunk = fbm(x * 0.14, y * 0.14, baseSeed, 3);\n        const crack = Math.abs(fbm(x * 0.18 + 8, y * 0.18 + 3, baseSeed + 19, 2) - 0.5);\n        if (crack < 0.032) {\n          rgb = cStoneDark;\n          h = 0.2;\n        } else {\n          rgb = mixRgb(cStoneDark, cStoneLight, chunk);\n          h = 0.4 + chunk * 0.45;\n        }\n      } else if (type === \"deep_stone\") {\n        const chunk = fbm(x * 0.22, y * 0.22, baseSeed, 3);\n        const crack = Math.abs(fbm(x * 0.26, y * 0.26, baseSeed + 14, 2) - 0.5);\n        if (crack < 0.04) {\n          rgb = cDeepDark;\n          h = 0.18;\n        } else {\n          rgb = mixRgb(cDeepStone, cDeepLight, chunk);\n          h = 0.35 + chunk * 0.45;\n        }\n      } else if (type === \"glow_ore\") {\n        const chunk = fbm(x * 0.22, y * 0.22, baseSeed, 3);\n        rgb = mixRgb(cDeepDark, cDeepStone, chunk);\n        h = 0.35 + chunk * 0.35;\n        // Pink-gold crystal clusters\n        const crystalField = fbm(x * 0.17 + 2, y * 0.17 + 4, baseSeed + 55, 2);\n        const facet = vnoise(x * 0.45, y * 0.45, baseSeed + 66);\n        if (crystalField > 0.61) {\n          const isGold = facet > 0.52;\n          const crystalColor = isGold ? cLantern : cBlossom400;\n          rgb = mixRgb(crystalColor, cBlossomHi, facet > 0.8 ? 0.5 : 0.1);\n          em = crystalColor;\n          h = 0.92;\n        }\n      } else if (type === \"path\") {\n        const n = fbm(x * 0.2, y * 0.2, baseSeed, 3);\n        const stonePatch = fbm(x * 0.24, y * 0.24, baseSeed + 88, 2) > 0.64;\n        rgb = stonePatch ? mixRgb(cPathStone, cStoneLight, n) : mixRgb(cDirt, cPath, n);\n        h = stonePatch ? 0.68 : 0.38 + n * 0.2;\n      } else if (type === \"paper_lantern\") {\n        const isFrame =\n          x < 6 ||\n          x >= SIZE - 6 ||\n          y < 7 ||\n          y >= SIZE - 7 ||\n          y === 24 ||\n          y === 40 ||\n          x === 31 ||\n          x === 32;\n        if (isFrame) {\n          rgb = cBark;\n          h = 0.72;\n        } else {\n          const glow = fbm(x * 0.1, y * 0.1, baseSeed, 2);\n          rgb = mixRgb(cPaper, cLantern, 0.35 + glow * 0.45);\n          em = mixRgb(cLantern, [255, 224, 150], glow);\n          h = 0.45;\n        }\n      } else if (type === \"moss_carpet\") {\n        const n = fbm(x * 0.26, y * 0.26, baseSeed, 3);\n        const speck = hash(x, y, baseSeed + 12) > 0.88;\n        rgb = speck ? cMossDeep : mixRgb(cMossDark, cMossLight, n);\n        h = 0.4 + n * 0.45;\n      } else if (type === \"water\") {\n        const wave = fbm(x * 0.14, y * 0.18, baseSeed, 2);\n        rgb = wave > 0.68 ? cWaterFoam : mixRgb([84, 160, 212], cWater, wave);\n        alpha = 215;\n        h = 0.45 + wave * 0.25;\n      } else if (type === \"flower\") {\n        const dx = x - 32;\n        const dy = y - 32;\n        const r = Math.hypot(dx, dy);\n        if (r < 6) {\n          rgb = cLantern;\n          h = 0.85;\n        } else if (r < 22 && Math.sin(Math.atan2(dy, dx) * 5) > -0.25) {\n          rgb = r < 14 ? cBlossom200 : cBlossom400;\n          h = 0.78;\n        } else if (y > 38 && Math.abs(dx) < 3) {\n          rgb = cMoss;\n          h = 0.6;\n        } else {\n          alpha = 0;\n          rgb = cBlossom200;\n        }\n      } else if (type === \"sapling\") {\n        const dx = x - 32;\n        const isStem = Math.abs(dx) < 3 && y > 26;\n        const leafL = Math.hypot(x - 22, y - 24) < 11;\n        const leafR = Math.hypot(x - 42, y - 20) < 11;\n        const blossomTop = Math.hypot(x - 32, y - 15) < 9;\n        if (blossomTop) {\n          rgb = (x + y) % 3 === 0 ? cBlossom200 : cBlossom400;\n          h = 0.85;\n        } else if (leafL || leafR) {\n          rgb = (x + y) % 4 === 0 ? cMossLight : cMoss;\n          h = 0.75;\n        } else if (isStem) {\n          rgb = cBark;\n          h = 0.65;\n        } else {\n          alpha = 0;\n          rgb = cMoss;\n        }\n      }\n\n      albedo[p4] = clampByte(rgb[0] * edgeDarken);\n      albedo[p4 + 1] = clampByte(rgb[1] * edgeDarken);\n      albedo[p4 + 2] = clampByte(rgb[2] * edgeDarken);\n      albedo[p4 + 3] = alpha;\n\n      emissive[p4] = em[0];\n      emissive[p4 + 1] = em[1];\n      emissive[p4 + 2] = em[2];\n      emissive[p4 + 3] = 255;\n\n      height[idx] = h;\n    }\n  }\n\n  // Derive tangent-space normal map from height field\n  const strength = 2.6;\n  for (let y = 0; y < SIZE; y++) {\n    for (let x = 0; x < SIZE; x++) {\n      const xm = (x - 1 + SIZE) % SIZE;\n      const xp = (x + 1) % SIZE;\n      const ym = (y - 1 + SIZE) % SIZE;\n      const yp = (y + 1) % SIZE;\n      const dx = (height[y * SIZE + xp] - height[y * SIZE + xm]) * strength;\n      const dy = (height[yp * SIZE + x] - height[ym * SIZE + x]) * strength;\n      const nx = -dx;\n      const ny = -dy;\n      const nz = 1.0;\n      const invLen = 1 / Math.hypot(nx, ny, nz);\n      const p4 = (y * SIZE + x) * 4;\n      normal[p4] = clampByte((nx * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 1] = clampByte((ny * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 2] = clampByte((nz * invLen * 0.5 + 0.5) * 255);\n      normal[p4 + 3] = 255;\n    }\n  }\n\n  return { albedo, normal, emissive, height };\n}\n\nexport function paintBlockTexture(type: BlockType, face: BlockFace = \"side\"): Uint8Array {\n  return paintBlockBuffers(type, face).albedo;\n}\n\nexport function paintNormalMap(type: BlockType, face: BlockFace = \"side\"): Uint8Array {\n  return paintBlockBuffers(type, face).normal;\n}\n\nfunction makeDataTexture(data: Uint8Array, isColor: boolean): THREE.DataTexture {\n  const tex = new THREE.DataTexture(data, SIZE, SIZE, THREE.RGBAFormat);\n  tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n  tex.magFilter = THREE.NearestFilter;\n  tex.minFilter = THREE.LinearMipmapLinearFilter;\n  tex.generateMipmaps = true;\n  tex.wrapS = THREE.RepeatWrapping;\n  tex.wrapT = THREE.RepeatWrapping;\n  tex.needsUpdate = true;\n  return tex;\n}\n\nconst materialCache = new Map<string, THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[]>();\n\n/**\n * Shared uniform object updated per frame by IslandBlocks without triggering shader recompiles.\n */\nexport const islandShaderUniforms = {\n  uProgress: { value: 0 },\n  uTime: { value: 0 },\n  uCutaway: { value: 0 },\n  uDusk: { value: 0 },\n};\n\nfunction attachStoryShader(\n  mat: THREE.MeshStandardMaterial,\n  options: { sway?: boolean; cutawayEligible?: boolean; emissiveDuskBoost?: boolean },\n) {\n  mat.onBeforeCompile = (shader) => {\n    shader.uniforms.uProgress = islandShaderUniforms.uProgress;\n    shader.uniforms.uTime = islandShaderUniforms.uTime;\n    shader.uniforms.uCutaway = islandShaderUniforms.uCutaway;\n    shader.uniforms.uDusk = islandShaderUniforms.uDusk;\n\n    shader.vertexShader =\n      `\n      attribute float aAppearAt;\n      uniform float uProgress;\n      uniform float uTime;\n      uniform float uCutaway;\n      varying float vCutClip;\n      ` + shader.vertexShader;\n\n    shader.vertexShader = shader.vertexShader.replace(\n      \"#include <begin_vertex>\",\n      `\n      #include <begin_vertex>\n      float dropWindow = 0.02;\n      float reveal = aAppearAt <= 0.0001\n        ? 1.0\n        : clamp((uProgress - aAppearAt) / dropWindow, 0.0, 1.0);\n\n      // Tiny overshoot bounce\n      float bounce = reveal < 1.0\n        ? (reveal < 0.7 ? (reveal / 0.7) * 1.08 : 1.08 - ((reveal - 0.7) / 0.3) * 0.08)\n        : 1.0;\n\n      float sc = reveal <= 0.0 ? 0.0 : bounce;\n      transformed *= sc;\n      transformed.y += (1.0 - reveal) * 1.5;\n\n      ${\n        options.sway\n          ? `\n      vec4 instPos = instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\n      float phase = instPos.x * 0.7 + instPos.z * 0.9 + instPos.y * 0.4;\n      transformed.x += sin(uTime * 1.6 + phase) * 0.045 * reveal;\n      transformed.z += cos(uTime * 1.3 + phase * 1.2) * 0.035 * reveal;\n      `\n          : \"\"\n      }\n\n      vCutClip = 0.0;\n      ${\n        options.cutawayEligible\n          ? `\n      #ifdef USE_INSTANCING\n        vec3 centerPos = (instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;\n        if (uCutaway > 0.01 && centerPos.z > 0.6 && centerPos.y < -0.5) {\n          vCutClip = uCutaway;\n        }\n      #endif\n      `\n          : \"\"\n      }\n      `,\n    );\n\n    shader.fragmentShader =\n      `\n      varying float vCutClip;\n      uniform float uDusk;\n      ` + shader.fragmentShader;\n\n    shader.fragmentShader = shader.fragmentShader.replace(\n      \"#include <clipping_planes_fragment>\",\n      `\n      #include <clipping_planes_fragment>\n      if (vCutClip > 0.5) discard;\n      `,\n    );\n\n    if (options.emissiveDuskBoost) {\n      shader.fragmentShader = shader.fragmentShader.replace(\n        \"#include <emissivemap_fragment>\",\n        `\n        #include <emissivemap_fragment>\n        totalEmissiveRadiance *= (0.35 + uDusk * 2.2);\n        `,\n      );\n    }\n  };\n  mat.customProgramCacheKey = () =>\n    `petalnode-${options.sway ? 1 : 0}-${options.cutawayEligible ? 1 : 0}-${options.emissiveDuskBoost ? 1 : 0}`;\n}\n\nexport function getBlockMaterial(\n  type: BlockType,\n  tier: QualityTier,\n  attachStory = true,\n): THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[] {\n  const cacheKey = `${type}:${tier}:${attachStory ? \"story\" : \"plain\"}`;\n  const existing = materialCache.get(cacheKey);\n  if (existing) return existing;\n\n  const isLeafOrPlant = type === \"cherry_leaves\" || type === \"flower\" || type === \"sapling\";\n  const isCutawayEligible =\n    type === \"stone\" || type === \"deep_stone\" || type === \"dirt\" || type === \"glow_ore\";\n  const isLantern = type === \"paper_lantern\";\n  const isOre = type === \"glow_ore\";\n\n  const makeOne = (face: BlockFace) => {\n    const bufs = paintBlockBuffers(type, face);\n    const map = makeDataTexture(bufs.albedo, true);\n    const normalMap = makeDataTexture(bufs.normal, false);\n    const hasEmissive = isOre || isLantern;\n    const emissiveMap = hasEmissive ? makeDataTexture(bufs.emissive, true) : undefined;\n\n    const matParams: THREE.MeshStandardMaterialParameters = {\n      color: 0xffffff,\n      map,\n      normalMap,\n      normalScale: new THREE.Vector2(0.75, 0.75),\n      roughness: type === \"water\" ? 0.18 : isOre ? 0.55 : 0.86,\n      metalness: isOre ? 0.15 : 0.0,\n      alphaTest: isLeafOrPlant ? 0.4 : 0,\n      transparent: type === \"water\",\n      opacity: type === \"water\" ? 0.82 : 1,\n      side: isLeafOrPlant ? THREE.DoubleSide : THREE.FrontSide,\n      emissive: hasEmissive ? new THREE.Color(0xffffff) : new THREE.Color(0x000000),\n      emissiveIntensity: isOre ? 1.85 : isLantern ? 1.6 : 0,\n    };\n    if (emissiveMap) {\n      matParams.emissiveMap = emissiveMap;\n    }\n    const mat = new THREE.MeshStandardMaterial(matParams);\n\n    if (attachStory) {\n      attachStoryShader(mat, {\n        sway: isLeafOrPlant,\n        cutawayEligible: isCutawayEligible,\n        emissiveDuskBoost: isLantern,\n      });\n    }\n    return mat;\n  };\n\n  let result: THREE.MeshStandardMaterial | THREE.MeshStandardMaterial[];\n  if (type === \"grass\" || type === \"cherry_log\") {\n    const side = makeOne(\"side\");\n    const top = makeOne(\"top\");\n    const bottom = makeOne(\"bottom\");\n    // BoxGeometry face order: +x, -x, +y, -y, +z, -z\n    result = [side, side, top, bottom, side, side];\n  } else {\n    result = makeOne(\"side\");\n  }\n\n  materialCache.set(cacheKey, result);\n  return result;\n}\n"
    num_lines: 584

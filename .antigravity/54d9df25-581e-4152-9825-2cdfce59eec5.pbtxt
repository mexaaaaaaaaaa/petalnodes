      arguments_json: "{\"CodeContent\":\"import * as React from \\\"react\\\";\\nimport { generateRoughArrowPaths } from \\\"@/lib/roughPaths\\\";\\nimport { gsap, useGSAP } from \\\"@/lib/gsap\\\";\\nimport { useReducedMotion } from \\\"@/app/QualityProvider\\\";\\nimport { cn } from \\\"@/lib/utils\\\";\\n\\nexport interface InkArrowProps {\\n  from: [number, number];\\n  to: [number, number];\\n  curvature?: number;\\n  seed?: number;\\n  stroke?: string;\\n  strokeWidth?: number;\\n  drawIn?: boolean;\\n  className?: string;\\n}\\n\\nexport function InkArrow({\\n  from,\\n  to,\\n  curvature = 0.24,\\n  seed = 31,\\n  stroke = \\\"#2B2230\\\",\\n  strokeWidth = 2.2,\\n  drawIn = false,\\n  className,\\n}: InkArrowProps) {\\n  const svgRef = React.useRef<SVGSVGElement | null>(null);\\n  const reducedMotion = useReducedMotion();\\n\\n  const { shaft, head, viewBox } = React.useMemo(() => {\\n    const pad = 16;\\n    const minX = Math.min(from[0], to[0]) - pad;\\n    const minY = Math.min(from[1], to[1]) - pad;\\n    const maxX = Math.max(from[0], to[0]) + pad;\\n    const maxY = Math.max(from[1], to[1]) + pad;\\n    const paths = generateRoughArrowPaths({\\n      x1: from[0],\\n      y1: from[1],\\n      x2: to[0],\\n      y2: to[1],\\n      curvature,\\n      seed,\\n      stroke,\\n      strokeWidth,\\n    });\\n    return {\\n      ...paths,\\n      viewBox: `${minX} ${minY} ${Math.max(30, maxX - minX)} ${Math.max(30, maxY - minY)}`,\\n    };\\n  }, [from, to, curvature, seed, stroke, strokeWidth]);\\n\\n  useGSAP(\\n    () => {\\n      if (!drawIn || reducedMotion || !svgRef.current) return;\\n      const paths = svgRef.current.querySelectorAll(\\\"path\\\");\\n      gsap.fromTo(\\n        paths,\\n        { drawSVG: \\\"0%\\\" },\\n        {\\n          drawSVG: \\\"100%\\\",\\n          duration: 0.6,\\n          stagger: 0.14,\\n          ease: \\\"power2.inOut\\\",\\n          scrollTrigger: {\\n            trigger: svgRef.current,\\n            start: \\\"top 92%\\\",\\n            once: true,\\n          },\\n        },\\n      );\\n    },\\n    { scope: svgRef, dependencies: [drawIn, reducedMotion] },\\n  );\\n\\n  return (\\n    <svg\\n      ref={svgRef}\\n      aria-hidden=\\\"true\\\"\\n      viewBox={viewBox}\\n      className={cn(\\\"overflow-visible pointer-events-none\\\", className)}\\n    >\\n      {shaft.map((p, idx) => (\\n        <path\\n          key={`s-${idx}`}\\n          d={p.d}\\n          stroke={p.stroke}\\n          strokeWidth={p.strokeWidth}\\n          strokeLinecap=\\\"round\\\"\\n          fill=\\\"none\\\"\\n        />\\n      ))}\\n      {head.map((p, idx) => (\\n        <path\\n          key={`h-${idx}`}\\n          d={p.d}\\n          stroke={p.stroke}\\n          strokeWidth={p.strokeWidth}\\n          strokeLinecap=\\\"round\\\"\\n          fill=\\\"none\\\"\\n        />\\n      ))}\\n    </svg>\\n  );\\n}\\n\", \"Description\":\"Create curvy hand-drawn InkArrow component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/sketch/InkArrow.tsx\", \"toolAction\":\"Writing InkArrow component\", \"toolSummary\":\"Write InkArrow.tsx\"}"
      original_name: "write_to_file"
    }

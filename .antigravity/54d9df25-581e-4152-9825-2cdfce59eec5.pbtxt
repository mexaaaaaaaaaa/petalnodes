    end_line: 548
    content: "import type { CrewMember, DoodleKind, FooterAction, FooterColumn, FooterLink } from \"@/components/ui/doodle-crew-footer\";\n\nexport type PlanId = \"seed\" | \"sprout\" | \"sapling\" | \"blossom\" | \"grove\" | \"orchard\";\n\nexport interface Plan {\n  id: PlanId;\n  name: string;\n  ramGb: number;\n  cpu: string;\n  storage: string;\n  goodFor: string;\n  priceMonthly: string;\n  paymenterUrl: string;\n  cardLine: string;\n  ourPick?: boolean;\n}\n\nexport type ChapterId = \"seed\" | \"roots\" | \"shield\" | \"build\" | \"neighbors\" | \"bloom\";\n\nexport interface StoryChapterContent {\n  id: ChapterId;\n  vineLabel: string;\n  kicker?: string;\n  eyebrow?: string;\n  heading: string;\n  highlightWord?: string;\n  body: string;\n  todoNote?: string;\n  specs?: { label: string; value: string }[];\n  annotation: string;\n  anchorName: \"seed\" | \"ore\" | \"domeRim\" | \"house\" | \"mascots\";\n  panelLoaders?: string[];\n  panelName?: string;\n  polaroidCaption?: string;\n  ctaLabel?: string;\n}\n\nexport interface FaqItem {\n  id: number;\n  question: string;\n  answer: string;\n}\n\nexport interface ReviewItem {\n  author: string;\n  role: string;\n  quote: string;\n}\n\nexport const brand = {\n  name: \"Petalnode\",\n  wordmark: \"PETALNODE\",\n  logoText: \"petalnode\",\n  tagline: \"Plant a seed. Grow a world.\",\n  oneLiner: \"Minecraft server hosting, grown with care.\",\n  metaTitle: \"Petalnode: Minecraft Server Hosting, Grown With Care\",\n  metaDescription:\n    \"Fast Minecraft servers with always-on DDoS protection, one-click modpacks and real humans on Discord. Plant a seed, grow a world.\",\n  disclaimer:\n    \"Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\",\n  copyright:\n    \"\302\251 2026 Petalnode. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.\",\n};\n\nexport const links = {\n  siteUrl: \"TODO: final domain\",\n  store: \"TODO: Paymenter store URL\",\n  clientArea: \"TODO: Paymenter client area URL\",\n  gamePanel: \"TODO: panel URL\",\n  discord: \"TODO: Discord invite URL\",\n  status: \"TODO: status page URL\",\n  docs: \"TODO: docs URL\",\n  terms: \"TODO: terms URL\",\n  privacy: \"TODO: privacy URL\",\n  sla: \"TODO: SLA URL\",\n  socials: [\n    { label: \"YouTube\", href: \"TODO: YouTube URL\" },\n    { label: \"X\", href: \"TODO: X URL\" },\n    { label: \"TikTok\", href: \"TODO: TikTok URL\" },\n  ] as FooterLink[],\n};\n\nexport const planIncludes: string[] = [\n  \"Always-on DDoS protection\",\n  \"NVMe storage (TODO: confirm)\",\n  \"One-click panel with modpacks\",\n  \"Discord support\",\n  \"Daily backups (TODO: confirm)\",\n];\n\nexport const plans: Plan[] = [\n  {\n    id: \"seed\",\n    name: \"Seed\",\n    ramGb: 2,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"2\342\200\2235 friends, vanilla\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Seed Paymenter URL\",\n    cardLine: \"Just you and a couple of friends.\",\n  },\n  {\n    id: \"sprout\",\n    name: \"Sprout\",\n    ramGb: 4,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"5\342\200\22310 players, light plugins\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Sprout Paymenter URL\",\n    cardLine: \"A cozy survival world that\'s starting to grow.\",\n  },\n  {\n    id: \"sapling\",\n    name: \"Sapling\",\n    ramGb: 6,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"10\342\200\22320 players, plugin servers\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Sapling Paymenter URL\",\n    cardLine: \"The sweet spot. Room for plugins and friends.\",\n    ourPick: true,\n  },\n  {\n    id: \"blossom\",\n    name: \"Blossom\",\n    ramGb: 8,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"Light modpacks or 20\342\200\22340 players\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Blossom Paymenter URL\",\n    cardLine: \"Modded adventures, in full bloom.\",\n  },\n  {\n    id: \"grove\",\n    name: \"Grove\",\n    ramGb: 12,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"Big modpacks\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Grove Paymenter URL\",\n    cardLine: \"For the modpack with 300 mods.\",\n  },\n  {\n    id: \"orchard\",\n    name: \"Orchard\",\n    ramGb: 16,\n    cpu: \"TODO\",\n    storage: \"TODO\",\n    goodFor: \"Heavy modpacks, small networks\",\n    priceMonthly: \"TODO\",\n    paymenterUrl: \"TODO: Orchard Paymenter URL\",\n    cardLine: \"A whole orchard of worlds.\",\n  },\n];\n\nexport const highlightPlanIds: PlanId[] = [\"sprout\", \"sapling\", \"blossom\"];\n\nexport const nav = {\n  howItWorksLabel: \"How it works\",\n  plansLabel: \"Plans\",\n  externalItems: [\n    { label: \"Discord\", href: links.discord },\n    { label: \"Status\", href: links.status },\n    { label: \"Client area\", href: links.clientArea },\n  ],\n  ctaLabel: \"Get a server\",\n  ctaHref: links.store,\n};\n\nexport const story: {\n  chapters: StoryChapterContent[];\n  heroPrimaryCta: string;\n  heroSecondaryCta: string;\n} = {\n  heroPrimaryCta: \"Get a server\",\n  heroSecondaryCta: \"See plans\",\n  chapters: [\n    {\n      id: \"seed\",\n      vineLabel: \"Seed\",\n      eyebrow: \"minecraft server hosting, grown with care\",\n      heading: \"Plant a seed. Grow a world.\",\n      highlightWord: \"world\",\n      body: \"Fast servers, always-on protection and one-click setup, with real humans on Discord when you need them. Every world starts as a little sapling.\",\n      annotation: \"this is your server \342\206\223 scroll to watch it grow\",\n      anchorName: \"seed\",\n    },\n    {\n      id: \"roots\",\n      vineLabel: \"Roots\",\n      kicker: \"01 \302\267 roots\",\n      heading: \"Strong roots, zero lag.\",\n      body: \"Every world grows on hardware picked for one job: keeping Minecraft ticking smoothly. High-clock CPUs that love single-thread work, fast storage so chunks load before you get there, and plenty of quick memory.\",\n      todoNote: \"TODO: confirm and name the storage type (e.g. NVMe) once confirmed\",\n      specs: [\n        { label: \"CPU\", value: \"TODO\" },\n        { label: \"Storage\", value: \"NVMe TODO: confirm\" },\n        { label: \"Memory\", value: \"TODO\" },\n        { label: \"Network\", value: \"TODO\" },\n      ],\n      annotation: \"this glowy stuff = your CPU\",\n      anchorName: \"ore\",\n    },\n    {\n      id: \"shield\",\n      vineLabel: \"Shield\",\n      kicker: \"02 \302\267 shield\",\n      heading: \"A shield that never sleeps.\",\n      body: \"Attacks get stopped before they ever reach your world. Protection is always on, on every plan, so a bad day for someone else never becomes downtime for you.\",\n      specs: [\n        { label: \"Mitigation\", value: \"TODO\" },\n        { label: \"Included on\", value: \"every plan\" },\n      ],\n      annotation: \"boing. not today.\",\n      anchorName: \"domeRim\",\n    },\n    {\n      id: \"build\",\n      vineLabel: \"Build\",\n      kicker: \"03 \302\267 instant build\",\n      heading: \"Click once. Start building.\",\n      body: \"Pick Paper, Fabric, Forge or a whole modpack and your server is ready in about TODO seconds. Plugins, mods, backups and files all live in one friendly panel, no command line needed.\",\n      todoNote: \"TODO: confirm the loader list (same list as FAQ 3)\",\n      panelLoaders: [\"Paper\", \"Fabric\", \"Forge\", \"NeoForge\", \"Modpacks\"],\n      panelName: \"TODO: panel name\",\n      annotation: \"built in one click (well, one scroll)\",\n      anchorName: \"house\",\n    },\n    {\n      id: \"neighbors\",\n      vineLabel: \"Neighbors\",\n      kicker: \"04 \302\267 neighbors\",\n      heading: \"Good neighbors, fair prices.\",\n      body: \"Stuck at 2 a.m.? Real people (players, not bots) answer on Discord. And pricing stays simple: you pay for the plan you pick, with no surprise fees.\",\n      specs: [\n        { label: \"Typical reply\", value: \"TODO\" },\n        { label: \"From\", value: \"TODO / month\" },\n        { label: \"Locations\", value: \"TODO\" },\n      ],\n      annotation: \"that\'s us. hi!\",\n      anchorName: \"mascots\",\n    },\n    {\n      id: \"bloom\",\n      vineLabel: \"Bloom\",\n      heading: \"Your world, in full bloom.\",\n      body: \"That\'s the whole idea. You bring the seed, we keep it growing.\",\n      polaroidCaption: \"your world, day 1 of forever\",\n      ctaLabel: \"Pick your plan \342\206\223\",\n      annotation: \"your world, ready to play\",\n      anchorName: \"house\",\n    },\n  ],\n};\n\nexport const plansSection = {\n  homeHeading: \"Pick your seed.\",\n  homeSub:\n    \"Every plan includes always-on DDoS protection, the one-click panel and Discord support.\",\n  cardCta: \"Plant this server \342\206\222\",\n  ourPickLabel: \"OUR PICK\",\n  seeAllLabel: \"See all six plans \342\206\222\",\n  pageHeading: \"Plans that grow with you.\",\n  pageHighlightWord: \"grow\",\n  pageSub:\n    \"Start small, upgrade whenever your world outgrows its pot. Every plan includes always-on DDoS protection, the one-click panel and Discord support.\",\n  compareHeading: \"Compare every seed\",\n};\n\nexport const trust = {\n  heading: \"The boring stuff, done right.\",\n  items: [\n    { id: \"uptime\", label: \"Uptime\", value: \"TODO\", icon: \"clock\" as const },\n    { id: \"locations\", label: \"Locations\", value: \"TODO\", icon: \"globe\" as const },\n    { id: \"pay\", label: \"Pay your way\", value: \"TODO: payment methods\", icon: \"coin\" as const },\n    { id: \"backups\", label: \"Backups\", value: \"TODO\", icon: \"shield\" as const },\n  ],\n  reviews: [] as ReviewItem[],\n  reviewsTodoNotice: \"TODO: add real reviews (no invented ones)\",\n};\n\nexport const faq: {\n  heading: string;\n  items: FaqItem[];\n  plansPageIds: number[];\n} = {\n  heading: \"Questions you probably have\",\n  plansPageIds: [2, 3, 5, 6, 8],\n  items: [\n    {\n      id: 1,\n      question: \"What is Petalnode?\",\n      answer:\n        \"Minecraft server hosting for friends, communities and modded adventures. You pick a plan, we run the server, and you play.\",\n    },\n    {\n      id: 2,\n      question: \"How fast is my server ready?\",\n      answer:\n        \"Usually within about TODO after payment. You\'ll get your panel login by email.\",\n    },\n    {\n      id: 3,\n      question: \"Can I run plugins, mods and modpacks?\",\n      answer:\n        \"Yes. Paper, Fabric, Forge, NeoForge and popular modpacks install with one click from the panel. TODO: confirm list\",\n    },\n    {\n      id: 4,\n      question: \"Java or Bedrock?\",\n      answer: \"TODO: confirm supported editions\",\n    },\n    {\n      id: 5,\n      question: \"Can I upgrade later?\",\n      answer:\n        \"Yes. Upgrade from your client area at any time and your world comes with you. TODO: confirm\",\n    },\n    {\n      id: 6,\n      question: \"Is DDoS protection included?\",\n      answer: \"Always, on every plan, at no extra cost.\",\n    },\n    {\n      id: 7,\n      question: \"Where are your servers?\",\n      answer: \"TODO: locations\",\n    },\n    {\n      id: 8,\n      question: \"Do you offer refunds?\",\n      answer: \"TODO: refund policy\",\n    },\n    {\n      id: 9,\n      question: \"How do I get help?\",\n      answer:\n        \"Join our Discord, or open a ticket from your client area. Real humans answer.\",\n    },\n  ],\n};\n\nexport const finalCta = {\n  heading: \"Ready to plant yours?\",\n  primaryLabel: \"Get a server\",\n  primaryHref: links.store,\n  secondaryLabel: \"Join the Discord\",\n  secondaryHref: links.discord,\n};\n\nexport const notFound = {\n  heading: \"This page didn\'t sprout.\",\n  body: \"Looks like that link wandered off the path.\",\n  ctaLabel: \"Back home\",\n};\n\nexport const footerConfig = {\n  wordmark: brand.wordmark,\n  brand: brand.logoText,\n  blurb:\n    \"Minecraft server hosting, grown with care. Fast hardware, always-on protection and real humans on Discord.\",\n  tagline: brand.tagline,\n  palette: {\n    background: \"#FBF6EE\",\n    ink: \"#2B2230\",\n    accent: \"#E2557B\",\n  },\n  columns: [\n    {\n      title: \"Hosting\",\n      links: [\n        { label: \"Plans\", href: \"/plans\" },\n        { label: \"Modpacks\", href: \"TODO: Modpacks URL\" },\n        { label: \"Locations\", href: \"TODO: Locations URL\" },\n        { label: \"Status\", href: links.status },\n      ],\n    },\n    {\n      title: \"Support\",\n      links: [\n        { label: \"Discord\", href: links.discord },\n        { label: \"Knowledge base\", href: links.docs },\n        { label: \"Open a ticket\", href: links.clientArea },\n        { label: \"Contact\", href: \"TODO: Contact URL\" },\n      ],\n    },\n    {\n      title: \"Company\",\n      links: [\n        { label: \"About\", href: \"TODO: About URL\" },\n        { label: \"Terms\", href: links.terms },\n        { label: \"Privacy\", href: links.privacy },\n        { label: \"SLA\", href: links.sla },\n      ],\n    },\n    {\n      title: \"Account\",\n      links: [\n        { label: \"Client area\", href: links.clientArea },\n        { label: \"Game panel\", href: links.gamePanel },\n        { label: \"Billing\", href: links.clientArea },\n      ],\n    },\n  ] as FooterColumn[],\n  actions: [\n    {\n      label: \"Join the Discord\",\n      href: links.discord,\n      icon: \"petal\",\n      variant: \"outline\",\n    },\n    {\n      label: \"Get a server\",\n      href: links.store,\n      icon: \"bolt\",\n      variant: \"solid\",\n    },\n  ] as FooterAction[],\n  copyright: brand.copyright,\n  legal: [\n    { label: \"Terms\", href: links.terms },\n    { label: \"Privacy\", href: links.privacy },\n    { label: \"SLA\", href: links.sla },\n  ] as FooterLink[],\n  get socials(): FooterLink[] {\n    return links.socials.filter((s) => s.href && !isTodo(s.href));\n  },\n  doodles: [\n    \"petal\",\n    \"petal\",\n    \"heart\",\n    \"star\",\n    \"petal\",\n    \"sparkle\",\n    \"cube\",\n    \"petal\",\n  ] as DoodleKind[],\n  doodleCount: 12,\n  crew: [\n    {\n      kind: \"nodey\",\n      letter: 0,\n      seat: \"front\",\n      offset: -0.32,\n      name: \"Nodey\",\n      says: \"Your world\'s safe with me.\",\n    },\n    {\n      kind: \"bird\",\n      letter: 2,\n      seat: \"top\",\n      offset: 0.02,\n      name: \"Pip\",\n      says: \"Ping? Nice and low.\",\n    },\n    {\n      kind: \"mushroom\",\n      letter: 3,\n      seat: \"front\",\n      offset: 0.12,\n      scale: 0.95,\n      name: \"Morel\",\n      says: \"I\'m a fun guy. And a fast host.\",\n    },\n    {\n      kind: \"sapling\",\n      letter: 5,\n      seat: \"top\",\n      offset: 0,\n      name: \"Sprout\",\n      says: \"Plant me! I grow into islands.\",\n    },\n    {\n      kind: \"ghost\",\n      letter: 6,\n      seat: \"behind\",\n      offset: 0,\n      name: \"Boo\",\n      says: \"Lag? Never heard of her.\",\n    },\n    {\n      kind: \"cat\",\n      letter: 8,\n      seat: \"front\",\n      offset: 0.42,\n      flip: true,\n      name: \"Patch\",\n      says: \"Psst. The middle plan\'s the good one.\",\n    },\n  ] as CrewMember[],\n};\n\nexport interface TodoEntry {\n  path: string;\n  value: string;\n  isUrl: boolean;\n}\n\nexport function isTodo(value: unknown): boolean {\n  if (typeof value !== \"string\") return false;\n  return /\\bTODO\\b/.test(value);\n}\n\nconst URL_KEY_HINT = /(url|href|siteUrl|store|clientArea|gamePanel|discord|status|docs|terms|privacy|sla)$/i;\n\nexport function listTodos(): TodoEntry[] {\n  const results: TodoEntry[] = [];\n  const root = {\n    links,\n    planIncludes,\n    plans,\n    story,\n    trust,\n    faq,\n    footerColumns: footerConfig.columns,\n  };\n\n  function walk(node: unknown, currentPath: string, keyName: string) {\n    if (typeof node === \"string\") {\n      if (isTodo(node)) {\n        const isUrl =\n          URL_KEY_HINT.test(keyName) ||\n          /\\b(URL|domain|link)\\b/i.test(node) ||\n          currentPath.startsWith(\"links.\");\n        results.push({ path: currentPath, value: node, isUrl });\n      }\n      return;\n    }\n    if (Array.isArray(node)) {\n      node.forEach((item, idx) => walk(item, `${currentPath}[${idx}]`, keyName));\n      return;\n    }\n    if (node && typeof node === \"object\") {\n      for (const [k, v] of Object.entries(node)) {\n        const nextPath = currentPath ? `${currentPath}.${k}` : k;\n        walk(v, nextPath, k);\n      }\n    }\n  }\n\n  walk(root, \"\", \"\");\n  return results;\n}\n"
    num_lines: 549
    num_bytes: 15407
    line_range_bytes: 15407
  }
}
